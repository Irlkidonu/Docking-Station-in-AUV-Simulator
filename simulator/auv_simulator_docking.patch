index 00000000..958e5cc4
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/docking/fls_range.py
@@ -0,0 +1,121 @@
+"""Direct geometric range to the dock from a forward-looking sonar sweep.
+
+No learning and no privileged state: a sweep is a set of ranges at known
+bearings, and the collar plane is at a known place in the dock frame, so the
+vehicle's longitudinal position follows from trigonometry.
+
+A ray at bearing ``theta`` striking the collar plane returns a slant range::
+
+    r(theta) = (sensor_x - collar_plane_x) / cos(theta)
+
+so each valid ray gives an independent estimate::
+
+    vehicle_x = r(theta) * cos(theta) + collar_plane_x + fls_offset
+
+combined by a median over a central sector, which is robust to the funnel flares
+entering the outer beams and to isolated dropouts.
+
+**The hard limitation is physical, not a tuning choice.** Below the blind-zone
+boundary the collar cannot be ranged, and the beams do not merely stop: they pass
+through the open throat and range the support post behind it, coherently enough
+that spread-based rejection does not catch it. The discriminator that works is
+field-of-view support -- a genuine collar fix fills the fan, a throat-penetrating
+one does not. Without that gate this estimator reports confident, plausible and
+wrong fixes offset by the distance to the post.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+
+from .geometry import platform_geometry
+
+__all__ = ["FLSRangeEstimator", "FLSRangeConfig", "FLSRangeFix"]
+
+
+@dataclass(frozen=True)
+class FLSRangeConfig:
+    """Fixed before any outcome is observed."""
+    #: Half-width of the central bearing sector used for the fit, in rays.
+    centre_half_width: int = 24
+    #: Minimum valid rays in the sector for a fix to be issued at all.
+    min_valid_rays: int = 6
+    #: Reject a sector whose robust spread exceeds this: the beams are then
+    #: seeing different structures, not one plane.
+    max_spread_m: float = 0.25
+    #: Temporal smoothing across consecutive sweeps (0 = none).
+    smoothing: float = 0.4
+    #: Minimum fraction of the FULL sweep that must return for a fix to count.
+    #: This is the gate that separates ranging the collar from ranging straight
+    #: through the throat. See the module docstring.
+    min_sweep_valid_fraction: float = 0.70
+
+
+@dataclass
+class FLSRangeFix:
+    vehicle_x_m: float | None
+    valid_rays: int
+    spread_m: float
+    reason: str
+    raw_median_range_m: float | None = None
+
+
+class FLSRangeEstimator:
+    """Median-of-rays geometric range to the collar plane."""
+
+    def __init__(self, config: FLSRangeConfig | None = None, geometry=None) -> None:
+        self.config = config or FLSRangeConfig()
+        self.geometry = geometry or platform_geometry()
+        self._bearings = self.geometry.sonar.bearings()
+        self._previous: float | None = None
+
+    def reset(self) -> None:
+        self._previous = None
+
+    def blind_zone_boundary_m(self) -> float:
+        """Vehicle x below which the collar cannot be ranged at all."""
+        return self.geometry.fls_blind_zone_boundary_m
+
+    def estimate(self, scan: np.ndarray) -> FLSRangeFix:
+        cfg = self.config
+        sonar = self.geometry.sonar
+        scan = np.asarray(scan, dtype=float)
+        if scan.shape[0] != sonar.rays:
+            return FLSRangeFix(None, 0, float("nan"), "wrong ray count")
+
+        mid = sonar.rays // 2
+        lo, hi = mid - cfg.centre_half_width, mid + cfg.centre_half_width
+        sector = scan[lo:hi]
+        bearings = self._bearings[lo:hi]
+
+        sweep_valid = (np.isfinite(scan) & (scan > sonar.range_min_m)
+                       & (scan < sonar.range_max_m))
+        sweep_fraction = float(sweep_valid.mean())
+
+        usable = (np.isfinite(sector) & (sector > sonar.range_min_m)
+                  & (sector < sonar.range_max_m))
+        n = int(usable.sum())
+        if sweep_fraction < cfg.min_sweep_valid_fraction:
+            return FLSRangeFix(None, n, float("nan"),
+                               f"collar not filling FOV (sweep valid "
+                               f"{sweep_fraction:.2f} < {cfg.min_sweep_valid_fraction:.2f}); "
+                               "beams likely passing through the throat")
+        if n < cfg.min_valid_rays:
+            return FLSRangeFix(None, n, float("nan"),
+                               "collar inside FLS blind zone or no return")
+
+        axial = sector[usable] * np.cos(bearings[usable])
+        median = float(np.median(axial))
+        spread = float(np.median(np.abs(axial - median)))       # robust MAD
+        if spread > cfg.max_spread_m:
+            return FLSRangeFix(None, n, spread, "sector inconsistent")
+
+        vehicle_x = (median + self.geometry.dock.collar_plane_x_m
+                     + self.geometry.vehicle.fls_offset_m)
+        if self._previous is not None and cfg.smoothing > 0:
+            vehicle_x = ((1 - cfg.smoothing) * vehicle_x
+                         + cfg.smoothing * self._previous)
+        self._previous = vehicle_x
+        return FLSRangeFix(float(vehicle_x), n, spread, "ok",
+                           raw_median_range_m=float(np.median(sector[usable])))
diff --git a/src/uuv_sim_physics/uuv_sim_physics/docking/geometry.py b/src/uuv_sim_physics/uuv_sim_physics/docking/geometry.py
new file mode 100644
index 00000000..2e0a7c41
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/docking/geometry.py
@@ -0,0 +1,219 @@
+"""Authoritative docking geometry, derived from the simulator's own configuration.
+
+**Every value here is read from `config/dock_station.yaml`,
+`config/vehicle_bluerov2_phys.yaml` and `world_builder.SENSOR_SUITE`.** Nothing
+is transcribed by hand.
+
+This module exists because the geometry was previously copied into consumers by
+hand -- the dock origin and approach yaw in one place, the collar plane and FLS
+mount offset in another, the mount offset again in a third. Three transcriptions
+of the same facts, none of which would notice if the world changed. A docking
+estimator that believes the collar is at x = 0.01 while the SDF puts it
+elsewhere fails in a way that looks like a perception problem.
+
+The rule: if a number describes the platform, it is computed here from
+configuration. If it describes an experiment, it belongs to the experiment.
+"""
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass, field
+from functools import lru_cache
+
+import numpy as np
+
+from .. import world_builder
+
+__all__ = ["DockGeometry", "VehicleGeometry", "SonarGeometry", "PlatformGeometry",
+           "platform_geometry", "wrap_angle", "yaw_from_quaternion",
+           "rotation_from_quaternion", "relative_pose", "derived_quantities"]
+
+
+@dataclass(frozen=True)
+class DockGeometry:
+    """Where the dock is and what its capture aperture looks like."""
+    origin_world: np.ndarray          # dock frame origin in world coordinates
+    collar_plane_x_m: float           # outer face of the collar ring, dock frame
+    collar_inner_radius_m: float      # the throat the vehicle must fit through
+    collar_outer_radius_m: float
+    support_post_x_m: float           # what the sonar sees through the open throat
+    approach_yaw_rad: float           # vehicle heading for a nominal approach
+
+    @property
+    def dock_depth_m(self) -> float:
+        return float(self.origin_world[2])
+
+
+@dataclass(frozen=True)
+class VehicleGeometry:
+    hull_size_m: tuple                 # collision box, x y z
+    camera_offset_m: float             # along body +x
+    camera_resolution: tuple           # native render size, (height, width)
+    fls_offset_m: float                # along body +x
+    dvl_offset_m: tuple
+    spawn_pose_world: tuple
+
+    @property
+    def hull_half_diagonal_m(self) -> float:
+        """Half-diagonal in the plane normal to the approach axis.
+
+        This is the radius the throat must clear, so it -- with the collar inner
+        radius -- is what makes capture geometrically possible or impossible.
+        """
+        return 0.5 * math.hypot(self.hull_size_m[1], self.hull_size_m[2])
+
+
+@dataclass(frozen=True)
+class SonarGeometry:
+    rays: int
+    angle_min_rad: float
+    angle_max_rad: float
+    range_min_m: float
+    range_max_m: float
+
+    def bearings(self) -> np.ndarray:
+        return np.linspace(self.angle_min_rad, self.angle_max_rad, self.rays)
+
+
+@dataclass(frozen=True)
+class PlatformGeometry:
+    dock: DockGeometry
+    vehicle: VehicleGeometry
+    sonar: SonarGeometry
+    topics: dict = field(default_factory=dict)
+
+    @property
+    def radial_clearance_m(self) -> float:
+        """Collar inner radius minus hull half-diagonal.
+
+        The largest lateral error at which capture is still geometrically
+        possible. An experiment's radial capture criterion should be derived
+        from this rather than chosen.
+        """
+        return (self.dock.collar_inner_radius_m
+                - self.vehicle.hull_half_diagonal_m)
+
+    @property
+    def fls_blind_zone_boundary_m(self) -> float:
+        """Vehicle x below which the collar cannot be ranged at all.
+
+        The sonar has a minimum range and sits forward of the vehicle origin, so
+        the collar plane leaves the sensor's usable window at a fixed standoff.
+        A physical property of the platform, not a tuning choice.
+        """
+        return (self.sonar.range_min_m + self.dock.collar_plane_x_m
+                + self.vehicle.fls_offset_m)
+
+
+def _collar_plane_x(dock_cfg: dict) -> float:
+    """Outer face of the collar ring along the approach axis.
+
+    The ring is a cylinder laid on its side (pitched pi/2), so its axis runs
+    along dock x and its outer face is at centre + half its length.
+    """
+    ring = next(v for v in dock_cfg["links"]["collar"]["visuals"]
+                if v["name"] == "ring")
+    # Rounded to 12 decimals: the configuration gives -0.02 and 0.06, whose exact
+    # decimal sum is 0.01, but binary floating point lands 2e-18 below it. That
+    # residue is meaningless physically and would make derived constants differ
+    # from their documented decimal values for no reason.
+    return round(float(ring["pose"][0]) + 0.5 * float(ring["length"]), 12)
+
+
+def _support_post_x(dock_cfg: dict) -> float:
+    post = next(v for v in dock_cfg["links"]["support"]["visuals"]
+                if v["name"] == "post")
+    return float(post["pose"][0])
+
+
+@lru_cache(maxsize=4)
+def platform_geometry(validated: bool = True) -> PlatformGeometry:
+    """Read the platform's geometry out of its own configuration."""
+    config = world_builder.load_config(validated=validated)
+    dock_cfg = config["dock_station"]
+    vehicle_cfg = config["vehicle_bluerov2_phys"]
+    fls = world_builder.SENSOR_SUITE["fls"]
+    camera = vehicle_cfg["sensors"]["camera"]
+
+    spawn = tuple(float(v) for v in vehicle_cfg["spawn_pose"])
+    dock = DockGeometry(
+        origin_world=np.array([float(v) for v in dock_cfg["pose"][:3]]),
+        collar_plane_x_m=_collar_plane_x(dock_cfg),
+        collar_inner_radius_m=float(world_builder.COLLAR_INNER_R),
+        collar_outer_radius_m=float(world_builder.COLLAR_OUTER_R),
+        support_post_x_m=_support_post_x(dock_cfg),
+        # The vehicle spawns facing the dock; that heading IS the approach axis.
+        approach_yaw_rad=math.pi,
+    )
+    vehicle = VehicleGeometry(
+        hull_size_m=tuple(float(v) for v in
+                          vehicle_cfg["base_link"]["collision"]["size_m"]),
+        camera_offset_m=float(camera["pose"][0]),
+        camera_resolution=(int(camera["height"]), int(camera["width"])),
+        fls_offset_m=float(fls["pose"][0]),
+        dvl_offset_m=tuple(float(v) for v in world_builder.SENSOR_SUITE["dvl"]["pose"][:3]),
+        spawn_pose_world=spawn,
+    )
+    sonar = SonarGeometry(
+        rays=int(fls["samples"]),
+        angle_min_rad=float(fls["min_angle_rad"]),
+        angle_max_rad=float(fls["max_angle_rad"]),
+        range_min_m=float(fls["range_min_m"]),
+        range_max_m=float(fls["range_max_m"]),
+    )
+    topics = {"camera": camera["topic"], "fls": fls["topic"],
+              "imu": world_builder.SENSOR_SUITE["imu"]["topic"],
+              "dvl": world_builder.SENSOR_SUITE["dvl"]["topic"]}
+    return PlatformGeometry(dock=dock, vehicle=vehicle, sonar=sonar, topics=topics)
+
+
+# --- frame helpers ---------------------------------------------------------
+
+def wrap_angle(angle):
+    return (np.asarray(angle) + np.pi) % (2 * np.pi) - np.pi
+
+
+def yaw_from_quaternion(q) -> float:
+    w, x, y, z = (float(v) for v in q)
+    return math.atan2(2.0 * (w * z + x * y), 1.0 - 2.0 * (y * y + z * z))
+
+
+def rotation_from_quaternion(q) -> np.ndarray:
+    w, x, y, z = (float(v) for v in q)
+    return np.array([
+        [1 - 2 * (y * y + z * z), 2 * (x * y - z * w), 2 * (x * z + y * w)],
+        [2 * (x * y + z * w), 1 - 2 * (x * x + z * z), 2 * (y * z - x * w)],
+        [2 * (x * z - y * w), 2 * (y * z + x * w), 1 - 2 * (x * x + y * y)]])
+
+
+def relative_pose(position_world, quaternion_world, geometry=None) -> np.ndarray:
+    """Dock-relative (x, y, z, psi) from a world pose.
+
+    The dock frame is a pure translation of world, so position is a subtraction
+    and heading error is the yaw relative to the approach axis.
+    """
+    g = geometry or platform_geometry()
+    position = np.asarray(position_world, dtype=float) - g.dock.origin_world
+    psi = wrap_angle(yaw_from_quaternion(quaternion_world) - g.dock.approach_yaw_rad)
+    return np.array([position[0], position[1], position[2], float(psi)])
+
+
+def derived_quantities(pose: np.ndarray) -> dict:
+    """Range, bearing and offsets a docking approach is read out in.
+
+    ``lateral_offset_m`` is the **radial** offset ``hypot(y, z)``, not ``y``
+    alone. The name is inherited and is kept because this definition is recorded
+    in existing datasets; changing it would silently reinterpret stored labels.
+    ``elevation_rad`` is zero when the horizontal range is degenerate rather
+    than jumping to +-pi/2.
+    """
+    x, y, z, psi = (float(v) for v in np.asarray(pose, dtype=float))
+    horizontal = math.hypot(x, y)
+    return {
+        "range_m": math.sqrt(x * x + y * y + z * z),
+        "horizontal_range_m": horizontal,
+        "bearing_rad": math.atan2(y, x),
+        "elevation_rad": math.atan2(z, horizontal) if horizontal > 1e-9 else 0.0,
+        "lateral_offset_m": math.hypot(y, z),
+        "heading_error_rad": psi,
+    }
diff --git a/src/uuv_sim_physics/uuv_sim_physics/docking/heavy_capture.py b/src/uuv_sim_physics/uuv_sim_physics/docking/heavy_capture.py
new file mode 100644
index 00000000..47bac36a
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/docking/heavy_capture.py
@@ -0,0 +1,86 @@
+"""Capture geometry for the Heavy profile.
+
+A single radial threshold is sufficient only when the vehicle's cross-section is
+effectively a disc. The Heavy's is a 0.338 x 0.254 m rectangle, and with roll,
+pitch and yaw all controllable its projection onto the collar plane changes with
+attitude. At the nominal 0.0286 m clearance that is not a second-order effect:
+a 20 degree roll swings the required radius by more than the whole margin.
+
+So the Heavy capture test evaluates the **projected envelope against the throat
+circle**, not a scalar radius. ``radial_margin`` is retained for reporting and
+comparison with the representative vehicle, but it is not the criterion.
+"""
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+
+import numpy as np
+
+__all__ = ["HeavyCaptureGeometry", "CaptureResult", "capture_test"]
+
+
+@dataclass(frozen=True)
+class HeavyCaptureGeometry:
+    width_m: float = 0.338
+    height_m: float = 0.254
+    length_m: float = 0.457
+    throat_radius_m: float = 0.240
+
+    def corners_yz(self) -> np.ndarray:
+        w, h = self.width_m / 2.0, self.height_m / 2.0
+        return np.array([[w, h], [w, -h], [-w, -h], [-w, h]])
+
+    @property
+    def nominal_half_diagonal_m(self) -> float:
+        return 0.5 * math.hypot(self.width_m, self.height_m)
+
+    @property
+    def nominal_clearance_m(self) -> float:
+        return self.throat_radius_m - self.nominal_half_diagonal_m
+
+
+@dataclass
+class CaptureResult:
+    captured: bool
+    required_radius_m: float
+    margin_m: float
+    radial_offset_m: float
+    limiting_corner: int
+    reason: str
+
+
+def capture_test(offset_y: float, offset_z: float, roll: float, pitch: float,
+                 yaw: float, geometry: HeavyCaptureGeometry | None = None
+                 ) -> CaptureResult:
+    """Does the attitude-projected envelope clear the throat at this offset?
+
+    The cross-section is rotated by roll about the approach axis; pitch and yaw
+    tilt the body so its projection onto the collar plane grows by 1/cos of the
+    respective angle. Every corner is then tested against the throat circle, so
+    the criterion is the worst corner rather than the centre.
+    """
+    g = geometry or HeavyCaptureGeometry()
+    corners = g.corners_yz()
+
+    # Roll rotates the rectangle in the collar plane.
+    c, s = math.cos(roll), math.sin(roll)
+    rotated = corners @ np.array([[c, -s], [s, c]]).T
+
+    # Pitch and yaw tilt the body, widening its projected footprint.
+    widen_y = 1.0 / max(math.cos(yaw), 1e-3)
+    widen_z = 1.0 / max(math.cos(pitch), 1e-3)
+    projected = rotated * np.array([widen_y, widen_z])
+
+    placed = projected + np.array([offset_y, offset_z])
+    radii = np.linalg.norm(placed, axis=1)
+    limiting = int(np.argmax(radii))
+    required = float(radii[limiting])
+    margin = g.throat_radius_m - required
+    captured = margin >= 0.0
+    return CaptureResult(
+        captured=captured, required_radius_m=required, margin_m=margin,
+        radial_offset_m=float(math.hypot(offset_y, offset_z)),
+        limiting_corner=limiting,
+        reason="clears the throat" if captured else
+               f"corner {limiting} exceeds the throat by {-margin:.4f} m")
diff --git a/src/uuv_sim_physics/uuv_sim_physics/docking/heavy_runtime.py b/src/uuv_sim_physics/uuv_sim_physics/docking/heavy_runtime.py
new file mode 100644
index 00000000..7e84bd9a
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/docking/heavy_runtime.py
@@ -0,0 +1,678 @@
+"""Gazebo/DART runtime for the Heavy profile.
+
+Additive sibling of ``runner.py``: same launch/subscribe/control-loop shape, but
+driving the eight-thruster vectored6dof plant through the 6-DoF cascade
+controller and the rank-6 allocator.
+
+Privileged state, stated precisely
+----------------------------------
+* **Depth NEVER reaches the controller as truth.** It passes through
+  ``sensors.depth.Bar30Model``, which adds a per-dive calibration bias, thermal
+  drift and per-sample noise at the sensor's 2 mm resolution. ``_measure_depth``
+  is the single depth entry point and a mutation test asserts that substituting
+  truth there is detectable.
+* **Horizontal position** comes from a declared ``position_source``. For plant
+  and controller validation that is the truth harness, named
+  ``truth_validation_harness``, recorded in every result, and gated behind an
+  explicit flag that defaults off. It is the analogue of the oracle condition
+  and is **not** available to Scenario C perception, which must supply its own
+  provider.
+* Truth is otherwise read only to score.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+
+import math
+import os
+import re
+import signal
+import subprocess
+import time
+from dataclasses import dataclass, field
+
+import numpy as np
+
+from ..process_group import terminate_owned_process
+from ..control.heavy_allocation import HeavyAllocator
+from ..control.heavy_controller import (HeavyController, HeavyGains,
+                                        HeavySetpoint, HeavyState)
+from ..sensors.depth import Bar30Config, Bar30Model
+from .heavy_capture import HeavyCaptureGeometry, capture_test
+
+__all__ = ["HeavyRunConfig", "HeavyRunRecord", "run_heavy", "TRUTH_HARNESS"]
+
+#: The one declared privileged position source, for plant/controller validation.
+TRUTH_HARNESS = "truth_validation_harness"
+
+
+@dataclass
+class HeavyRunConfig:
+    run_id: str
+    setpoint: HeavySetpoint
+    seconds: float = 25.0
+    settle_s: float = 3.0
+    control_hz: float = 20.0
+    gui: bool = False
+    seed: int = 0
+    #: Explicit, defaults off. Only a validation harness may enable it.
+    position_source: str = TRUTH_HARNESS
+    position_noise_m: float = 0.0
+    #: Must be set explicitly to fly a horizontal setpoint on truth.
+    acknowledge_truth_position: bool = False
+    attitude_noise_rad: float = 0.0
+    current_world: tuple = (0.0, 0.0, 0.0)
+    disturbance_at_s: float | None = None
+    disturbance_m: tuple = (0.0, 0.0, 0.0)
+    gains: HeavyGains = field(default_factory=HeavyGains)
+    depth_config: Bar30Config = field(default_factory=Bar30Config)
+    #: Full-pose capture geometry used for SCORING only.
+    capture_geometry: HeavyCaptureGeometry | None = None
+    #: Scenario C arm sensing. C0 = stock (camera + IMU/AHRS + Bar30);
+    #: C1 = C0 + FLS; C2 = C1 + DVL. Declaring an arm ADDS sensors to the world;
+    #: it never promotes them to stock.
+    arm_sensing: str = "C0"
+    #: Declared dock variant, e.g. the nested dual-scale cooperative markers.
+    dock_variant: str | None = None
+    #: Where the built world is written. None uses the package world directory.
+    world_dir: "Path | None" = None
+    #: Omit visualisation-only dock geometry (the guidance "laser" rods). The
+    #: frozen Scenario C arm worlds are built with this ON, so a trial that left
+    #: it off would not be flying the frozen world.
+    omit_visualisation_geometry: bool = False
+    #: Dock-relative range at which the vehicle spawns. None keeps the profile's
+    #: declared spawn pose. A Scenario C trial sets it so the approach starts at
+    #: a declared range rather than the profile default.
+    spawn_range_m: float | None = None
+    #: Operational horizontal-state provider. When supplied it REPLACES the
+    #: truth-derived horizontal position entirely: the provider sees only a
+    #: SensorObservation, which has no truth field. This is what makes a
+    #: Scenario C arm flyable without operational truth.
+    position_provider: object = None
+
+
+@dataclass
+class HeavyRunRecord:
+    run_id: str
+    metrics: dict
+    series: dict
+    diagnostics: dict
+
+
+#: Horizontal-position sources and whether each could exist on real hardware.
+#: The stock BlueROV2 Heavy carries camera, IMU/AHRS and a Bar30 only. None of
+#: those yields horizontal position: the Bar30 is vertical, the IMU alone drifts
+#: without bound under double integration, and the camera only yields position
+#: through the very perception model Scenario C exists to evaluate. The profile
+#: records dvl and usbl as ``stock: false`` accessories, which is why Scenario C
+#: is split C0 (stock) / C1 (+FLS) / C2 (+DVL).
+POSITION_SOURCES = {
+    TRUTH_HARNESS: {
+        "hardware_realisable": False,
+        "permitted_for": ("scoring", "plotting", "oracle_reference"),
+        "note": "simulator truth; NOT an operational measurement",
+    },
+    "dvl_dead_reckoning": {
+        "hardware_realisable": True,
+        "requires": "dvl (stock: false -- Water Linked DVL-A50, needs bottom lock)",
+        "note": "not yet modelled; would make C2 position control validatable",
+    },
+    "camera_dock_relative": {
+        "hardware_realisable": True,
+        "requires": "camera + the Scenario C perception model",
+        "note": "circular for platform validation -- it is the contribution under test",
+    },
+}
+
+
+class TruthPositionAsFeedbackError(RuntimeError):
+    """Raised when simulator truth would act as operational position feedback."""
+
+
+def _guard_position_source(config) -> None:
+    """Truth may score a run; it may not fly one.
+
+    A setpoint with a horizontal component makes horizontal position an
+    operational feedback signal. Combining that with the truth harness would
+    validate a controller that cannot exist on hardware, so it is refused unless
+    the caller explicitly marks the run as validation-only -- which also marks
+    the record, so such a run can never be mistaken for transfer evidence.
+    """
+    target = np.asarray(config.setpoint.position, dtype=float)
+    horizontal = bool(np.any(np.abs(target[:2]) > 1e-9))
+    source = config.position_source
+    if not horizontal:
+        return
+    provider = getattr(config, "position_provider", None)
+    if provider is not None:
+        # A provider supplies horizontal position from sensors alone. It must
+        # claim hardware realisability, and claiming it is not enough -- the
+        # SensorObservation it receives has no truth field at all.
+        if not getattr(provider, "hardware_realisable", False):
+            raise TruthPositionAsFeedbackError(
+                f"position_provider {type(provider).__name__} does not claim "
+                "hardware_realisable; it may not fly an experimental arm")
+        return
+    if source == TRUTH_HARNESS and not config.acknowledge_truth_position:
+        raise TruthPositionAsFeedbackError(
+            "horizontal setpoint "
+            f"{target[:2].tolist()} with position_source='{source}'. Simulator "
+            "truth must not be operational horizontal-position feedback. Either "
+            "supply a hardware-realisable source "
+            f"({[k for k, v in POSITION_SOURCES.items() if v['hardware_realisable']]}) "
+            "or set acknowledge_truth_position=True, which tags the run as "
+            "validation-only and not hardware-transfer evidence.")
+    if source not in POSITION_SOURCES:
+        raise TruthPositionAsFeedbackError(f"unknown position_source '{source}'")
+
+
+def _truth_rpy(quat) -> tuple[float, float, float]:
+    """Roll/pitch/yaw from the TRUTH quaternion -- scoring only.
+
+    Never reaches the controller: the control path takes attitude from the IMU
+    and raises if the IMU is absent. This exists so the capture classifier is
+    scored against the vehicle's actual pose rather than its estimate.
+    """
+    w, x, y, z = quat
+    return (math.atan2(2 * (w * x + y * z), 1 - 2 * (x * x + y * y)),
+            math.asin(max(-1.0, min(1.0, 2 * (w * y - z * x)))),
+            math.atan2(2 * (w * z + x * y), 1 - 2 * (y * y + z * z)))
+
+
+def _score_capture(rel_true, quat_true, setpoint,
+                   geometry: HeavyCaptureGeometry,
+                   approach_yaw: float = 0.0) -> dict:
+    """Full-pose capture classification -- SCORING ONLY.
+
+    Uses the projected Heavy envelope against the throat circle, NOT the generic
+    0.065 m scalar radius in ``outcome.py``. A scalar radius is only valid for a
+    vehicle whose cross-section is small against the throat; the Heavy's 0.338 x
+    0.254 m envelope has a 0.2116 m half-diagonal against a 0.240 m throat, so
+    roll and pitch change whether it fits at all. The scalar rule cannot see
+    that and would report capture for poses that physically collide.
+
+    Offsets are measured from the setpoint, which the harness treats as the
+    throat centre.
+    """
+    roll_t, pitch_t, yaw_t = _truth_rpy(quat_true)
+    target = np.asarray(setpoint.position, dtype=float)
+    # capture_test widens the projected envelope by 1/cos(yaw), so it wants the
+    # HEADING ERROR relative to the dock approach axis, not absolute world yaw.
+    # Passing world yaw meant a vehicle correctly facing the dock (yaw = pi)
+    # gave cos(pi) = -1, clamped to 1e-3, a widening factor of 1000 and a
+    # guaranteed failure -- which is why a 43 mm miss scored as no-capture.
+    # Transverse offsets need no such correction: spawn and dock differ only
+    # along x, so y and z are already frame-invariant.
+    yaw_err = (yaw_t - approach_yaw + math.pi) % (2 * math.pi) - math.pi
+    res = capture_test(float(rel_true[1]) - float(target[1]),
+                       float(rel_true[2]) - float(target[2]),
+                       roll_t, pitch_t, yaw_err, geometry)
+    return {"captured": bool(res.captured),
+            "required_radius_m": float(res.required_radius_m),
+            "margin_m": float(res.margin_m),
+            "radial_offset_m": float(res.radial_offset_m),
+            "limiting_corner": int(res.limiting_corner),
+            "reason": res.reason}
+
+
+#: numpy renamed trapz -> trapezoid in 2.0. This environment runs numpy 1.x, so
+#: the 2.0-only spelling raised AttributeError the first time a Heavy run
+#: actually reached the summariser -- which is why it had never been seen.
+def _trapz(y, x):
+    fn = getattr(np, "trapezoid", None) or np.trapz
+    return fn(y, x)
+
+
+def _measure_depth(sensor: Bar30Model, true_z: float, dt: float) -> float:
+    """The ONLY depth entry point on the Heavy control path.
+
+    Truth enters the *sensor model*, never the controller. Removing this call
+    and passing ``true_z`` through is what the mutation test must catch.
+    """
+    return sensor.measure(true_z, dt)
+
+
+def run_heavy(config: HeavyRunConfig) -> HeavyRunRecord:
+    from .. import toolchain, world_builder
+    from .state_providers import SensorObservation
+    from gz.msgs10.double_pb2 import Double
+    from gz.msgs10.image_pb2 import Image
+    from gz.msgs10.imu_pb2 import IMU
+    from gz.msgs10.laserscan_pb2 import LaserScan
+    from gz.msgs10.pose_v_pb2 import Pose_V
+    from gz.transport13 import Node
+
+    # BUILD the world rather than reading the shipped artefact.
+    #
+    # The shipped auv_sim_physics_heavy.sdf is a PRE-CORRECTION snapshot: SDF
+    # 1.9, no <fluid_added_mass>, no buoyancy <enable> scoping and no base_link
+    # collision. Reading it ran the campaign on the very plant the added-mass
+    # correction was written to replace. Gates 5 and 6 were unaffected because
+    # they built their own world; only this entry point read the stale file.
+    # The builder is the source of truth, so the world is emitted here, with the
+    # arm's sensors and any declared dock variant.
+    world_dir = Path(config.world_dir) if config.world_dir else world_builder.WORLD_DIR
+    world_dir.mkdir(parents=True, exist_ok=True)
+    sdf_text = world_builder.build_world_sdf(
+        validated=True, vehicle="bluerov2_heavy",
+        dock_variant=config.dock_variant, arm_sensing=config.arm_sensing,
+        omit_visualisation_geometry=config.omit_visualisation_geometry)
+    if config.spawn_range_m is not None:
+        sdf_text = sdf_text.replace(
+            "<pose>4 0 -15 0 0 3.14159</pose>",
+            f"<pose>{config.spawn_range_m:.6f} 0 -15 0 0 3.14159</pose>")
+    world = world_dir / (f"heavy_{config.arm_sensing}_"
+                         f"{config.dock_variant or 'stock'}_"
+                         f"{'novis' if config.omit_visualisation_geometry else 'vis'}_"
+                         f"{config.spawn_range_m or 'default'}.sdf")
+    world.write_text(sdf_text)
+    world_name = re.search(r'<world name="([^"]+)"', sdf_text).group(1)
+    vehicle = world_builder.load_config(
+        validated=True, vehicle="bluerov2_heavy")["vehicle_bluerov2_phys"]
+    spawn = np.array(vehicle["spawn_pose"][:3], dtype=float)
+    if config.spawn_range_m is not None:
+        spawn = np.array([config.spawn_range_m, 0.0, spawn[2]], dtype=float)
+    spawn_yaw = float(vehicle["spawn_pose"][5])
+
+    truth: list = []
+    imu: list = []
+    frames: list = []
+    fls: list = []
+    dvl: list = []
+    counters = {"img_rx": 0, "fls_rx": 0, "dvl_rx": 0, "img_used": 0,
+                "img_reused": 0, "ticks": 0, "img_none": 0}
+
+    def newest_at_or_before(buf, t_sim):
+        """Newest observation stamped at or before this simulation tick."""
+        best = None
+        for item in buf:
+            if item[0] <= t_sim and (best is None or item[0] > best[0]):
+                best = item
+        return best
+
+    def stamp(h):
+        return h.stamp.sec + h.stamp.nsec * 1e-9
+
+    def on_imu(m):
+        o = m.orientation
+        imu.append((stamp(m.header), (o.w, o.x, o.y, o.z),
+                    np.array([m.angular_velocity.x, m.angular_velocity.y,
+                              m.angular_velocity.z]),
+                    np.array([m.linear_acceleration.x, m.linear_acceleration.y,
+                              m.linear_acceleration.z])))
+        if len(imu) > 40:
+            del imu[:-40]
+
+    def on_pose(m):
+        t = stamp(m.header)
+        for p in m.pose:
+            if p.name == "bluerov2_heavy":
+                truth.append((t, np.array([p.position.x, p.position.y, p.position.z]),
+                              np.array([p.orientation.w, p.orientation.x,
+                                        p.orientation.y, p.orientation.z])))
+                if len(truth) > 400:
+                    del truth[:-400]
+
+    args = [str(toolchain.GZ_EXECUTABLE), "sim", "-r", "-v", "0"]
+    if not config.gui:
+        args.append("-s")
+    args.append(str(world))
+    # own process group: a hung server is killed as a group, never orphaned
+    server = subprocess.Popen(args, stdout=subprocess.DEVNULL,
+                              stderr=subprocess.DEVNULL, env=os.environ.copy(),
+                              start_new_session=True)
+
+    _guard_position_source(config)
+    depth_sensor = Bar30Model(config.depth_config, seed=config.seed)
+    capture_geometry = config.capture_geometry or HeavyCaptureGeometry()
+    allocator = HeavyAllocator(vehicle)
+    controller = HeavyController(config.gains)
+    rng = np.random.default_rng(config.seed)
+    joints = [u["joint"] for u in vehicle["thrusters"]["units"]]
+    rows: list = []
+    diagnostics = {"position_source": config.position_source,
+                   "depth_source": "Bar30Model(simulated sensor)",
+                   "position_source": config.position_source,
+                   "position_hardware_realisable":
+                       POSITION_SOURCES[config.position_source]["hardware_realisable"],
+                   "hardware_transfer_evidence":
+                       POSITION_SOURCES[config.position_source]["hardware_realisable"],
+                   "attitude_source": "imu",
+                   "world": world.name,
+                   "counters": counters}
+
+    try:
+        node = Node()
+        deadline = time.time() + 90
+        for T, topic, cb in ((IMU, "/bluerov2_heavy/imu", on_imu),
+                             (Pose_V, f"/world/{world_name}/dynamic_pose/info", on_pose)):
+            while not node.subscribe(T, topic, cb):
+                if time.time() > deadline:
+                    raise RuntimeError(f"subscribe {topic}")
+                time.sleep(0.3)
+        # --- ARM SENSOR STREAMS -------------------------------------
+        # Subscribed only when the arm declares them, so C0 cannot silently
+        # acquire C1/C2 sensing. These feed the provider, never the controller.
+        if config.position_provider is not None:
+            # SIMULATION-TIME CONTRACT. Every observation is stored with its
+            # own SIM stamp, and a control tick consumes the newest observation
+            # stamped at or before that tick. Taking "whichever callback arrived
+            # last in wall time" made frame-to-tick association depend on
+            # process scheduling: the same seed produced 263 fixes in one run
+            # and 190 in another. Wall time must not decide what a tick sees.
+            def on_image(m):
+                if m.step == m.width * 3:
+                    a = np.frombuffer(m.data, dtype=np.uint8)
+                    if a.size == m.height * m.width * 3:
+                        frames.append((stamp(m.header),
+                                       a.reshape(m.height, m.width, 3).copy()))
+                        counters["img_rx"] += 1
+                        del frames[:-8]
+
+            def on_fls(m):
+                fls.append((stamp(m.header), list(m.ranges),
+                            float(m.angle_min), float(m.angle_max)))
+                counters["fls_rx"] += 1
+                del fls[:-8]
+
+            def on_dvl(m):
+                locked = sum(1 for b in m.beams if b.locked)
+                v = m.velocity.mean
+                dvl.append((stamp(m.header), [v.x, v.y, v.z], locked,
+                            bool(m.target.type == 1 and locked >= 3)))
+                counters["dvl_rx"] += 1
+                del dvl[:-8]
+
+            node.subscribe(Image, "/bluerov2_heavy/camera", on_image)
+            if "fls" in world_builder.SCENARIO_C_ARM_SENSING[config.arm_sensing]:
+                node.subscribe(LaserScan, "/bluerov2_heavy/fls/raw", on_fls)
+            if "dvl" in world_builder.SCENARIO_C_ARM_SENSING[config.arm_sensing]:
+                from gz.msgs10.dvl_velocity_tracking_pb2 import DVLVelocityTracking
+                node.subscribe(DVLVelocityTracking, "/bluerov2_heavy/dvl", on_dvl)
+
+        pubs = {j: node.advertise(
+            f"/model/bluerov2_heavy/joint/{j}/cmd_thrust", Double) for j in joints}
+        while not all(p.valid() for p in pubs.values()):
+            if time.time() > deadline:
+                raise RuntimeError("publishers")
+            time.sleep(0.2)
+        while not truth:
+            if time.time() > deadline:
+                raise RuntimeError("no pose")
+            time.sleep(0.2)
+
+        # READINESS BARRIER. Every declared stream must have delivered at least
+        # one message BEFORE the clock is zeroed, or the first ticks of a run
+        # see a different set of sensors than the next run does and acquisition
+        # timing moves. Startup order must not leak into the experiment.
+        need = [("imu", imu)]
+        if config.position_provider is not None:
+            need.append(("camera", frames))
+            arm = world_builder.SCENARIO_C_ARM_SENSING[config.arm_sensing]
+            if "fls" in arm:
+                need.append(("fls", fls))
+            if "dvl" in arm:
+                need.append(("dvl", dvl))
+        ready_deadline = time.time() + 60
+        while True:
+            missing = [n for n, b in need if not b]
+            if not missing:
+                break
+            if time.time() > ready_deadline:
+                raise RuntimeError(f"sensors never delivered: {missing}")
+            time.sleep(0.05)
+        s0 = truth[-1][0]
+        while truth[-1][0] - s0 < config.settle_s:
+            time.sleep(0.05)
+        # Discard everything queued during startup and settling: those messages
+        # describe a pre-run state and their count depends on wall-clock timing.
+        del frames[:], fls[:], dvl[:]
+        counters.update({k: 0 for k in counters})
+        zero = truth[-1][0]
+        last = zero
+        msg = Double()
+        offset = np.zeros(3)
+        last_valid_xy = np.zeros(2)
+        last_img_stamp = None
+        provider_detail: dict = {}
+        if config.position_provider is not None:
+            config.position_provider.reset(config.seed)
+
+        while truth and truth[-1][0] - zero < config.seconds:
+            # FIXED SIMULATION-TIME TICK GRID.
+            #
+            # The previous form polled sim time and set ``last = now``, so a tick
+            # happened whenever the poll noticed the period had elapsed and the
+            # grid drifted with wall-clock scheduling. When the real-time factor
+            # fluctuated, ticks were skipped and the number of control updates
+            # per simulated second changed between otherwise identical runs --
+            # 232/192/256 visual fixes for one seed. Pinning the grid to sim time
+            # makes dt exactly the control period and the tick instants
+            # reproducible, without changing how the simulator is stepped.
+            now = truth[-1][0]
+            period = 1.0 / config.control_hz
+            next_tick = last + period
+            if now < next_tick:
+                time.sleep(0.001)
+                continue
+            last = next_tick
+            elapsed = next_tick - zero
+            dt = period
+            _, pos_true, quat_true = truth[-1]
+
+            if (config.disturbance_at_s is not None
+                    and elapsed >= config.disturbance_at_s
+                    and not offset.any()):
+                offset = np.array(config.disturbance_m, dtype=float)
+
+            # --- depth: simulated Bar30, never truth --------------------
+            depth_measured = _measure_depth(depth_sensor, float(pos_true[2]), dt)
+
+            # --- attitude: IMU -----------------------------------------
+            if imu:
+                w, x, y, z = imu[-1][1]
+                roll = math.atan2(2 * (w * x + y * z), 1 - 2 * (x * x + y * y))
+                pitch = math.asin(max(-1.0, min(1.0, 2 * (w * y - z * x))))
+                yaw_rel = math.atan2(2 * (w * z + x * y), 1 - 2 * (y * y + z * z))
+                yaw = (spawn_yaw + yaw_rel + math.pi) % (2 * math.pi) - math.pi
+                rate = imu[-1][2]
+            else:
+                raise RuntimeError("IMU absent: the Heavy control path has no "
+                                   "truth fallback for attitude")
+            if config.attitude_noise_rad:
+                n = rng.normal(0, config.attitude_noise_rad, 3)
+                roll, pitch, yaw = roll + n[0], pitch + n[1], yaw + n[2]
+
+            # --- horizontal position: declared source -------------------
+            if config.position_provider is not None:
+                # OPERATIONAL PATH. The provider is handed sensors only; the
+                # observation dataclass carries no truth field, so there is no
+                # route by which pos_true could reach it.
+                counters["ticks"] += 1
+                f_item = newest_at_or_before(frames, now)
+                if f_item is None:
+                    counters["img_none"] += 1
+                    frame_img = None
+                elif f_item[0] == last_img_stamp:
+                    counters["img_reused"] += 1
+                    frame_img = None      # no NEW frame this tick
+                else:
+                    counters["img_used"] += 1
+                    last_img_stamp = f_item[0]
+                    frame_img = f_item[1]
+                fls_item = newest_at_or_before(fls, now)
+                dvl_item = newest_at_or_before(dvl, now)
+                obs = SensorObservation(
+                    t=elapsed, dt=dt,
+                    image=frame_img,
+                    roll=roll, pitch=pitch, yaw=yaw, angular_rate=rate,
+                    linear_acceleration=(np.asarray(imu[-1][3], float)
+                                         if imu and len(imu[-1]) > 3
+                                         else np.zeros(3)),
+                    depth_measured=depth_measured,
+                    fls_ranges=(np.asarray(fls_item[1], float) if fls_item else None),
+                    fls_acquisition_t=(float(fls_item[0]) if fls_item else None),
+                    fls_angle_min=(fls_item[2] if fls_item else 0.0),
+                    fls_angle_max=(fls_item[3] if fls_item else 0.0),
+                    dvl_velocity=(np.asarray(dvl_item[1], float) if dvl_item else None),
+                    dvl_acquisition_t=(float(dvl_item[0]) if dvl_item else None),
+                    dvl_beams_locked=(dvl_item[2] if dvl_item else 0),
+                    dvl_valid=(dvl_item[3] if dvl_item else False))
+                est = config.position_provider.update(obs)
+                provider_detail = est.detail
+                if est.valid:
+                    xy = np.asarray(est.xy, float).copy()
+                    last_valid_xy = xy.copy()
+                else:
+                    # No fix this tick: hold the provider's own last estimate.
+                    # Never fall back to truth -- that is the leak the guard and
+                    # the mutation tests exist to prevent.
+                    xy = last_valid_xy.copy()
+                    provider_detail = {**provider_detail, "held": True}
+            else:
+                est = None
+                rel = pos_true - spawn + offset
+                xy = rel[:2].copy()
+                provider_detail = {}
+                if config.position_noise_m:
+                    xy = xy + rng.normal(0, config.position_noise_m, 2)
+
+            # depth is measured; express it in the same spawn-relative frame
+            z_rel = depth_measured - float(spawn[2])
+            position = np.array([xy[0], xy[1], z_rel])
+
+            # body velocity: the PROVIDER's filtered estimate when it has one.
+            # Differencing the position signal is only valid when that signal
+            # updates every tick; a provider that holds a stale fix reports zero
+            # motion, and the tick after a fix reports a step.
+            provider_v = None
+            if config.position_provider is not None and est is not None:
+                provider_v = getattr(est, "velocity_xy", None)
+            if provider_v is not None:
+                c, s_ = math.cos(yaw), math.sin(yaw)
+                dworld = np.array([provider_v[0], provider_v[1],
+                                   (position[2] - rows[-1]["position"][2])
+                                   / max(elapsed - rows[-1]["t"], 1e-3)
+                                   if rows else 0.0])
+                v_body = np.array([c * dworld[0] + s_ * dworld[1],
+                                   -s_ * dworld[0] + c * dworld[1], dworld[2]])
+            elif rows:
+                prev = rows[-1]
+                dtp = max(elapsed - prev["t"], 1e-3)
+                dworld = (position - np.array(prev["position"])) / dtp
+                c, s = math.cos(yaw), math.sin(yaw)
+                v_body = np.array([c * dworld[0] + s * dworld[1],
+                                   -s * dworld[0] + c * dworld[1], dworld[2]])
+            else:
+                v_body = np.zeros(3)
+
+            state = HeavyState(position=position, velocity_body=v_body,
+                               roll=roll, pitch=pitch, yaw=yaw,
+                               angular_rate=rate)
+            wrench = controller.step(config.setpoint, state, dt)
+            report = allocator(wrench)
+            for i, j in enumerate(joints):
+                msg.data = float(report.thrusts[i])
+                pubs[j].publish(msg)
+
+            terminal_done = (config.position_provider is not None
+                             and est is not None
+                             and getattr(est, "mode", "") == "DONE")
+            rows.append({
+                "t": elapsed, "position": position.tolist(),
+                "truth_rel": (pos_true - spawn).tolist(),
+                "roll": roll, "pitch": pitch, "yaw": yaw,
+                "depth_measured": depth_measured, "depth_true": float(pos_true[2]),
+                "thrusts": report.thrusts.tolist(),
+                "effort": float(np.abs(report.thrusts).sum()),
+                "saturated": bool(report.saturated),
+                "residual": report.residual,
+                "provider": provider_detail,
+                # commanded BODY wrench -- surge is wrench[0]. Logging a single
+                # vectored thruster instead reads as a reversal that is not one.
+                "wrench": np.asarray(wrench, float).tolist(),
+                "v_body": np.asarray(v_body, float).tolist(),
+                "est_xy": [float(position[0]), float(position[1])],
+                # scoring only -- truth pose, full-pose envelope classifier
+                "capture": _score_capture(pos_true - spawn, quat_true,
+                                          config.setpoint, capture_geometry,
+                                          approach_yaw=spawn_yaw),
+            })
+            if terminal_done:
+                # The docking attempt is over: the blind traverse has elapsed and
+                # range is no longer observable or regulable. Continuing to fly
+                # wound the velocity integrator to -69 N against a pinned
+                # estimate and saturated the thrusters indefinitely. Ending the
+                # run here is the physical statement that the outcome is decided.
+                for j in joints:
+                    msg.data = 0.0
+                    pubs[j].publish(msg)
+                break
+
+        msg.data = 0.0
+        for p in pubs.values():
+            p.publish(msg)
+    finally:
+        # Shared teardown: graceful stop, group signal only when the child
+        # provably leads its own session and group, never a reaped PID.
+        terminate_owned_process(server)
+
+    return _summarise(config, rows, diagnostics, depth_sensor)
+
+
+def _summarise(config, rows, diagnostics, depth_sensor) -> HeavyRunRecord:
+    if not rows:
+        return HeavyRunRecord(config.run_id, {"error": "no ticks"},
+                              {"rows": []}, diagnostics)
+    t = np.array([r["t"] for r in rows])
+    truth_rel = np.array([r["truth_rel"] for r in rows])
+    target = np.asarray(config.setpoint.position, float)
+    err = np.linalg.norm(truth_rel - target, axis=1)
+    final = truth_rel[-1]
+    tail = t >= (t[-1] - 3.0)
+
+    # settling: last time the error leaves a 5 cm band
+    band = err > 0.05
+    settling = float(t[np.flatnonzero(band)[-1]]) if band.any() else 0.0
+    # overshoot along the dominant axis
+    axis = int(np.argmax(np.abs(target))) if np.any(np.abs(target) > 1e-6) else 0
+    if abs(target[axis]) > 1e-6:
+        travel = truth_rel[:, axis] / target[axis]
+        overshoot = float(max(0.0, travel.max() - 1.0) * 100.0)
+    else:
+        overshoot = 0.0
+
+    attitude_target = np.array([config.setpoint.roll, config.setpoint.pitch,
+                                config.setpoint.yaw])
+    att = np.array([[r["roll"], r["pitch"], r["yaw"]] for r in rows])
+    att_err = np.abs((att - attitude_target + math.pi) % (2 * math.pi) - math.pi)
+
+    metrics = {
+        "final_position_error_m": float(np.linalg.norm(final - target)),
+        "steady_state_error_m": float(err[tail].mean()),
+        "max_error_m": float(err.max()),
+        "settling_time_s": settling,
+        "overshoot_pct": overshoot,
+        "attitude_error_deg": {
+            "roll": float(np.degrees(att_err[tail, 0].mean())),
+            "pitch": float(np.degrees(att_err[tail, 1].mean())),
+            "yaw": float(np.degrees(att_err[tail, 2].mean()))},
+        "control_effort_Ns": float(_trapz([r["effort"] for r in rows], t)),
+        "mean_effort_N": float(np.mean([r["effort"] for r in rows])),
+        "saturation_fraction": float(np.mean([r["saturated"] for r in rows])),
+        "final_pose": {"x": float(final[0]), "y": float(final[1]),
+                       "z": float(final[2]),
+                       "roll_deg": float(np.degrees(att[-1, 0])),
+                       "pitch_deg": float(np.degrees(att[-1, 1])),
+                       "yaw_deg": float(np.degrees(att[-1, 2]))},
+        "ticks": len(rows),
+        "control_rate_hz": float(len(rows) / max(t[-1] - t[0], 1e-6)),
+        "depth_bias_m": float(depth_sensor.bias_m),
+        "depth_measurement_error_m": float(np.mean(
+            [abs(r["depth_measured"] - r["depth_true"]) for r in rows])),
+    }
+    # Per-tick rows are retained so a Scenario C trial can score perception,
+    # provider state and the capture classifier. Additive: existing consumers
+    # read series["t"] and series["error_m"] and are unaffected.
+    series = {"t": t.tolist(), "error_m": err.tolist(), "rows": rows}
+    return HeavyRunRecord(config.run_id, metrics, series, diagnostics)
diff --git a/src/uuv_sim_physics/uuv_sim_physics/docking/interfaces.py b/src/uuv_sim_physics/uuv_sim_physics/docking/interfaces.py
new file mode 100644
index 00000000..687c77c8
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/docking/interfaces.py
@@ -0,0 +1,64 @@
+"""The contract between the platform's docking runner and any perception.
+
+The runner owns the vehicle, the sensors and the control loop. A provider owns
+the answer to one question: *where is the dock, relative to me?* Everything the
+provider is allowed to know arrives in an ``Observation``.
+
+**An Observation contains only quantities a real vehicle could measure.** There
+is no field for true pose, and the runner has no code path that would put one
+there. That is what makes the leakage guarantee structural: a provider cannot
+receive privileged state because the type it is handed cannot carry it.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Protocol, runtime_checkable
+
+import numpy as np
+
+__all__ = ["Observation", "DockRelativeEstimate", "PerceptionProvider"]
+
+
+@dataclass(frozen=True)
+class Observation:
+    """One control tick's worth of measurable state."""
+    t_s: float                       # seconds since the run started
+    dt_s: float
+    camera: np.ndarray | None        # HWC uint8, already downsampled
+    fls_range: np.ndarray            # (rays,) metres, inf where invalid
+    fls_valid: np.ndarray            # (rays,) bool
+    velocity_body: np.ndarray        # measured DVL body-frame velocity
+    yaw_absolute: float              # measured IMU yaw, spawn-attitude composed
+    yaw_rate: float
+    depth_measured: float            # declared depth channel, world z
+    turbidity_c: float               # water condition the run is configured for
+    extras: dict = field(default_factory=dict)
+
+
+@dataclass
+class DockRelativeEstimate:
+    """A provider's answer. ``x`` and ``y`` are what the controller consumes."""
+    x: float
+    y: float
+    z: float = float("nan")
+    yaw_error: float = float("nan")
+    sigma: np.ndarray | None = None
+    source: str = "provider"
+
+    def xy(self) -> np.ndarray:
+        return np.array([self.x, self.y], dtype=float)
+
+    @property
+    def horizontal_range_m(self) -> float:
+        return float(np.hypot(self.x, self.y))
+
+
+@runtime_checkable
+class PerceptionProvider(Protocol):
+    """Anything that can localise the dock from measurable state."""
+
+    def reset(self) -> None:
+        """Called once before each run."""
+
+    def estimate(self, obs: Observation) -> DockRelativeEstimate:
+        """Return the dock-relative estimate for this tick."""
diff --git a/src/uuv_sim_physics/uuv_sim_physics/docking/ipc.py b/src/uuv_sim_physics/uuv_sim_physics/docking/ipc.py
new file mode 100644
index 00000000..fa4790fa
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/docking/ipc.py
@@ -0,0 +1,103 @@
+"""Transport for an out-of-process perception provider.
+
+Some perception stacks cannot share an interpreter with the simulator -- a
+learned model may need a framework the simulator's Python does not have, or
+vice versa. Rather than force one environment to bend, the provider runs as its
+own process behind a Unix domain socket.
+
+This module owns **framing only**. It knows how many bytes a request and a
+response are and how to read exactly that many; it does not know what is in
+them. The payload schema belongs to whoever is using the socket, because that is
+where the observation contract lives.
+
+Frames are fixed-size and length-free: when every request carries the same
+sensor payload the sizes are known at construction time and a read is a single
+``recv_exact``, with no length prefix to desynchronise.
+"""
+from __future__ import annotations
+
+import socket
+
+__all__ = ["recv_exact", "FrameCodec", "serve_forever", "connect"]
+
+DEFAULT_SOCKET = "/tmp/uuv_docking_perception.sock"
+
+
+def recv_exact(sock: socket.socket, count: int) -> bytes:
+    """Read exactly ``count`` bytes or raise."""
+    chunks, remaining = [], count
+    while remaining > 0:
+        chunk = sock.recv(remaining)
+        if not chunk:
+            raise ConnectionError(
+                f"socket closed with {remaining} of {count} bytes outstanding")
+        chunks.append(chunk)
+        remaining -= len(chunk)
+    return b"".join(chunks)
+
+
+class FrameCodec:
+    """Fixed request/response sizes for one provider protocol."""
+
+    def __init__(self, request_bytes: int, response_bytes: int) -> None:
+        self.request_bytes = int(request_bytes)
+        self.response_bytes = int(response_bytes)
+
+    def request(self, sock: socket.socket, payload: bytes) -> bytes:
+        if len(payload) != self.request_bytes:
+            raise ValueError(f"request is {len(payload)} bytes, "
+                             f"expected {self.request_bytes}")
+        sock.sendall(payload)
+        return recv_exact(sock, self.response_bytes)
+
+
+def connect(socket_path: str, timeout_s: float = 60.0) -> socket.socket:
+    """Connect, waiting for the server to bind."""
+    import time
+    deadline = time.time() + timeout_s
+    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    while True:
+        try:
+            sock.connect(socket_path)
+            return sock
+        except (FileNotFoundError, ConnectionRefusedError):
+            if time.time() > deadline:
+                raise RuntimeError(f"perception socket {socket_path} never appeared")
+            time.sleep(0.3)
+
+
+def serve_forever(socket_path: str, codec: FrameCodec, handler,
+                  on_ready=None) -> int:
+    """Serve requests until interrupted.
+
+    **One connection per run, served in a loop.** A single-accept server unlinks
+    its socket after the first client disconnects, so every later run finds
+    nothing to connect to -- a failure that looks like a model problem and is
+    not.
+    """
+    import os
+    if os.path.exists(socket_path):
+        os.unlink(socket_path)
+    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    server.bind(socket_path)
+    server.listen(1)
+    if on_ready is not None:
+        on_ready()
+    try:
+        while True:
+            connection, _ = server.accept()
+            try:
+                while True:
+                    try:
+                        payload = recv_exact(connection, codec.request_bytes)
+                    except ConnectionError:
+                        break
+                    connection.sendall(handler(payload))
+            finally:
+                connection.close()
+    except KeyboardInterrupt:
+        return 0
+    finally:
+        server.close()
+        if os.path.exists(socket_path):
+            os.unlink(socket_path)
diff --git a/src/uuv_sim_physics/uuv_sim_physics/docking/lockstep.py b/src/uuv_sim_physics/uuv_sim_physics/docking/lockstep.py
new file mode 100644
index 00000000..cfe2d957
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/docking/lockstep.py
@@ -0,0 +1,696 @@
+"""Deterministic lock-step execution for Scenario C.
+
+ADDITIVE. The free-running harness (``heavy_runtime.run_heavy``) is untouched
+and remains the execution mode that produced Gates 5/6 and every historical
+Heavy result. This module adds a second execution mode; it does not replace or
+reinterpret the first.
+
+Why
+---
+Under free-running execution the same A1 seed produced 233-378 visual fixes and
+a 70 mm spread in terminal miss, against a physical capture clearance of only
+28.6 mm. That variation came from scheduler and render-thread timing, not from
+any declared physical uncertainty, so it is nuisance variation of a kind that
+cannot be averaged away honestly.
+
+Contract
+--------
+1. The world runs PAUSED and is advanced explicitly, a fixed number of physics
+   steps at a time, onto a declared simulation-time grid.
+2. After each advance, block until every declared sensor has delivered its
+   publications up to that simulation timestamp. Completion is proven from
+   SIMULATION timestamps, never from elapsed wall time.
+3. The controller consumes only observations stamped at or before the current
+   simulation time.
+4. The next command is issued, then the world is advanced again.
+
+Wall time appears in exactly one role: detecting a hung process. It never enters
+the scientific state.
+
+The camera is the hard case: one physics step does not imply the render thread
+has published. The barrier below therefore waits for a frame stamped at or after
+the newest camera instant due at the target time, which proves every earlier
+frame has been emitted.
+"""
+from __future__ import annotations
+
+from ..process_group import terminate_owned_process
+
+import math
+import os
+import signal
+import subprocess
+import time
+from dataclasses import dataclass, field
+from pathlib import Path
+
+import numpy as np
+
+#: Wall-clock ceiling used ONLY to detect a hung simulator. Exceeding it raises;
+#: it never truncates a trial or becomes part of a result.
+HANG_TIMEOUT_S = 120.0
+
+
+class LockstepError(RuntimeError):
+    """Raised when the deterministic contract cannot be met."""
+
+
+class SensorBarrierTimeout(LockstepError):
+    """A declared sensor did not deliver by the required simulation time."""
+
+
+@dataclass
+class StreamSpec:
+    """One declared sensor stream and the rate it is expected to publish at."""
+    name: str
+    rate_hz: float
+    #: Streams that must be complete before a control tick may proceed.
+    required: bool = True
+    #: True for streams that publish on EVERY physics iteration (the pose feed).
+    #: Their completeness is checked as "newest stamp has reached the tick"
+    #: rather than by a rate-derived count, because a count over thousands of
+    #: samples per second is needlessly fragile when an exact sample must exist.
+    every_step: bool = False
+
+
+def due_instants(rate_hz: float, t_sim: float, eps: float = 1e-9) -> float:
+    """Newest publication instant of a ``rate_hz`` stream at or before t_sim."""
+    if rate_hz <= 0:
+        return t_sim
+    period = 1.0 / rate_hz
+    return math.floor((t_sim + eps) / period) * period
+
+
+class LockstepWorld:
+    """A paused Gazebo world advanced on an explicit simulation-time grid."""
+
+    @staticmethod
+    def sensor_rates_from_world(world_path: Path) -> dict:
+        """Declared update rate of every sensor, read from the built world.
+
+        Declaring rates by hand is the same defect class as assuming the physics
+        step: the IMU was declared 100 Hz here while the world declares 200, so
+        the delivery-count barrier expected half the samples and passed while
+        delivery was still incomplete.
+        """
+        import re
+        text = Path(world_path).read_text()
+        out = {}
+        for m in re.finditer(r'<sensor name="([^"]+)"[^>]*>(.*?)</sensor>',
+                             text, re.S):
+            rate = re.search(r"<update_rate>([^<]+)</update_rate>", m.group(2))
+            if rate:
+                out[m.group(1)] = float(rate.group(1))
+        return out
+
+    @staticmethod
+    def step_size_from_world(world_path: Path) -> float:
+        """Physics step read from the built world.
+
+        Assuming 0.001 made every stepped interval exactly half its expected
+        length; the Heavy world runs at 0.0005.
+        """
+        import re
+        m = re.search(r"<max_step_size>([^<]+)</max_step_size>",
+                      Path(world_path).read_text())
+        if not m:
+            raise LockstepError(f"no <max_step_size> in {world_path}")
+        return float(m.group(1))
+
+    def __init__(self, world_path: Path, world_name: str,
+                 step_size_s: float | None = None, gui: bool = False,
+                 plugin_path: Path | None = None,
+                 cpu_affinity: int | bool = False,
+                 serialize_physics_workers: bool = False):
+        from gz.transport13 import Node
+        self.world_name = world_name
+        self.step_size_s = float(step_size_s if step_size_s is not None
+                                 else self.step_size_from_world(world_path))
+        self.node = Node()
+        self.proc = None
+        self._sim_t = 0.0
+        self._actual_sim_t = -1.0
+        self._actual_paused = False
+        # A world starts PAUSED when -r is OMITTED; -r means "run on start".
+        # gz sim 8.11 has no --pause flag, and passing one stops the server from
+        # starting at all -- which is why no control service was ever advertised.
+        args = ["gz", "sim", "-v", "0", str(world_path)]
+        if not gui:
+            args.insert(2, "-s")
+        import os
+        if cpu_affinity:
+            # DART contact constraints and sensor PostUpdate callbacks share a
+            # process. Pinning the opt-in lockstep server prevents CPU migration
+            # and concurrent floating-point execution order from becoming an
+            # undeclared source of repeated-run variation.
+            available = sorted(os.sched_getaffinity(0))
+            count = 1 if cpu_affinity is True else int(cpu_affinity)
+            if count < 1 or count > len(available):
+                raise ValueError("invalid lockstep CPU-affinity width")
+            selected = ",".join(str(cpu) for cpu in available[:count])
+            args = ["taskset", "-c", selected] + args
+        env = os.environ.copy()
+        if serialize_physics_workers:
+            # The installed DART stack links libgomp. Its contact solve may
+            # otherwise accumulate constraints in scheduler-dependent order.
+            # Restrict only OpenMP workers; Gazebo's render/PostUpdate threads
+            # remain independent and retain their normal CPU access.
+            env["OMP_NUM_THREADS"] = "1"
+            env["OMP_DYNAMIC"] = "FALSE"
+        if plugin_path is not None:
+            prior = env.get("GZ_SIM_SYSTEM_PLUGIN_PATH", "")
+            env["GZ_SIM_SYSTEM_PLUGIN_PATH"] = (
+                str(plugin_path) + (os.pathsep + prior if prior else ""))
+        self.buffers: dict = {}
+        self.specs: dict = {}
+        self.tick_extra_blocks = 0
+        self._pacer = None
+        self._pace_consumed: dict = {}
+        self._pace_index: dict = {}
+        self._phase: dict = {}
+        self._recv: dict = {}
+        self._seen_stamps: dict = {}
+        self._first: dict = {}
+        self._command_pubs: dict = {}
+        self._command_echo_count: dict = {}
+        #: Ceiling on extra steps taken to reach simultaneous freshness.
+        self.max_extra_steps = 400
+        # Subscribe BEFORE the publisher / process exists. World statistics
+        # are not latched: even subscribing after process launch occasionally
+        # misses the paused world's sole initial t=0 sample.
+        self._register_world_stats()
+        initialized = False
+        self.proc = subprocess.Popen(args, stdout=subprocess.DEVNULL,
+                                     stderr=subprocess.DEVNULL,
+                                     start_new_session=True, env=env)
+        # Constructor failures occur before the caller can enter its own
+        # try/finally. Protect the process group from the instant it exists.
+        try:
+            self._await_stats_publisher()
+            self._await_service()
+            self._await_initial_world_stats()
+            initialized = True
+        finally:
+            if not initialized:
+                self._retire_process_and_transport()
+
+    def _register_world_stats(self) -> None:
+        """Observe completion of asynchronous ``multi_step`` requests."""
+        from gz.msgs10.world_stats_pb2 import WorldStatistics
+
+        def on_stats(msg):
+            self._stats_messages_received += 1
+            self._actual_sim_t = (msg.sim_time.sec +
+                                  msg.sim_time.nsec * 1e-9)
+            self._actual_paused = bool(msg.paused)
+
+        self._stats_messages_received = 0
+        self._stats_topic = f"/world/{self.world_name}/stats"
+        deadline = time.time() + 30.0
+        while not self.node.subscribe(
+                WorldStatistics, self._stats_topic, on_stats):
+            if time.time() > deadline:
+                raise LockstepError(
+                    f"world stats subscribe failed: {self._stats_topic}")
+            time.sleep(0.05)
+
+    def _await_stats_publisher(self) -> None:
+        """Distinguish transport discovery from first-message readiness."""
+        deadline = time.time() + 30.0
+        while True:
+            publishers, _subscribers = self.node.topic_info(self._stats_topic)
+            if publishers:
+                return
+            returncode = self.proc.poll()
+            if returncode is not None:
+                raise LockstepError(
+                    "Gazebo exited before world-stats publisher appeared: "
+                    f"returncode={returncode}, world={self.world_name}")
+            if time.time() > deadline:
+                raise LockstepError(
+                    f"world-stats publisher discovery timed out: "
+                    f"{self._stats_topic}")
+            time.sleep(0.01)
+
+    def _await_initial_world_stats(self) -> None:
+        """Require a t=0 statistics datum before permitting the first step.
+
+        This is startup readiness, not simulation logic.  The preceding
+        idempotent pause request ensures the world service is responsive while
+        the earlier subscription ensures its startup/status publication cannot
+        be missed.
+        """
+        deadline = time.time() + 30.0
+        while self._actual_sim_t < -0.5:
+            returncode = self.proc.poll()
+            if returncode is not None:
+                raise LockstepError(
+                    f"Gazebo exited before world statistics initialized: "
+                    f"returncode={returncode}, world={self.world_name}")
+            if time.time() > deadline:
+                raise LockstepError(
+                    f"world statistics readiness timed out after publisher "
+                    f"discovery: world={self.world_name}, "
+                    f"callbacks={self._stats_messages_received}")
+            time.sleep(0.001)
+
+    def _await_step_complete(self, target: float) -> None:
+        """Require actual simulator time at target and PAUSED before returning."""
+        deadline = time.time() + HANG_TIMEOUT_S
+        while (self._actual_sim_t < target - 0.5 * self.step_size_s
+               or not self._actual_paused):
+            if time.time() > deadline:
+                raise LockstepError(
+                    f"step not complete: actual={self._actual_sim_t:.9f}, "
+                    f"target={target:.9f}, paused={self._actual_paused}")
+            time.sleep(0.001)
+
+    def _await_service(self) -> None:
+        """Block until the world control service answers.
+
+        Probes with an idempotent `pause: true`. Probing with `multi_step: 0` is
+        refused forever, which hung the first implementation.
+        """
+        deadline = time.time() + 60.0
+        while True:
+            try:
+                if self._control("pause: true"):
+                    return
+            except subprocess.TimeoutExpired:
+                pass
+            if time.time() > deadline:
+                raise LockstepError(
+                    f"world control service never answered: {self.world_name}")
+            time.sleep(0.5)
+
+    # --- stream registration ------------------------------------------
+    def register(self, spec: StreamSpec, msg_type, topic: str, extract) -> None:
+        """Subscribe a stream into a sim-stamped buffer."""
+        buf: list = []
+        self.buffers[spec.name] = buf
+        self.specs[spec.name] = spec
+
+        name = spec.name
+        self._recv[name] = 0
+        self._seen_stamps[name] = set()
+
+        def cb(m, _buf=buf, _extract=extract, _name=name):
+            item = _extract(m)
+            if item is not None:
+                # MONOTONIC receive count and first stamp, kept OUTSIDE the
+                # buffer. The buffer is trimmed to bound memory, so counting it
+                # caps the total: the delivery barrier expected 257 IMU samples
+                # and the trimmed buffer could never report more than 256, so
+                # the barrier could never be satisfied and the trial died at
+                # t=1.28. Phase is captured on first receipt for the same reason.
+                if item[0] not in self._seen_stamps[_name]:
+                    self._seen_stamps[_name].add(item[0])
+                    self._recv[_name] += 1
+                if _name not in self._first:
+                    self._first[_name] = item[0]
+                _buf.append(item)
+                if len(_buf) > 512:
+                    del _buf[:-512]
+
+        deadline = time.time() + 30.0
+        while not self.node.subscribe(msg_type, topic, cb):
+            if time.time() > deadline:
+                raise LockstepError(f"subscribe failed: {topic}")
+            time.sleep(0.05)
+
+    def register_confirmed_command(self, name: str, msg_type, topic: str):
+        """Advertise a command and observe its transport delivery before stepping.
+
+        A plain ``publish(); multi_step`` is a race: the server may execute the
+        first physics iteration before the command reaches transport subscribers.
+        The loopback subscription provides a delivery fence without advancing
+        simulation state.  A subsequent idempotent world-control service round
+        trip fences server-side transport handling before integration begins.
+        """
+        self._command_echo_count[name] = 0
+
+        def echoed(_msg, _name=name):
+            self._command_echo_count[_name] += 1
+
+        deadline = time.time() + 30.0
+        while not self.node.subscribe(msg_type, topic, echoed):
+            if time.time() > deadline:
+                raise LockstepError(f"command echo subscribe failed: {topic}")
+            time.sleep(0.05)
+        pub = self.node.advertise(topic, msg_type)
+        self._command_pubs[name] = pub
+        return pub
+
+    def publish_confirmed(self, name: str, msg) -> None:
+        """Publish one command, then require delivery before any physics step."""
+        self.publish_batch_confirmed([(name, msg)])
+
+    def publish_batch_confirmed(self, commands) -> None:
+        """Publish a control-cycle batch, then fence it once before stepping."""
+        commands = list(commands)
+        before = {name: self._command_echo_count[name] for name, _ in commands}
+        for name, msg in commands:
+            self._command_pubs[name].publish(msg)
+        deadline = time.time() + HANG_TIMEOUT_S
+        while any(self._command_echo_count[name] <= before[name]
+                  for name, _ in commands):
+            if time.time() > deadline:
+                missing = [name for name, _ in commands
+                           if self._command_echo_count[name] <= before[name]]
+                raise LockstepError(f"command delivery not observed: {missing}")
+            time.sleep(0.001)
+        # Idempotent server-side fence. This changes no simulation state.
+        if not self._control("pause: true"):
+            raise LockstepError("command batch server fence refused")
+
+    # --- stepping ------------------------------------------------------
+    def _control(self, req_text: str) -> bool:
+        """Issue a world-control request.
+
+        Through the `gz service` CLI, not the Python binding: gz-transport13's
+        Python `request()` and `request_raw()` both time out against this
+        service here while the CLI returns `data: true` for the identical
+        request. The CLI is the only client that actually receives the reply, so
+        it is the one the contract can be built on.
+        """
+        self.last_control_output = ""
+        for attempt in range(3):
+            out = subprocess.run(
+                ["gz", "service", "-s", f"/world/{self.world_name}/control",
+                 "--reqtype", "gz.msgs.WorldControl", "--reptype", "gz.msgs.Boolean",
+                 "--timeout", "5000", "--req", req_text],
+                capture_output=True, text=True, timeout=30)
+            self.last_control_output = (out.stdout or "") + (out.stderr or "")
+            if "data: true" in out.stdout:
+                return True
+            # A step request can be refused while a previous one is still
+            # pending. Retrying is safe: a refused request advances nothing.
+            time.sleep(0.05)
+        return False
+
+    def _step_exact(self, n: int) -> None:
+        """Advance exactly ``n`` iterations, robust to a lost service reply.
+
+        ``multi_step`` is not idempotent. Retrying merely because its reply was
+        lost can execute the block twice. Actual world statistics decide whether
+        an attempt completed before any retry is allowed.
+        """
+        if n <= 0:
+            return
+        deadline = time.time() + HANG_TIMEOUT_S
+        while self._actual_sim_t < -0.5:
+            if time.time() > deadline:
+                raise LockstepError("world statistics never initialized")
+            time.sleep(0.001)
+        start = self._actual_sim_t
+        target = round(start + n * self.step_size_s, 9)
+        for _attempt in range(3):
+            out = subprocess.run(
+                ["gz", "service", "-s", f"/world/{self.world_name}/control",
+                 "--reqtype", "gz.msgs.WorldControl",
+                 "--reptype", "gz.msgs.Boolean", "--timeout", "5000",
+                 "--req", f"pause: true, multi_step: {n}"],
+                capture_output=True, text=True, timeout=30)
+            attempt_deadline = time.time() + 6.0
+            while time.time() < attempt_deadline:
+                if self._actual_sim_t > target + 0.5 * self.step_size_s:
+                    raise LockstepError(
+                        f"multi_step overshoot: {self._actual_sim_t:.9f} > {target:.9f}")
+                if (abs(self._actual_sim_t - target) <= 0.5 * self.step_size_s
+                        and self._actual_paused):
+                    self._sim_t = target
+                    return
+                time.sleep(0.001)
+            if self._actual_sim_t > start + 0.5 * self.step_size_s:
+                raise LockstepError(
+                    f"partial multi_step: {self._actual_sim_t:.9f}, target {target:.9f}")
+        raise LockstepError(f"multi_step={n} neither replied nor advanced")
+
+    def set_body_wrench(self, wrench) -> None:
+        """Synchronously latch a body-frame wrench in the lockstep system."""
+        vals = [float(x) for x in wrench]
+        if len(vals) != 6:
+            raise ValueError("body wrench must contain 6 values")
+        req = (f"force: {{x: {vals[0]:.17g}, y: {vals[1]:.17g}, "
+               f"z: {vals[2]:.17g}}}, torque: {{x: {vals[3]:.17g}, "
+               f"y: {vals[4]:.17g}, z: {vals[5]:.17g}}}")
+        last = ""
+        for _attempt in range(3):
+            out = subprocess.run(
+                ["gz", "service", "-s",
+                 "/model/bluerov2_heavy/lockstep_wrench",
+                 "--reqtype", "gz.msgs.Wrench", "--reptype", "gz.msgs.Boolean",
+                 "--timeout", "5000", "--req", req],
+                capture_output=True, text=True, timeout=30)
+            last = (out.stdout or "") + (out.stderr or "")
+            if "data: true" in out.stdout:
+                return
+            # The same persistent wrench is idempotent. The world stays paused,
+            # so retrying after a lost reply cannot advance or double-apply it.
+            time.sleep(0.05)
+        raise LockstepError("lockstep wrench service refused: " + last)
+
+    def set_thruster_forces(self, thrusts) -> None:
+        """Synchronously latch the eight native-equivalent link forces."""
+        from gz.msgs10.boolean_pb2 import Boolean
+        from gz.msgs10.double_v_pb2 import Double_V
+        vals = [float(x) for x in thrusts]
+        if len(vals) != 8:
+            raise ValueError("Heavy lockstep actuation requires 8 thrust values")
+        req = Double_V()
+        req.data.extend(vals)
+        last = ""
+        for _attempt in range(3):
+            try:
+                ok, rep = self.node.request(
+                    "/model/bluerov2_heavy/lockstep_thrusts", req,
+                    Double_V, Boolean, 5000)
+                last = f"ok={ok}, data={getattr(rep, 'data', None)}"
+            except Exception as exc:
+                ok, rep = False, None
+                last = repr(exc)
+            if ok and rep is not None and rep.data:
+                return
+            time.sleep(0.05)
+        raise LockstepError(
+            "lockstep thrust service refused: " + last +
+            f"; gazebo_returncode={self.proc.poll()}; "
+            f"sim_t={self._actual_sim_t:.9f}; paused={self._actual_paused}")
+
+    def thrust_diagnostics(self) -> dict:
+        """Read the opt-in actuator's last completed PreUpdate state.
+
+        This service is diagnostic only: it is called while the world is paused
+        and neither changes the command nor advances simulation time.
+        """
+        from gz.msgs10.double_v_pb2 import Double_V
+        req = Double_V()
+        ok, rep = False, None
+        for _attempt in range(3):
+            try:
+                ok, rep = self.node.request(
+                    "/model/bluerov2_heavy/lockstep_thrust_diagnostics", req,
+                    Double_V, Double_V, 5000)
+            except Exception:
+                ok, rep = False, None
+            if ok and rep is not None and len(rep.data) >= 4:
+                break
+            time.sleep(0.05)
+        if not ok or rep is None or len(rep.data) < 4:
+            raise LockstepError(
+                "lockstep thrust diagnostics unavailable after retries: "
+                f"ok={ok}, reply={rep!r}, "
+                f"size={len(rep.data) if rep is not None else None}")
+        values = list(rep.data)
+        rotor = []
+        for start in range(4, len(values), 5):
+            chunk = values[start:start + 5]
+            if len(chunk) == 5:
+                rotor.append(dict(zip(
+                    ("thrust", "desired_omega", "current_omega", "error",
+                     "rotor_torque"), chunk)))
+        return {"physics_iteration": int(values[0]), "sim_time": values[1],
+                "command_seq": int(values[2]), "applied_seq": int(values[3]),
+                "rotors": rotor}
+
+    def advance_to(self, t_target: float) -> float:
+        """Advance to ``t_target`` and wait for owed deliveries. Returns sim time."""
+        n = int(round((t_target - self._sim_t) / self.step_size_s))
+        if n > 0:
+            self._step_exact(n)
+        self._await_delivery(self._sim_t)
+        return self._sim_t
+
+    def advance_one_frame(self, pace_stream: str) -> float:
+        """Advance one causal fixed-grid control interval.
+
+        The grid is the smallest integer physics-step interval not faster than
+        the declared pacing sensor: ceil(period / step). At the paused boundary,
+        the count barrier includes the camera and proves every acquisition up to
+        that time has arrived. The newest acquisition at/before the boundary is
+        then consumed and the resulting command affects future physics only.
+        """
+        self._pacer = None  # include the pacing stream in the count barrier
+        buf = self.buffers[pace_stream]
+        period = 1.0 / self.specs[pace_stream].rate_hz
+        # One extra physics step covers the rendering trigger quantization in
+        # addition to the acquisition-period quantization. 67 steps eventually
+        # produced an empty interval at 11.122 s; the derived upper bound is
+        # ceil(period/step)+1 = 68 steps (34 ms, 29.41 Hz).
+        n = max(int(math.ceil(period / self.step_size_s - 1e-12)) + 1, 1)
+        self._step_exact(n)
+        self._await_delivery(self._sim_t)
+        previous = self._pace_consumed.get(pace_stream, -1.0)
+        deadline = time.time() + HANG_TIMEOUT_S
+        while True:
+            newest = max((it[0] for it in buf
+                          if it[0] <= self._sim_t + 1e-9), default=-1.0)
+            if newest > previous + 1e-9:
+                self._pace_consumed[pace_stream] = newest
+                self.tick_extra_blocks = 0
+                return self._sim_t
+            if time.time() > deadline:
+                raise SensorBarrierTimeout(
+                    f"{pace_stream} has no new acquisition by {self._sim_t:.9f}")
+            time.sleep(0.001)
+
+    def _prove_beyond(self, t_tick: float) -> None:
+        """Step until every required non-pacing stream has a stamp > t_tick."""
+        deadline = time.time() + HANG_TIMEOUT_S
+        while True:
+            need = []
+            for name, spec in self.specs.items():
+                if not spec.required or spec.rate_hz <= 0 or name == self._pacer:
+                    continue
+                newest = max((it[0] for it in self.buffers[name]), default=-1.0)
+                if newest <= t_tick + 1e-12:
+                    need.append((name, spec))
+            if not need:
+                return
+            if time.time() > deadline:
+                raise SensorBarrierTimeout(
+                    f"cannot prove completeness beyond t={t_tick:.4f}: "
+                    f"{[n for n, _ in need]}")
+            # advance by the coarsest outstanding period, so the overshoot stays
+            # bounded and identical between runs
+            period = max(1.0 / sp.rate_hz for _, sp in need)
+            blk = max(int(period / self.step_size_s), 1)
+            self._step_exact(blk)
+
+    def _await_delivery(self, t_now: float) -> None:
+        """Block until every required stream has delivered EVERY sample it
+        generated for simulation times at or before ``t_now``.
+
+        COUNT, not lower bound. Requiring only "newest >= t_now - period" is a
+        lower bound that several delivery states satisfy, so two runs could pass
+        it holding different newest samples -- measured as IMU 0.350 vs 0.355 at
+        tick 0.3575, after which the observation sequences diverged.
+
+        Because the world is paused at ``t_now``, every sample for a time <=
+        t_now has already been GENERATED; only delivery is outstanding. The
+        number generated is a function of simulation time alone, so it can be
+        predicted from the stream's own first stamp (its phase) and its declared
+        rate, and the barrier waits for exactly that many.
+
+        The pacing stream is excluded: its completeness is guaranteed by
+        construction, since a tick exists precisely because it emitted. It is
+        also the stream whose instants jitter -- 1/30 s is 66.67 physics steps
+        at 0.0005 s, so it fires every 66 or 67 -- which a count rule cannot
+        model exactly.
+        """
+        deadline = time.time() + HANG_TIMEOUT_S
+        while True:
+            pending = []
+            for name, spec in self.specs.items():
+                if not spec.required or name == self._pacer:
+                    continue
+                if spec.rate_hz <= 0 and not spec.every_step:
+                    continue
+                if name not in self._first:
+                    # A periodic stream need not emit at the first physics
+                    # step. Before one full declared period has elapsed, zero
+                    # samples is a valid generated count (e.g. 50 Hz scoring
+                    # odometry at t=0.0005). After that it is missing.
+                    if (spec.rate_hz > 0 and
+                            t_now < (1.0 / spec.rate_hz) - 1e-12):
+                        continue
+                    pending.append(f"{name}(no samples)")
+                    continue
+                if spec.every_step:
+                    newest = max((it[0] for it in self.buffers[name]), default=-1.0)
+                    if newest < t_now - 1e-9:
+                        pending.append(f"{name}(newest={newest:.5f}<{t_now:.5f})")
+                    continue
+                phase = self._first[name]
+                period = 1.0 / spec.rate_hz
+                expected = int(math.floor((t_now - phase) / period + 1e-9)) + 1
+                # Future-stamped callbacks may already be in the transport
+                # buffer. They cannot prove completeness at `t_now`.
+                have = sum(1 for s in self._seen_stamps[name]
+                           if s <= t_now + 1e-9)
+                if have < expected:
+                    pending.append(f"{name}({have}/{expected})")
+            if not pending:
+                return
+            if time.time() > deadline:
+                raise SensorBarrierTimeout(
+                    f"delivery incomplete at t={t_now:.4f}: {pending}")
+            time.sleep(0.001)
+
+    def newest_at_or_before(self, name: str, t_sim: float):
+        """Newest observation of ``name`` stamped at or before ``t_sim``."""
+        best = None
+        for item in self.buffers[name]:
+            if item[0] <= t_sim + 1e-9 and (best is None or item[0] > best[0]):
+                best = item
+        return best
+
+    @property
+    def sim_time(self) -> float:
+        return self._sim_t
+
+    def _retire_process_and_transport(self) -> None:
+        """Retire a fully or partially initialized server without orphans."""
+        import gc
+        proc = self.proc
+        _terminate_owned_process(proc)
+        try:
+            self.buffers.clear()
+            self.specs.clear()
+            self._command_pubs.clear()
+            del self.node
+        except Exception:
+            pass
+        gc.collect()
+        time.sleep(1.0)
+
+    def close(self) -> None:
+        """Gracefully retire one server before the same transport names recur.
+
+        Abrupt SIGKILL followed by immediate relaunch left the previous world's
+        publishers and services in transport discovery. The next repeat then
+        observed duplicate publishers and occasional duplicate/misdirected
+        service callbacks. A bounded graceful stop plus discovery-quiescence
+        interval is execution hygiene; it advances no simulation state.
+        """
+        try:
+            self._retire_process_and_transport()
+        except Exception:
+            pass
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        self.close()
+        return False
+
+def _terminate_owned_process(proc, timeout_s: float = 10.0) -> None:
+    """Terminate one child without ever signalling the caller's process group.
+
+    Delegates to the shared implementation. Four call sites had grown four
+    near-identical copies of this guard and two more had none; keeping one
+    implementation means one place to test and one place to fix.
+    """
+    terminate_owned_process(proc, timeout_s=timeout_s)
+
