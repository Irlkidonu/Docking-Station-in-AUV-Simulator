+++ b/src/uuv_mode_aware_navigation/launch/playground_docking.launch.py
@@ -0,0 +1,187 @@
+"""Rich playground rendered around the powered Heavy docking plant."""
+from __future__ import annotations
+
+import sys
+import os
+import fcntl
+from pathlib import Path
+
+from ament_index_python.packages import get_package_share_directory
+from launch import LaunchDescription
+from launch.actions import (DeclareLaunchArgument, ExecuteProcess, OpaqueFunction,
+                            RegisterEventHandler, SetEnvironmentVariable, Shutdown)
+from launch.conditions import IfCondition, UnlessCondition
+from launch.event_handlers import OnProcessExit
+from launch.substitutions import LaunchConfiguration
+from launch_ros.actions import Node
+
+
+def _env_dir(name: str) -> Path:
+    value = os.environ.get(name)
+    if not value:
+        raise RuntimeError(f"environment variable {name} is not set (see the README)")
+    return Path(value).expanduser().resolve()
+
+
+P3 = _env_dir("DOCKING_STATION_ROOT")
+SIM = _env_dir("AUV_SIM_ROOT")
+FINAL_CLEAN_CHECKPOINT = P3 / "models" / "cleanH.pt"
+RUNTIME_WORLD = (Path(os.environ.get("DOCK_RUNTIME_ROOT",
+                                    os.path.expanduser("~/.cache/docking_station/runtime"))) /
+                 "playground_docking.sdf")
+ROS_DOMAIN = os.environ.get("DOCK_ROS_DOMAIN_ID", "43")
+# Never let an orphaned Gazebo server from an earlier interactive session join
+# a new world with the same name.  An explicit partition remains available to
+# deterministic engineering harnesses; ordinary GUI launches get a fresh one.
+GZ_PARTITION = os.environ.get(
+    "DOCK_GZ_PARTITION", f"docking_station_{os.getpid()}")
+_SESSION_LOCK = None
+
+
+def _build(_context):
+    global _SESSION_LOCK
+    lock_path = Path("/tmp/docking_station_playground.lock")
+    _SESSION_LOCK = lock_path.open("w")
+    try:
+        fcntl.flock(_SESSION_LOCK.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+    except BlockingIOError as exc:
+        raise RuntimeError(
+            "another docking-station launch is already active; close it "
+            "before starting a new session") from exc
+    _SESSION_LOCK.write(f"pid={os.getpid()} partition={GZ_PARTITION}\n")
+    _SESSION_LOCK.flush()
+
+    variant = LaunchConfiguration("dock_variant").perform(_context)
+    if variant not in {"cleaned", "marker_assisted"}:
+        raise RuntimeError(
+            "dock_variant must be 'cleaned' or 'marker_assisted', "
+            f"not {variant!r}")
+
+    # Present the two supported demonstrations as a ROS launch interface rather
+    # than requiring users to know private implementation environment switches.
+    # The child supervisor still receives the established variables, preserving
+    # its checkpoint-selection behavior and all scientific/runtime logic.
+    if variant == "cleaned":
+        if not FINAL_CLEAN_CHECKPOINT.is_file():
+            raise RuntimeError(
+                f"cleaned-dock checkpoint is missing: {FINAL_CLEAN_CHECKPOINT}")
+        os.environ["DOCK_CLEAN_DOCK"] = "1"
+        os.environ["DOCK_DEV_CHECKPOINT"] = str(FINAL_CLEAN_CHECKPOINT)
+    else:
+        os.environ.pop("DOCK_CLEAN_DOCK", None)
+        os.environ.pop("DOCK_DEV_CHECKPOINT", None)
+        os.environ.pop("DOCK_USE_FROZEN", None)
+
+    sys.path[:0] = [str(P3), str(SIM / "src/uuv_sim_physics")]
+    from docking_perception.integration.playground_world import build_playground_docking_world
+    from uuv_sim_physics import world_builder
+
+    RUNTIME_WORLD.parent.mkdir(parents=True, exist_ok=True)
+    # Active AUV-Simulator asset.  The historical navigation-demonstrator copy was useful only
+    # as the visual reference used while this overlay was developed.
+    playground = (SIM / "src/uuv_mode_aware_navigation/worlds/"
+                  "mode_aware_survey.sdf")
+    capture = P3 / "worlds/underwater_docking_physics.sdf"
+    heavy = world_builder.build_world_sdf(
+        validated=True, vehicle="bluerov2_heavy",
+        arm_sensing="CR6_REALISTIC_FLS_DVL", lockstep_depth_sensor=True)
+    text = build_playground_docking_world(
+        playground, heavy, capture, world_name="mode_aware_survey")
+    temporary = RUNTIME_WORLD.with_suffix(".sdf.partial")
+    temporary.write_text(text)
+    temporary.replace(RUNTIME_WORLD)
+    return []
+
+
+def generate_launch_description() -> LaunchDescription:
+    share = Path(get_package_share_directory("uuv_mode_aware_navigation"))
+    gui = LaunchConfiguration("gui")
+    panel = LaunchConfiguration("panel")
+    gz_gui = ExecuteProcess(
+        cmd=["gz", "sim", "-r", "-v", "1", str(RUNTIME_WORLD)],
+        output="screen", condition=IfCondition(gui))
+    gz_headless = ExecuteProcess(
+        cmd=["gz", "sim", "-s", "-r", "-v", "1", str(RUNTIME_WORLD)],
+        output="screen", condition=UnlessCondition(gui))
+    return LaunchDescription([
+        DeclareLaunchArgument(
+            "dock_variant", default_value="cleaned",
+            description=("docking-station presentation: 'cleaned' (final "
+                         "open-bore system) or 'marker_assisted' (five green "
+                         "guidance beams)")),
+        DeclareLaunchArgument("gui", default_value="true",
+                              description="open the Gazebo graphical client"),
+        DeclareLaunchArgument("panel", default_value="true",
+                              description="open the interaction panel"),
+        OpaqueFunction(function=_build),
+        # Keep the demonstrator isolated from an independently running navigation-demonstrator
+        # playground. Both applications intentionally use familiar topic and
+        # world names, so sharing DDS / Gazebo transport would create multiple
+        # control and state publishers and apparent state chatter.
+        SetEnvironmentVariable("ROS_DOMAIN_ID", ROS_DOMAIN),
+        SetEnvironmentVariable("GZ_PARTITION", GZ_PARTITION),
+        SetEnvironmentVariable("GZ_SIM_RESOURCE_PATH", str(share.parent)),
+        # Offscreen camera rendering picks an EGL vendor, and on a machine with
+        # both NVIDIA and Mesa installed it can pick Mesa, fail to create a
+        # screen and fall back to software rendering for every camera frame.
+        # The rich playground names the NVIDIA vendor for exactly this reason;
+        # this launch did not, so both onboard cameras were liable to render on
+        # the CPU. Harmless where NVIDIA is absent: the file does not exist and
+        # the loader carries on.
+        SetEnvironmentVariable(
+            "__EGL_VENDOR_LIBRARY_FILENAMES",
+            "/usr/share/glvnd/egl_vendor.d/10_nvidia.json"),
+        gz_gui, gz_headless,
+        # The scenery in this world is alive only while something commands it.
+        # fish, jellyfish and weed each carry a VelocityControl plugin bound to
+        # /model/<name>/cmd_vel with no <initial_linear>, so with no publisher
+        # they sit exactly still -- which is why the composed world looked like
+        # a photograph of the playground rather than the playground. (Marine
+        # snow is the exception: it declares an initial velocity and drifted on
+        # its own.) These are the same models, plugins and topics the rich
+        # simulator uses; only the ROS-to-Gazebo command path was missing.
+        Node(
+            package="ros_gz_bridge", executable="parameter_bridge",
+            name="scenery_bridge", output="log",
+            arguments=[
+                f"/model/fish_{i}/cmd_vel@geometry_msgs/msg/Twist]gz.msgs.Twist"
+                for i in range(10)
+            ] + [
+                f"/model/jelly_{i}/cmd_vel@geometry_msgs/msg/Twist]gz.msgs.Twist"
+                for i in range(12)
+            ] + [
+                f"/model/weed_{i}/cmd_vel@geometry_msgs/msg/Twist]gz.msgs.Twist"
+                for i in range(24)
+            ],
+        ),
+        Node(
+            package="uuv_mode_aware_navigation", executable="fish_school",
+            name="fish_school", output="log",
+            parameters=[{"count": 10, "jellies": 12, "weeds": 24}],
+            # The school startles away from the vehicle, so it needs to know
+            # where the vehicle is. This is scenery: nothing in the study, the
+            # controller or the navigation estimate reads it, and the
+            # operational sensor path is untouched by it.
+            remappings=[("/uuv/true_position", "/uuv/scoring_truth_position")],
+        ),
+        Node(package="uuv_mode_aware_navigation", executable="control_panel",
+             name="control_panel", output="screen", condition=IfCondition(panel)),
+        Node(package="uuv_mode_aware_navigation", executable="water_column",
+             name="water_column", output="screen",
+             parameters=[{"turbidity_c": 0.2}]),
+        ExecuteProcess(cmd=["/usr/bin/python3", str(
+            P3 / "tools/vehicle_bridge.py")], output="screen"),
+        ExecuteProcess(cmd=["/usr/bin/python3", str(
+            P3 / "tools/docking_supervisor.py")], output="screen"),
+        ExecuteProcess(cmd=["/usr/bin/python3", str(
+            P3 / "tools/session_recorder.py")], output="screen"),
+        # The Gazebo window's camera panel: the onboard view after the modeled
+        # water column, on the topic that panel already names.
+        ExecuteProcess(cmd=["/usr/bin/python3", str(
+            P3 / "tools/operator_camera.py")], output="screen"),
+        # Closing Gazebo ends the session, as it does in the rich playground.
+        # Without this the panel and the supervisor outlive the simulator they
+        # were watching and have to be found and killed by hand.
+        RegisterEventHandler(OnProcessExit(
+            target_action=gz_gui, on_exit=[Shutdown(reason="Gazebo closed")])),
+    ])
