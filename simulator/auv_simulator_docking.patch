+"""Shared particulate medium for optical imaging and nephelometry.
+
+The state variable is particle concentration and class, never NTU or renderer
+fog. Optical coefficients and 90-degree scattering are independent predictions
+from that same declared state. Values are simulation-class parameters, not a
+universal natural-water calibration.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+
+from .optical import WaterColumn, degrade
+
+
+@dataclass(frozen=True)
+class ParticleClass:
+    name: str
+    mass_scattering_m2_per_g_at_550nm: float
+    mass_absorption_m2_per_g_at_550nm: float
+    asymmetry_g: float
+    scattering_spectral_exponent: float
+    absorption_spectral_exponent: float
+
+
+# Explicit representative simulated classes. They are not assertions that a
+# field sample with the same NTU has these optical properties.
+FORMazin_REFERENCE = ParticleClass(
+    "formazin_reference", 0.002, 0.0, 0.50, 0.0, 0.0)
+MINERAL_SILT = ParticleClass(
+    "representative_mineral_silt", 0.020, 0.003, 0.82, 0.7, 0.4)
+ORGANIC_PARTICULATE = ParticleClass(
+    "representative_organic_particulate", 0.012, 0.010, 0.90, 1.0, 1.2)
+
+
+def henyey_greenstein(theta_rad: float, g: float) -> float:
+    cos_theta = float(np.cos(theta_rad))
+    return float((1.0 - g * g) /
+                 (4.0 * np.pi * (1.0 + g * g - 2.0 * g * cos_theta) ** 1.5))
+
+
+@dataclass(frozen=True)
+class ParticulateWaterMedium:
+    particle_class: ParticleClass = MINERAL_SILT
+    concentration_mg_per_l: float = 0.0
+    dissolved_absorption_rgb_m_inv: tuple = (0.12, 0.045, 0.025)
+    pure_water_scattering_rgb_m_inv: tuple = (0.008, 0.004, 0.002)
+    veiling_rgb: tuple = (0.12, 0.28, 0.32)
+
+    def __post_init__(self):
+        if self.concentration_mg_per_l < 0:
+            raise ValueError("particle concentration cannot be negative")
+
+    def optical_coefficients_rgb(self) -> dict:
+        # mg/L is numerically g/m^3. Multiplication by m^2/g gives m^-1.
+        concentration_g_m3 = float(self.concentration_mg_per_l)
+        wavelength_nm = np.array([650.0, 550.0, 450.0])
+        scale = wavelength_nm / 550.0
+        b_particles = (self.particle_class.mass_scattering_m2_per_g_at_550nm
+                       * concentration_g_m3
+                       * scale ** (-self.particle_class.scattering_spectral_exponent))
+        a_particles = (self.particle_class.mass_absorption_m2_per_g_at_550nm
+                       * concentration_g_m3
+                       * scale ** (-self.particle_class.absorption_spectral_exponent))
+        b = np.asarray(self.pure_water_scattering_rgb_m_inv) + b_particles
+        a = np.asarray(self.dissolved_absorption_rgb_m_inv) + a_particles
+        return {"absorption_rgb_m_inv": a, "scattering_rgb_m_inv": b,
+                "attenuation_rgb_m_inv": a + b}
+
+    def scattering_at_90_per_m_sr(self) -> float:
+        b_green = self.optical_coefficients_rgb()["scattering_rgb_m_inv"][1]
+        return float(b_green * henyey_greenstein(np.pi / 2,
+                                                 self.particle_class.asymmetry_g))
+
+    def as_water_column(self) -> WaterColumn:
+        coeff = self.optical_coefficients_rgb()
+        # Existing WaterColumn is spectrally averaged; retain full RGB values in
+        # diagnostics and use luminance-weighted green-dominant coefficients.
+        weights = np.array([0.2126, 0.7152, 0.0722])
+        a = float(weights @ coeff["absorption_rgb_m_inv"])
+        b = float(weights @ coeff["scattering_rgb_m_inv"])
+        return WaterColumn(beam_attenuation=a + b,
+                           veiling_rgb=self.veiling_rgb,
+                           scattering_fraction=b / max(a + b, 1e-12))
+
+
+def degrade_from_medium(image: np.ndarray, medium: ParticulateWaterMedium,
+                        range_m: float | np.ndarray) -> np.ndarray:
+    """Camera image from the same medium observed by the nephelometer."""
+    return degrade(image, medium.as_water_column(), range_m)
