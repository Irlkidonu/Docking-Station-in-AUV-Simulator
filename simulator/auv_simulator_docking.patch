+"""Thrust allocation for the 8-thruster vectored6dof Heavy profile.
+
+**Additive.** ``control/allocation.py`` is untouched and still serves the
+representative 4-thruster plant; this module exists because that plant has no
+roll or pitch actuation and therefore cannot represent a Heavy.
+
+The allocation matrix ``T`` is 6 x n: each column is one thruster's wrench
+contribution per newton of thrust, ``[f ; r x f]``, built from the profile's
+declared axes and positions. A commanded wrench is solved by least squares and
+then saturated per thruster against the documented forward/reverse limits, which
+are **asymmetric** on a T200 (reverse is about 79% of forward).
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+
+__all__ = ["HeavyAllocator", "allocation_matrix", "AllocationReport"]
+
+
+def allocation_matrix(units: list) -> np.ndarray:
+    """6 x n wrench-per-newton matrix from thruster axes and positions."""
+    columns = []
+    for unit in units:
+        axis = np.asarray(unit["axis"], dtype=float)
+        axis = axis / np.linalg.norm(axis)
+        position = np.asarray(unit["position_m"], dtype=float)
+        columns.append(np.concatenate([axis, np.cross(position, axis)]))
+    return np.column_stack(columns)
+
+
+@dataclass
+class AllocationReport:
+    thrusts: np.ndarray
+    achieved: np.ndarray
+    requested: np.ndarray
+    saturated: list
+    residual: float
+
+
+class HeavyAllocator:
+    """Least-squares allocation with per-thruster asymmetric saturation."""
+
+    def __init__(self, vehicle: dict) -> None:
+        thrusters = vehicle["thrusters"]
+        self.units = thrusters["units"]
+        common = thrusters["common"]
+        self.max_forward = float(common["max_thrust_cmd_N"])
+        self.min_reverse = float(common["min_thrust_cmd_N"])
+        self.T = allocation_matrix(self.units)
+        self.pinv = np.linalg.pinv(self.T)
+
+    @property
+    def controllable_dof(self) -> int:
+        """Rank of the allocation matrix: how many wrench axes are reachable."""
+        return int(np.linalg.matrix_rank(self.T, tol=1e-9))
+
+    def axis_authority(self) -> dict:
+        """Maximum achievable wrench on each axis in isolation.
+
+        Solved as the best pure-axis wrench reachable with every thruster inside
+        its own asymmetric limit, which is what actually bounds the vehicle --
+        not the naive sum of thruster forces.
+        """
+        names = ("Fx", "Fy", "Fz", "Mx", "My", "Mz")
+        out = {}
+        for index, name in enumerate(names):
+            direction = np.zeros(6)
+            direction[index] = 1.0
+            base = self.pinv @ direction
+            if not np.any(np.abs(base) > 1e-12):
+                out[name] = 0.0
+                continue
+            scale = min((self.max_forward / t) if t > 0
+                        else (self.min_reverse / t) if t < 0 else np.inf
+                        for t in base if abs(t) > 1e-12)
+            out[name] = float(abs(scale))
+        return out
+
+    def __call__(self, wrench) -> AllocationReport:
+        requested = np.asarray(wrench, dtype=float).reshape(6)
+        thrusts = self.pinv @ requested
+        saturated = [self.units[i]["name"] for i, t in enumerate(thrusts)
+                     if t > self.max_forward + 1e-9 or t < self.min_reverse - 1e-9]
+        thrusts = np.clip(thrusts, self.min_reverse, self.max_forward)
+        achieved = self.T @ thrusts
+        return AllocationReport(thrusts, achieved, requested, saturated,
+                                float(np.linalg.norm(achieved - requested)))
diff --git a/src/uuv_sim_physics/uuv_sim_physics/control/heavy_controller.py b/src/uuv_sim_physics/uuv_sim_physics/control/heavy_controller.py
new file mode 100644
index 00000000..d517db6a
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/control/heavy_controller.py
@@ -0,0 +1,180 @@
+"""6-DoF controller for the Heavy profile.
+
+**Additive.** ``control/controller.py`` is untouched and still serves the 4-DoF
+representative plant; it has no roll or pitch channel and cannot fly an
+eight-thruster vehicle.
+
+Structure: six independent PD channels producing a body-frame wrench, handed to
+the rank-6 allocator. Translation is regulated in the dock/world frame and
+rotated into the body frame by measured attitude; attitude is regulated directly.
+
+**Feedback is measurement-only.** The controller receives a measured attitude, a
+measured depth and a position estimate from whatever provider the configuration
+allows. It never receives simulator truth -- validation scores it against truth
+from the outside.
+"""
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass, field
+
+import numpy as np
+
+__all__ = ["HeavyGains", "HeavySetpoint", "HeavyState", "HeavyController"]
+
+
+def _wrap(a):
+    return (a + math.pi) % (2 * math.pi) - math.pi
+
+
+@dataclass
+class HeavyGains:
+    """PD per channel. Not tuned against any docking outcome."""
+    #: OUTER loop: position error -> desired velocity, in 1/s. The commanded
+    #: speed is then clamped, so a distant target produces a capped approach
+    #: rate rather than a capped force.
+    kp_pos_xy: float = 0.8
+    kp_pos_z: float = 1.0
+    #: INNER loop: velocity error -> force, in N per m/s.
+    kv_xy: float = 60.0
+    kv_z: float = 70.0
+    ki_v_xy: float = 25.0
+    ki_v_z: float = 30.0
+    #: Explicit limits.
+    max_speed_mps: float = 0.4
+    max_vertical_speed_mps: float = 0.3
+    max_force_N: float = 70.0
+    max_force_rate_N_per_s: float = 400.0
+    kp_roll: float = 6.0
+    kd_roll: float = 3.0
+    kp_pitch: float = 6.0
+    kd_pitch: float = 3.0
+    kp_yaw: float = 8.0
+    kd_yaw: float = 4.0
+    #: Integral action. A PD alone cannot hold a commanded roll or pitch against
+    #: the vehicle's own righting moment, nor station-keep against a current:
+    #: both are constant disturbances and both leave a standing offset.
+    #: OUTER-loop position integral. A current displaces the vehicle
+    #: kinematically: it never appears in body-velocity error, so the inner
+    #: loop cannot see it and a proportional outer loop settles at
+    #: error = current_speed / kp_pos. Only a position integrator cancels it.
+    ki_pos_xy: float = 0.25
+    #: Zero on the vertical channel: depth is an absolute measurement and the
+    #: disturbance model has no vertical kinematic drift, so the inner velocity
+    #: integral already removes any standing buoyancy offset.
+    ki_pos_z: float = 0.0
+    ki_att: float = 1.5
+    integral_limit: float = 4.0        # anti-windup clamp
+
+
+@dataclass
+class HeavySetpoint:
+    position: np.ndarray = field(default_factory=lambda: np.zeros(3))
+    roll: float = 0.0
+    pitch: float = 0.0
+    yaw: float = math.pi
+
+
+@dataclass
+class HeavyState:
+    """Everything here is a measurement or an estimate, never truth."""
+    position: np.ndarray            # x, y from a provider; z from the depth model
+    velocity_body: np.ndarray
+    roll: float
+    pitch: float
+    yaw: float
+    angular_rate: np.ndarray        # measured gyro, body frame
+
+
+class HeavyController:
+    """Six independent PD channels -> body wrench."""
+
+    def __init__(self, gains: HeavyGains | None = None) -> None:
+        self.gains = gains or HeavyGains()
+        self.reset()
+
+    def reset(self) -> None:
+        self._i_vel = np.zeros(3)
+        self._i_pos = np.zeros(3)
+        self._i_att = np.zeros(3)
+        self._last_force = np.zeros(3)
+
+    def diagnostic_state(self) -> dict:
+        """Return a copy of controller memory for development instrumentation.
+
+        This accessor is observational only: it is not used by the controller
+        or the plant and therefore cannot alter closed-loop behaviour.
+        """
+        return {
+            "velocity_integral": self._i_vel.copy(),
+            "position_integral": self._i_pos.copy(),
+            "attitude_integral": self._i_att.copy(),
+            "last_force": self._last_force.copy(),
+        }
+
+    def step(self, setpoint: HeavySetpoint, state: HeavyState,
+             dt: float) -> np.ndarray:
+        g = self.gains
+        error_world = np.asarray(setpoint.position, float) - np.asarray(state.position, float)
+
+        # --- OUTER loop: position error -> desired world velocity ----------
+        # Structural fix. The previous controller scaled the position ERROR by a
+        # per-tick distance, which capped the force rather than the speed and
+        # collapsed every command beyond a few centimetres to ~0.4 N.
+        desired_world = np.array(
+            [g.kp_pos_xy * error_world[0] + g.ki_pos_xy * self._i_pos[0],
+             g.kp_pos_xy * error_world[1] + g.ki_pos_xy * self._i_pos[1],
+             g.kp_pos_z * error_world[2] + g.ki_pos_z * self._i_pos[2]])
+        horizontal_raw = float(np.linalg.norm(desired_world[:2]))
+        # Anti-windup: integrate position only when the speed command is not
+        # already saturated, so a long transit does not wind up the outer loop.
+        if horizontal_raw <= g.max_speed_mps:
+            self._i_pos = np.clip(self._i_pos + error_world * dt,
+                                  -g.integral_limit, g.integral_limit)
+        horizontal = float(np.linalg.norm(desired_world[:2]))
+        if horizontal > g.max_speed_mps:
+            desired_world[:2] *= g.max_speed_mps / horizontal
+        desired_world[2] = float(np.clip(desired_world[2],
+                                         -g.max_vertical_speed_mps,
+                                         g.max_vertical_speed_mps))
+
+        c, s_ = math.cos(state.yaw), math.sin(state.yaw)
+        desired_body = np.array([c * desired_world[0] + s_ * desired_world[1],
+                                 -s_ * desired_world[0] + c * desired_world[1],
+                                 desired_world[2]])
+
+        # --- INNER loop: velocity error -> force ---------------------------
+        v = np.asarray(state.velocity_body, float)
+        error_v = desired_body - v
+        raw = np.array([g.kv_xy * error_v[0] + g.ki_v_xy * self._i_vel[0],
+                        g.kv_xy * error_v[1] + g.ki_v_xy * self._i_vel[1],
+                        g.kv_z * error_v[2] + g.ki_v_z * self._i_vel[2]])
+
+        # Force magnitude limit, then slew limit.
+        magnitude = float(np.linalg.norm(raw))
+        limited = raw * (g.max_force_N / magnitude) if magnitude > g.max_force_N else raw
+        delta = limited - self._last_force
+        max_delta = g.max_force_rate_N_per_s * max(dt, 1e-6)
+        step = float(np.linalg.norm(delta))
+        if step > max_delta:
+            limited = self._last_force + delta * (max_delta / step)
+        self._last_force = limited
+
+        # Anti-windup: integrate the velocity error only while the force
+        # command is not being clipped, so a long transit cannot wind it up.
+        if magnitude <= g.max_force_N:
+            self._i_vel = np.clip(self._i_vel + error_v * dt,
+                                  -g.integral_limit, g.integral_limit)
+
+        fx, fy, fz = (float(x) for x in limited)
+
+        p, q, r = (float(x) for x in np.asarray(state.angular_rate, float))
+        e_att = np.array([_wrap(setpoint.roll - state.roll),
+                          _wrap(setpoint.pitch - state.pitch),
+                          _wrap(setpoint.yaw - state.yaw)])
+        self._i_att = np.clip(self._i_att + e_att * dt,
+                              -g.integral_limit, g.integral_limit)
+        mx = g.kp_roll * e_att[0] + g.ki_att * self._i_att[0] - g.kd_roll * p
+        my = g.kp_pitch * e_att[1] + g.ki_att * self._i_att[1] - g.kd_pitch * q
+        mz = g.kp_yaw * e_att[2] + g.ki_att * self._i_att[2] - g.kd_yaw * r
+        return np.array([fx, fy, fz, mx, my, mz], dtype=float)
