+"""Docking outcome and failure classification.
+
+Given one run's telemetry, decide whether the vehicle docked and -- if not --
+attribute the failure to a mechanism rather than to a symptom. Pure numpy, so it
+is unit-testable without a simulator.
+
+**The thresholds are an experiment's choice and are not defaulted to silently.**
+``DockingThresholds`` carries platform-sane values derived from the docking
+geometry, but a study that reports outcomes should construct its own instance,
+declare it, and freeze it before running anything. Adjusting a threshold in
+response to results is how a null result becomes a positive one by accident.
+"""
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass, field
+
+import numpy as np
+
+from .geometry import platform_geometry, wrap_angle
+
+__all__ = ["DockingThresholds", "Thresholds", "ZONES", "classify",
+           "TrialOutcome", "zone_of"]
+
+
+@dataclass(frozen=True)
+class DockingThresholds:
+    """Capture criteria, abort rules and failure-attribution constants.
+
+    Defaults are the platform's geometric ones: ``radial_capture_m`` is the
+    collar inner radius less the hull half-diagonal, rounded down -- the largest
+    lateral error at which capture is still geometrically possible.
+    """
+    # --- capture ---
+    collar_plane_x_m: float = 0.00
+    radial_capture_m: float = 0.065
+    heading_capture_rad: float = math.radians(10.0)
+    contact_speed_max_mps: float = 0.30
+    # --- aborts ---
+    timeout_s: float = 60.0
+    diverge_margin_m: float = 1.0
+    envelope_lateral_m: float = 3.0
+    envelope_vertical_m: float = 3.0
+    hard_collision_x_m: float = -0.10
+    impulse_drop_mps: float = 0.25
+    impulse_window_s: float = 0.10
+    # --- failure attribution ---
+    perception_lost_m: float = 1.5
+    perception_lost_s: float = 1.0
+    range_error_m: float = 0.30
+    unstable_y_std_m: float = 0.10
+    unstable_window_s: float = 1.0
+    saturation_fraction: float = 0.50
+    timeout_range_m: float = 0.5
+
+    @classmethod
+    def from_geometry(cls, geometry=None, **overrides):
+        """Capture radius taken from the platform, not chosen by hand."""
+        g = geometry or platform_geometry()
+        base = {"radial_capture_m": math.floor(g.radial_clearance_m * 1000) / 1000}
+        base.update(overrides)
+        return cls(**base)
+
+
+#: Backwards-compatible alias.
+Thresholds = DockingThresholds
+
+#: Range zones a docking approach is read out in.
+ZONES = {"near": (0.0, 1.5), "mid": (1.5, 3.5), "far": (3.5, 1e9)}
+
+
+def zone_of(range_m: float) -> str:
+    for name, (low, high) in ZONES.items():
+        if low <= range_m < high:
+            return name
+    return "far"
+
+
+@dataclass
+class TrialOutcome:
+    docked: bool
+    label: str
+    detail: dict = field(default_factory=dict)
+
+
+def _wrap(angle):
+    return wrap_angle(angle)
+
+
+def classify(t, truth_rel, est_xy, speed_axis, saturated,
+             thresholds: Thresholds | None = None) -> TrialOutcome:
+    """Classify one trial from its per-tick telemetry.
+
+    ``truth_rel``   (n, 4) ground-truth dock-relative x, y, z, psi
+    ``est_xy``      (n, 2) estimated dock-relative x, y (NaN rows for the oracle)
+    ``speed_axis``  (n,)   speed along the dock approach axis, positive inbound
+    ``saturated``   (n,)   bool, allocator saturation flag
+    """
+    th = thresholds or Thresholds()
+    t = np.asarray(t, float)
+    truth_rel = np.asarray(truth_rel, float)
+    est_xy = np.asarray(est_xy, float)
+    speed_axis = np.asarray(speed_axis, float)
+    saturated = np.asarray(saturated, bool)
+
+    x, y, z, psi = truth_rel.T
+    radial = np.hypot(y, z)
+    rng = np.linalg.norm(truth_rel[:, :3], axis=1)
+    detail: dict = {
+        "min_range_m": float(rng.min()),
+        "terminal_range_m": float(rng[-1]),
+        "min_radial_m": float(radial.min()),
+        "duration_s": float(t[-1] - t[0]),
+    }
+
+    # --- hard collision: behind the collar, or an impulsive stop close in ---
+    behind = x < th.hard_collision_x_m
+    impulse = np.zeros_like(speed_axis, bool)
+    for i in range(1, len(t)):
+        window = (t >= t[i] - th.impulse_window_s) & (t <= t[i])
+        if window.sum() >= 2 and rng[i] < 1.0:
+            drop = speed_axis[window].max() - speed_axis[i]
+            impulse[i] = drop > th.impulse_drop_mps
+    collided = bool(behind.any() or impulse.any())
+    detail["collision_events"] = int(behind.sum() + impulse.sum())
+
+    # --- capture test at the first crossing of the collar plane ---
+    crossed = np.flatnonzero(x <= th.collar_plane_x_m)
+    if crossed.size:
+        k = int(crossed[0])
+        detail.update(crossing_index=k, crossing_radial_m=float(radial[k]),
+                      crossing_yaw_deg=float(math.degrees(abs(_wrap(psi[k])))),
+                      crossing_speed_mps=float(abs(speed_axis[k])),
+                      terminal_lateral_m=float(abs(y[k])),
+                      terminal_vertical_m=float(abs(z[k])))
+        geometric = radial[k] <= th.radial_capture_m
+        heading = abs(_wrap(psi[k])) <= th.heading_capture_rad
+        speed_ok = abs(speed_axis[k]) <= th.contact_speed_max_mps
+        prior_collision = bool(behind[:k].any() or impulse[:k].any())
+        if geometric and heading and speed_ok and not prior_collision:
+            return TrialOutcome(True, "DOCKED", detail)
+        if not geometric:
+            return TrialOutcome(False, "LATERAL_ERROR", detail)
+        if prior_collision:
+            return TrialOutcome(False, "COLLISION", detail)
+        return TrialOutcome(False, "GEOMETRIC_CAPTURE_FAILURE", detail)
+
+    # --- never reached the collar plane: attribute the failure ---
+    if collided:
+        return TrialOutcome(False, "COLLISION", detail)
+
+    if np.abs(y).max() > th.envelope_lateral_m or np.abs(z).max() > th.envelope_vertical_m:
+        return TrialOutcome(False, "OUT_OF_ENVELOPE", detail)
+
+    if rng.max() > rng[0] + th.diverge_margin_m:
+        return TrialOutcome(False, "DIVERGED", detail)
+
+    # perception-specific attributions need an estimate to have existed
+    has_est = est_xy.size and np.isfinite(est_xy).any()
+    if has_est:
+        est_rng = np.hypot(est_xy[:, 0], est_xy[:, 1])
+        truth_rng_xy = np.hypot(x, y)
+        gap = np.abs(est_rng - truth_rng_xy)
+        bad = np.isfinite(gap) & (gap > th.perception_lost_m)
+        if bad.any() and _longest_run_seconds(t, bad) > th.perception_lost_s:
+            detail["max_estimate_gap_m"] = float(np.nanmax(gap))
+            return TrialOutcome(False, "PERCEPTION_LOST_DOCK", detail)
+
+        near = rng < ZONES["near"][1]
+        if near.sum() >= 3:
+            tail = near & (t >= t[near][-1] - th.unstable_window_s)
+            if tail.sum() >= 3:
+                spread = float(np.nanstd(est_xy[tail, 1]))
+                detail["terminal_estimate_y_std_m"] = spread
+                if spread > th.unstable_y_std_m:
+                    return TrialOutcome(False, "UNSTABLE_TERMINAL_ESTIMATE", detail)
+
+    near = rng < ZONES["near"][1]
+    if near.sum() and saturated[near].mean() > th.saturation_fraction:
+        detail["near_saturation_fraction"] = float(saturated[near].mean())
+        return TrialOutcome(False, "CONTROLLER_SATURATION", detail)
+
+    if abs(x).min() > th.range_error_m and rng.min() > th.range_error_m:
+        detail["closest_x_m"] = float(np.abs(x).min())
+        return TrialOutcome(False, "RANGE_ERROR", detail)
+
+    if rng[-1] > th.timeout_range_m:
+        return TrialOutcome(False, "TIMEOUT", detail)
+    return TrialOutcome(False, "TIMEOUT", detail)
+
+
+def _longest_run_seconds(t, mask) -> float:
+    best = run_start = None
+    longest = 0.0
+    for i, flag in enumerate(mask):
+        if flag and run_start is None:
+            run_start = t[i]
+        elif not flag and run_start is not None:
+            longest = max(longest, t[i - 1] - run_start)
+            run_start = None
+    if run_start is not None:
+        longest = max(longest, t[-1] - run_start)
+    return float(longest)
diff --git a/src/uuv_sim_physics/uuv_sim_physics/docking/providers.py b/src/uuv_sim_physics/uuv_sim_physics/docking/providers.py
new file mode 100644
index 00000000..6178114b
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/docking/providers.py
@@ -0,0 +1,134 @@
+"""Perception providers the platform ships with.
+
+Each implements ``PerceptionProvider``: measurable state in, dock-relative
+estimate out. A study supplies its own provider for whatever it is studying;
+these cover the cases every docking experiment needs anyway -- a reference
+ceiling, a geometry-only estimator, and the handover composition of the two.
+"""
+from __future__ import annotations
+
+import math
+
+import numpy as np
+
+from .fls_range import FLSRangeConfig, FLSRangeEstimator
+from .geometry import platform_geometry
+from .interfaces import DockRelativeEstimate, Observation
+from .terminal_estimator import TerminalConfig, TerminalEstimator
+
+__all__ = ["OracleProvider", "TerminalNavigationProvider", "HandoverProvider"]
+
+
+class OracleProvider:
+    """Reference ceiling: the true dock-relative position, supplied externally.
+
+    **This is the one provider that is deliberately privileged**, and it is the
+    reason the runner keeps truth out of ``Observation``: an oracle must be an
+    explicit, named condition rather than something a provider can reach for.
+    The runner passes truth through ``obs.extras['oracle_xy']`` only when the
+    caller has selected this provider by name.
+    """
+
+    name = "oracle"
+
+    def reset(self) -> None:
+        pass
+
+    def estimate(self, obs: Observation) -> DockRelativeEstimate:
+        xy = obs.extras.get("oracle_xy")
+        if xy is None:
+            raise RuntimeError(
+                "OracleProvider requires the runner to supply 'oracle_xy'; it is "
+                "only provided when the oracle condition is explicitly selected")
+        return DockRelativeEstimate(float(xy[0]), float(xy[1]), source="oracle")
+
+
+class TerminalNavigationProvider:
+    """Geometry and kinematics only, from a seeded initial estimate.
+
+    Useful on its own for a docking run that has some other means of getting
+    close, and used by ``HandoverProvider`` for the terminal phase.
+    """
+
+    name = "terminal"
+
+    def __init__(self, config: TerminalConfig | None = None, geometry=None,
+                 fls_config: FLSRangeConfig | None = None) -> None:
+        self.geometry = geometry or platform_geometry()
+        self.estimator = TerminalEstimator(config, self.geometry)
+        self.fls = FLSRangeEstimator(fls_config, self.geometry)
+        self._seeded = False
+
+    def reset(self) -> None:
+        self.estimator.reset()
+        self.fls.reset()
+        self._seeded = False
+
+    def seed(self, estimate, obs: Observation) -> None:
+        self.estimator.initialise(
+            [estimate.x, estimate.y, estimate.z, estimate.yaw_error],
+            self.geometry.dock.dock_depth_m, obs.depth_measured)
+        self._seeded = True
+
+    @property
+    def seeded(self) -> bool:
+        return self._seeded
+
+    def estimate(self, obs: Observation) -> DockRelativeEstimate:
+        if not self._seeded:
+            raise RuntimeError("seed() must be called before estimate()")
+        scan = np.where(obs.fls_valid, obs.fls_range, np.inf)
+        fix = self.fls.estimate(scan)
+        state = self.estimator.step(
+            velocity_body=obs.velocity_body, yaw_absolute=obs.yaw_absolute,
+            approach_yaw=self.geometry.dock.approach_yaw_rad, dt=obs.dt_s,
+            depth_measured=obs.depth_measured,
+            dock_z_world=self.geometry.dock.dock_depth_m,
+            fls_range_estimate=fix.vehicle_x_m, yaw_rate=obs.yaw_rate)
+        return DockRelativeEstimate(state.x, state.y, state.z, state.yaw_error,
+                                    source="terminal")
+
+
+class HandoverProvider:
+    """Run a primary provider until it reports a chosen range, then hand over.
+
+    After handover the primary is **not queried again**, so "the terminal phase
+    does not use the primary" is a property of the control flow rather than a
+    claim about it.
+
+    ``handover_range_m`` is the caller's choice: it is an experimental design
+    decision, not a platform constant, so it has no default here.
+    """
+
+    name = "handover"
+
+    def __init__(self, primary, terminal: TerminalNavigationProvider,
+                 handover_range_m: float) -> None:
+        self.primary = primary
+        self.terminal = terminal
+        self.handover_range_m = float(handover_range_m)
+        self.handover = None
+
+    def reset(self) -> None:
+        self.primary.reset()
+        self.terminal.reset()
+        self.handover = None
+
+    def estimate(self, obs: Observation) -> DockRelativeEstimate:
+        if self.terminal.seeded:
+            return self.terminal.estimate(obs)
+
+        estimate = self.primary.estimate(obs)
+        # Handover is decided on the ESTIMATED range, because in closed loop
+        # that is the only range the vehicle has.
+        if estimate.horizontal_range_m <= self.handover_range_m:
+            self.terminal.seed(estimate, obs)
+            self.handover = {
+                "t_s": obs.t_s,
+                "estimated_range_m": estimate.horizontal_range_m,
+                "estimated_xy": [estimate.x, estimate.y],
+            }
+            state = self.terminal.estimator.state
+            return DockRelativeEstimate(state.x, state.y, state.z,
+                                        state.yaw_error, source="terminal")
+        return estimate
diff --git a/src/uuv_sim_physics/uuv_sim_physics/docking/rich_environment.py b/src/uuv_sim_physics/uuv_sim_physics/docking/rich_environment.py
new file mode 100644
index 00000000..75b189e3
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/docking/rich_environment.py
@@ -0,0 +1,94 @@
+"""Compose the validated Heavy/dock world with reusable rich scenery.
+
+The Heavy plant, dock and scientific sensors come from ``world_builder``.  This
+module imports only environmental models from the existing interactive survey
+world; it never substitutes that world's kinematic vehicle, seabed or beacon.
+"""
+from __future__ import annotations
+
+import copy
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+EXCLUDED_MODELS = frozenset({"seabed", "bluerov2", "acoustic_beacon"})
+# These five primitives belong to the controlled physics qualification scene.
+# They are not part of the interactive survey environment and must never leak
+# into the final rich-world composition.
+CONTROLLED_FIXTURES = frozenset({"rock_a", "rock_b", "rock_c", "rock_d", "rock_e"})
+# Gazebo's custom sensor extensions are namespaced. Keep the canonical prefix
+# when ElementTree serializes the composed document; some sdformat extension
+# handlers inspect the qualified spelling while constructing custom sensors.
+ET.register_namespace("gz", "http://gazebosim.org/schema")
+
+
+def compose_rich_heavy_world(heavy_sdf: str, survey_world: Path,
+                             world_name: str | None = "rich_heavy_docking",
+                             static_scenery: bool = False,
+                             visual_only_scenery: bool = False,
+                             capture_station_source: Path | None = None) -> str:
+    """Return a Heavy world with the survey world's scenery added by name.
+
+    Existing Heavy entities always win.  The source vehicle, its navigation
+    beacon, and its seabed are excluded so plant and datum semantics remain the
+    validated Heavy definitions.
+    """
+    heavy_root = ET.fromstring(heavy_sdf)
+    heavy_world = heavy_root.find("world")
+    if heavy_world is None:
+        raise ValueError("Heavy SDF has no world")
+    survey = ET.parse(survey_world).getroot().find("world")
+    if survey is None:
+        raise ValueError("survey SDF has no world")
+    # Remove qualification-only primitives from the Heavy source. The source
+    # itself remains immutable; only this final, generated composition changes.
+    for model in list(heavy_world.findall("model")):
+        if model.get("name") in CONTROLLED_FIXTURES:
+            heavy_world.remove(model)
+    existing = {m.get("name") for m in heavy_world.findall("model")}
+    added = 0
+    for model in survey.findall("model"):
+        name = model.get("name")
+        if not name or name in EXCLUDED_MODELS or name in existing:
+            continue
+        imported = copy.deepcopy(model)
+        if static_scenery:
+            # Dataset capture needs the same meshes/poses but no animated
+            # scenery. Removing velocity plugins keeps the paused lockstep
+            # contract authoritative and cannot change the Heavy plant.
+            static = imported.find("static")
+            if static is None:
+                static = ET.Element("static")
+                imported.insert(0, static)
+            static.text = "true"
+            for plugin in list(imported.findall("plugin")):
+                imported.remove(plugin)
+        if visual_only_scenery:
+            # Imported scenery is not part of the qualified Heavy collision or
+            # DVL geometry. Its mesh collisions make the 40 Hz DVL ray scene
+            # miss the deterministic delivery barrier. The Heavy seabed, dock
+            # and vehicle collision geometry remain authoritative.
+            for link in imported.findall("link"):
+                for collision in list(link.findall("collision")):
+                    link.remove(collision)
+        heavy_world.append(imported)
+        existing.add(name)
+        added += 1
+    if capture_station_source is not None:
+        source_world = ET.parse(capture_station_source).getroot().find("world")
+        if source_world is None:
+            raise ValueError("capture-station source SDF has no world")
+        grabbers = [m for m in source_world.findall("model")
+                    if m.get("name") == "dock_grabber"]
+        if len(grabbers) != 1:
+            raise ValueError("capture-station source must contain one dock_grabber")
+        if "dock_grabber" in existing:
+            raise ValueError("duplicate dock_grabber in rich composition")
+        # Import exactly the reusable capture-station visual/servo assembly,
+        # never any other entity from the historical source world.
+        heavy_world.append(copy.deepcopy(grabbers[0]))
+        existing.add("dock_grabber")
+    if added < 50:
+        raise ValueError(f"rich environment unexpectedly sparse: {added} models")
+    if world_name is not None:
+        heavy_world.set("name", world_name)
+    return ET.tostring(heavy_root, encoding="unicode", xml_declaration=True)
diff --git a/src/uuv_sim_physics/uuv_sim_physics/docking/runner.py b/src/uuv_sim_physics/uuv_sim_physics/docking/runner.py
new file mode 100644
index 00000000..7d319687
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/docking/runner.py
@@ -0,0 +1,390 @@
+"""The docking runner: launch, sense, control, record, classify.
+
+This is the platform's reusable autonomous-docking execution capability. It owns
+everything that is true of *any* docking run:
+
+* build a per-run world variant at the requested spawn pose and launch the
+  simulator, with or without a GUI;
+* subscribe to the vehicle's camera, sonar, IMU and DVL on the topics the
+  configuration declares;
+* let the vehicle settle, then drive a fixed-rate control loop through the
+  simulator's own controller and thrust allocator;
+* ask a :class:`~.interfaces.PerceptionProvider` where the dock is, once per tick;
+* record telemetry and classify the outcome.
+
+It owns none of what makes a run an *experiment*: which provider, which
+thresholds, which turbidity, which seeds. Those are arguments.
+
+Privileged state
+----------------
+Ground truth is subscribed to, because a docking run has to be scored and the
+outcome classifier needs it. It goes into telemetry and into the classifier, and
+it is **never** placed in the ``Observation`` handed to a provider. The single
+exception is explicit and named: when the caller selects the oracle condition,
+the runner puts the true horizontal position in ``extras['oracle_xy']``. That is
+a declared reference condition, not a back channel -- ``oracle_extras`` defaults
+to ``False`` and a provider that has not been given it cannot ask for it.
+"""
+from __future__ import annotations
+
+import math
+import os
+import re
+import subprocess
+import tempfile
+import time
+from dataclasses import dataclass, field
+from pathlib import Path
+
+import numpy as np
+
+from .camera import downsample
+from .geometry import platform_geometry, wrap_angle, yaw_from_quaternion
+from .interfaces import Observation
+from .outcome import DockingThresholds, classify, zone_of
+from .standoff import StandoffPolicy, StandoffTracker
+from .world_variants import variant_for
+
+__all__ = ["DockingRunConfig", "DockingRunRecord", "run_docking"]
+
+
+@dataclass
+class DockingRunConfig:
+    """Everything a single docking run needs that is not the provider."""
+    run_id: str
+    start_pose_world: list
+    #: Water condition passed through to the provider; the platform does not
+    #: interpret it.
+    turbidity_c: float = 0.0
+    seed: int = 1
+    horizon_s: float = 60.0
+    settle_s: float = 3.0
+    control_hz: float = 10.0
+    gui: bool = False
+    #: Standard deviation of the declared depth channel. The simulator exposes
+    #: no pressure sensor, so depth is a surrogate: true z plus this noise. It
+    #: is labelled as such in every record it appears in.
+    depth_sigma_m: float = 0.02
+    #: Downsampled camera size handed to the provider, (height, width).
+    camera_size: tuple = (120, 160)
+    #: Give the provider the true horizontal position. Only for the declared
+    #: oracle reference condition.
+    oracle_extras: bool = False
+    standoff_policy: StandoffPolicy = field(default_factory=StandoffPolicy)
+    thresholds: DockingThresholds = field(default_factory=DockingThresholds)
+
+
+@dataclass
+class DockingRunRecord:
+    config: dict
+    outcome: str
+    docked: bool
+    detail: dict
+    telemetry: dict = field(default_factory=dict)
+    diagnostics: dict = field(default_factory=dict)
+
+
+def run_docking(config: DockingRunConfig, provider, *,
+                geometry=None) -> DockingRunRecord:
+    """Execute one docking run and return its record."""
+    g = geometry or platform_geometry()
+    th = config.thresholds
+    from .. import toolchain, world_builder
+    from ..control import Allocator, Controller, Gains, Reference
+    from ..control.controller import State
+
+    from gz.msgs10.double_pb2 import Double
+    from gz.msgs10.dvl_velocity_tracking_pb2 import DVLVelocityTracking
+    from gz.msgs10.image_pb2 import Image
+    from gz.msgs10.imu_pb2 import IMU
+    from gz.msgs10.laserscan_pb2 import LaserScan
+    from gz.msgs10.pose_v_pb2 import Pose_V
+    from gz.transport13 import Node
+
+    scratch = Path(tempfile.mkdtemp(prefix=f"dock_{config.run_id}_"))
+    world_path = variant_for(config.start_pose_world,
+                             world_builder.VALIDATED_WORLD_PATH, scratch)
+    world_name = re.search(r'<world name="([^"]+)"',
+                           world_path.read_text()).group(1)
+    spawn_yaw = float(config.start_pose_world[5])
+    cam_h, cam_w = config.camera_size
+
+    camera: list = []
+    fls: list = []
+    truth: list = []
+    imu: list = []
+    dvl: list = []
+
+    def stamp(header):
+        return header.stamp.sec + header.stamp.nsec * 1e-9
+
+    def on_camera(msg):
+        buf = np.frombuffer(msg.data, dtype=np.uint8)
+        want = msg.height * msg.width * 3
+        if buf.size >= want:
+            camera.append((stamp(msg.header),
+                           downsample(buf[:want].reshape(msg.height, msg.width, 3),
+                                      cam_h, cam_w)))
+            if len(camera) > 6:
+                del camera[:-6]
+
+    def on_fls(msg):
+        fls.append((stamp(msg.header), np.array(msg.ranges, dtype=np.float32)))
+        if len(fls) > 6:
+            del fls[:-6]
+
+    def on_imu(msg):
+        o = msg.orientation
+        imu.append((stamp(msg.header), yaw_from_quaternion((o.w, o.x, o.y, o.z)),
+                    float(msg.angular_velocity.z)))
+        if len(imu) > 40:
+            del imu[:-40]
+
+    def on_dvl(msg):
+        v = msg.velocity.mean
+        dvl.append((stamp(msg.header), np.array([v.x, v.y, v.z], dtype=float)))
+        if len(dvl) > 20:
+            del dvl[:-20]
+
+    def on_pose(msg):
+        moment = stamp(msg.header)
+        for pose in msg.pose:
+            if pose.name == "bluerov2_phys":
+                truth.append((moment,
+                              np.array([pose.position.x, pose.position.y,
+                                        pose.position.z]),
+                              np.array([pose.orientation.w, pose.orientation.x,
+                                        pose.orientation.y, pose.orientation.z])))
+                if len(truth) > 400:
+                    del truth[:-400]
+
+    env = os.environ.copy()
+    args = [str(toolchain.GZ_EXECUTABLE), "sim", "-r", "-v", "0"]
+    if not config.gui:
+        args.append("-s")
+    args.append(str(world_path))
+    server = subprocess.Popen(args, stdout=subprocess.DEVNULL,
+                              stderr=subprocess.DEVNULL, env=env)
+
+    rng = np.random.default_rng(config.seed)
+    standoff_tracker = StandoffTracker(config.standoff_policy, g)
+    standoff_sources: list[str] = []
+    rows: list[dict] = []
+    diagnostics: dict = {
+        "provider": getattr(provider, "name", type(provider).__name__),
+        "velocity_source": "dvl",
+        "depth_source": "pressure_surrogate_ground_truth_plus_noise",
+        "yaw_source": "imu_plus_spawn_offset",
+        "world": world_path.name,
+    }
+    stop_reason = "horizon"
+    provider.reset()
+
+    try:
+        node = Node()
+        deadline = time.time() + 90.0
+        for message_type, topic, callback in (
+                (Image, g.topics["camera"], on_camera),
+                (LaserScan, g.topics["fls"], on_fls),
+                (IMU, g.topics["imu"], on_imu),
+                (DVLVelocityTracking, g.topics["dvl"], on_dvl),
+                (Pose_V, f"/world/{world_name}/dynamic_pose/info", on_pose)):
+            while not node.subscribe(message_type, topic, callback):
+                if time.time() > deadline:
+                    raise RuntimeError(f"could not subscribe to {topic}")
+                time.sleep(0.3)
+
+        joints = ("prop_left_joint", "prop_right_joint",
+                  "prop_sway_joint", "prop_vert_joint")
+        publishers = {j: node.advertise(
+            f"/model/bluerov2_phys/joint/{j}/cmd_thrust", Double) for j in joints}
+        while not all(p.valid() for p in publishers.values()):
+            if time.time() > deadline:
+                raise RuntimeError("thruster publishers never became valid")
+            time.sleep(0.2)
+
+        while not truth:
+            if time.time() > deadline:
+                raise RuntimeError("no pose messages received")
+            time.sleep(0.2)
+        start = truth[-1][0]
+        while truth[-1][0] - start < config.settle_s:
+            time.sleep(0.05)
+
+        sim_config = world_builder.load_config(validated=True)
+        controller = Controller(Gains())
+        allocator = Allocator(sim_config)
+        reference = Reference(waypoint_xy=(0.0, 0.0),
+                              depth_m=g.dock.dock_depth_m,
+                              heading_rad=g.dock.approach_yaw_rad)
+        message = Double()
+        zero = truth[-1][0]
+        last = zero
+        initial_range = None
+
+        while True:
+            if not truth:
+                time.sleep(0.005)
+                continue
+            now = truth[-1][0]
+            elapsed = now - zero
+            if elapsed >= config.horizon_s:
+                stop_reason = "timeout"
+                break
+            dt = now - last
+            if dt < 1.0 / config.control_hz:
+                time.sleep(0.002)
+                continue
+            last = now
+
+            _, position_true, quat_true = truth[-1]
+            rel_true = position_true - g.dock.origin_world
+            yaw_true = yaw_from_quaternion(quat_true)
+            psi_true = float(wrap_angle(yaw_true - g.dock.approach_yaw_rad))
+            range_true = float(np.linalg.norm(rel_true))
+            if initial_range is None:
+                initial_range = range_true
+
+            # --- heading and rate: measured IMU, composed with the known spawn
+            # attitude, because the IMU reports yaw relative to where it started.
+            if imu:
+                yaw_est = float(wrap_angle(spawn_yaw + imu[-1][1]))
+                yaw_rate_est = imu[-1][2]
+            else:
+                yaw_est, yaw_rate_est = yaw_true, 0.0
+                diagnostics["yaw_source"] = "imu_absent_fell_back_to_truth"
+
+            if dvl:
+                velocity_body = dvl[-1][1].copy()
+            else:
+                velocity_body = np.zeros(3)
+                diagnostics["velocity_source"] = "dvl_absent_zero"
+
+            # --- depth: declared surrogate, identical for every provider ---
+            z_meas = float(position_true[2] + rng.normal(0.0, config.depth_sigma_m))
+
+            if not camera or not fls:
+                time.sleep(0.005)
+                continue
+            ranges = fls[-1][1]
+            if ranges.shape[0] != g.sonar.rays:
+                time.sleep(0.005)
+                continue
+            valid = np.isfinite(ranges)
+            reading = standoff_tracker.update(
+                np.where(valid, ranges, np.inf),
+                surge_mps=float(velocity_body[0]), dt=dt)
+            standoff_sources.append(reading.source)
+
+            extras = {"standoff_m": reading.standoff_m,
+                      "standoff_source": reading.source}
+            if config.oracle_extras:
+                extras["oracle_xy"] = rel_true[:2].copy()
+
+            observation = Observation(
+                t_s=elapsed, dt_s=dt, camera=camera[-1][1],
+                fls_range=np.where(valid, ranges, np.inf).astype(np.float32),
+                fls_valid=valid, velocity_body=velocity_body,
+                yaw_absolute=yaw_est, yaw_rate=yaw_rate_est,
+                depth_measured=z_meas, turbidity_c=config.turbidity_c,
+                extras=extras)
+            estimate = provider.estimate(observation)
+            xy = estimate.xy()
+
+            state = State(position=np.array([xy[0], xy[1], z_meas]),
+                          velocity_body=velocity_body,
+                          yaw=yaw_est, yaw_rate=yaw_rate_est)
+            wrench = controller.step(reference, state, dt)
+            thrusts, alloc_info = allocator(wrench)
+            # The allocator returns a dict; a truthiness test on the dict itself
+            # is always True, so the fields are read.
+            saturated_now = bool(alloc_info.get("saturated")) or \
+                bool(alloc_info.get("surge_scaled"))
+            for joint, newtons in thrusts.items():
+                message.data = float(newtons)
+                publishers[joint].publish(message)
+
+            sigma = (estimate.sigma.tolist() if estimate.sigma is not None
+                     else [float("nan")] * 4)
+            rows.append({
+                "t": elapsed,
+                "truth_rel": rel_true.tolist() + [psi_true],
+                "est_xy": [float(xy[0]), float(xy[1])],
+                "est_pose": [estimate.x, estimate.y, estimate.z,
+                             estimate.yaw_error],
+                "est_sigma": sigma,
+                "yaw_est": yaw_est, "yaw_true": yaw_true,
+                "z_meas": z_meas, "z_true": float(position_true[2]),
+                "velocity_body": velocity_body.tolist(),
+                "speed_axis": float(velocity_body[0]),
+                "saturated": saturated_now,
+                "zone": zone_of(range_true),
+                "range_true": range_true,
+                "estimate_source": estimate.source,
+            })
+
+            if range_true > initial_range + th.diverge_margin_m:
+                stop_reason = "diverged"
+                break
+            if (abs(rel_true[1]) > th.envelope_lateral_m
+                    or abs(rel_true[2]) > th.envelope_vertical_m):
+                stop_reason = "out_of_envelope"
+                break
+            if rel_true[0] <= th.collar_plane_x_m:
+                stop_reason = "crossed_collar_plane"
+                break
+
+        message.data = 0.0
+        for publisher in publishers.values():
+            publisher.publish(message)
+    finally:
+        server.terminate()
+        try:
+            server.wait(timeout=10)
+        except subprocess.TimeoutExpired:                      # pragma: no cover
+            server.kill()
+
+    diagnostics["stop_reason"] = stop_reason
+    if standoff_sources:
+        from collections import Counter
+        diagnostics["standoff_sources"] = dict(Counter(standoff_sources))
+    if not rows:
+        return DockingRunRecord(config.__dict__, "NO_DATA", False,
+                                {"reason": "no control ticks executed"},
+                                diagnostics=diagnostics)
+
+    t = np.array([r["t"] for r in rows])
+    truth_rel = np.array([r["truth_rel"] for r in rows])
+    est_xy = np.array([r["est_xy"] for r in rows])
+    speed_axis = np.array([r["speed_axis"] for r in rows])
+    saturated = np.array([r["saturated"] for r in rows], dtype=bool)
+    result = classify(t, truth_rel, est_xy, speed_axis, saturated, th)
+
+    yaw_err = np.degrees(np.abs([wrap_angle(r["yaw_est"] - r["yaw_true"])
+                                 for r in rows]))
+    diagnostics.update(
+        ticks=len(rows),
+        control_rate_hz=float(len(rows) / max(t[-1] - t[0], 1e-6)),
+        imu_yaw_error_deg_mean=float(yaw_err.mean()),
+        imu_yaw_error_deg_max=float(yaw_err.max()))
+    if getattr(provider, "handover", None):
+        diagnostics["handover"] = provider.handover
+
+    telemetry = {
+        "t": t.astype(np.float32),
+        "truth_rel": truth_rel.astype(np.float32),
+        "est_xy": est_xy.astype(np.float32),
+        "est_sigma": np.array([r["est_sigma"] for r in rows], dtype=np.float32),
+        "speed_axis": speed_axis.astype(np.float32),
+        "saturated": saturated,
+        "yaw_est": np.array([r["yaw_est"] for r in rows], dtype=np.float32),
+        "yaw_true": np.array([r["yaw_true"] for r in rows], dtype=np.float32),
+        "z_meas": np.array([r["z_meas"] for r in rows], dtype=np.float32),
+        "z_true": np.array([r["z_true"] for r in rows], dtype=np.float32),
+        "range_true": np.array([r["range_true"] for r in rows], dtype=np.float32),
+    }
+    return DockingRunRecord(
+        {k: (list(v) if isinstance(v, tuple) else v)
+         for k, v in config.__dict__.items() if not k.startswith("_")},
+        result.label, result.docked, result.detail,
+        telemetry=telemetry, diagnostics=diagnostics)
diff --git a/src/uuv_sim_physics/uuv_sim_physics/docking/standoff.py b/src/uuv_sim_physics/uuv_sim_physics/docking/standoff.py
new file mode 100644
index 00000000..575962a7
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/docking/standoff.py
@@ -0,0 +1,104 @@
+"""Scalar standoff to the structure, with explicit validity states.
+
+A forward-looking sonar gives an exact range while the target is inside its
+usable window and nothing at all once the target enters the blind zone. Anything
+that needs a continuous range -- an attenuation model, a gain schedule, a
+guidance law -- needs a policy for that gap, and the policy must be declared
+rather than improvised, because a silent fallback produces confident nonsense.
+
+Three states, always reported:
+
+* ``fls``            -- taken from the sonar;
+* ``dead_reckoned``  -- last valid value carried forward on measured surge;
+* ``never_acquired`` -- the sonar has never returned; the declared
+                        initialisation value is used and the reading is flagged.
+
+This module reads no privileged state. Its inputs are a sweep and a measured
+body-frame surge.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+
+from .geometry import platform_geometry
+
+__all__ = ["StandoffTracker", "StandoffPolicy", "StandoffReading"]
+
+#: Half-width, in rays, of the central sector the range is read from.
+CENTRE_HALF_WIDTH = 8
+
+
+@dataclass(frozen=True)
+class StandoffPolicy:
+    """How the gap is handled. Supply explicitly; defaults are platform-sane."""
+    #: Value used when the sonar has NEVER returned. Defaults to its maximum
+    #: range, which is the honest reading of "nothing out there".
+    never_acquired_m: float = 12.0
+    #: Floor, below which a standoff is not physically meaningful.
+    minimum_m: float = 0.05
+    #: How far dead reckoning is trusted past the last fix before the value is
+    #: held rather than extrapolated indefinitely.
+    max_dead_reckoned_m: float = 1.5
+
+
+@dataclass
+class StandoffReading:
+    standoff_m: float
+    source: str
+    dead_reckoned_m: float
+    ever_acquired: bool
+
+
+class StandoffTracker:
+    """Sonar standoff with dead reckoning across the blind zone."""
+
+    def __init__(self, policy: StandoffPolicy | None = None, geometry=None) -> None:
+        self.policy = policy or StandoffPolicy()
+        self._geometry = geometry or platform_geometry()
+        self._last_valid: float | None = None
+        self._dead_reckoned = 0.0
+
+    def reset(self) -> None:
+        self._last_valid = None
+        self._dead_reckoned = 0.0
+
+    def from_scan(self, scan: np.ndarray) -> float | None:
+        """Nearest valid return in the central sector."""
+        sonar = self._geometry.sonar
+        scan = np.asarray(scan, dtype=float)
+        if scan.shape[0] != sonar.rays:
+            return None
+        mid = sonar.rays // 2
+        centre = scan[mid - CENTRE_HALF_WIDTH: mid + CENTRE_HALF_WIDTH]
+        good = centre[np.isfinite(centre) & (centre > sonar.range_min_m)
+                      & (centre < sonar.range_max_m)]
+        return float(good.min()) if good.size else None
+
+    def update(self, scan, *, surge_mps: float = 0.0,
+               dt: float = 0.0) -> StandoffReading:
+        """Advance one tick.
+
+        ``surge_mps`` is measured body-x velocity. The sonar boresight lies along
+        body +x, so closing reduces the standoff at exactly the surge rate and no
+        rotation is needed for the scalar.
+        """
+        measured = self.from_scan(scan)
+        policy = self.policy
+
+        if measured is not None:
+            self._last_valid = measured
+            self._dead_reckoned = 0.0
+            return StandoffReading(max(measured, policy.minimum_m), "fls", 0.0, True)
+
+        if self._last_valid is None:
+            return StandoffReading(policy.never_acquired_m, "never_acquired",
+                                   0.0, False)
+
+        travel = float(surge_mps) * float(dt)
+        if abs(self._dead_reckoned) < policy.max_dead_reckoned_m:
+            self._last_valid -= travel
+            self._dead_reckoned += abs(travel)
+        value = max(self._last_valid, policy.minimum_m)
+        return StandoffReading(value, "dead_reckoned", self._dead_reckoned, True)
diff --git a/src/uuv_sim_physics/uuv_sim_physics/docking/state_providers.py b/src/uuv_sim_physics/uuv_sim_physics/docking/state_providers.py
new file mode 100644
index 00000000..35260f5d
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/docking/state_providers.py
@@ -0,0 +1,121 @@
+"""Hardware-realisable horizontal-state providers for the Heavy control path.
+
+``heavy_runtime`` had no operational horizontal position source at all: the
+truth harness is guarded and scoring-only, ``dvl_dead_reckoning`` was "not yet
+modelled", and ``camera_dock_relative`` required a perception model that was
+never wired in. That is why the P6_SCENARIO_C_v1.0.0 primary endpoint could not
+be produced, and it is what this module exists to close.
+
+ISOLATION BY CONSTRUCTION
+-------------------------
+A provider is handed a ``SensorObservation`` and nothing else. The dataclass has
+no field carrying the true pose, the true velocity or the dock's true relative
+position, so a provider has no route to truth however it is written. That is a
+stronger guarantee than a checker: there is nothing to check.
+
+The runtime builds the observation from subscribed sensor topics. Truth is read
+in ``run_heavy`` only for the depth SENSOR MODEL (which applies bias and noise)
+and for SCORING, exactly as before.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Protocol, runtime_checkable
+
+import numpy as np
+
+
+@dataclass
+class SensorObservation:
+    """Everything a provider may see. No truth, by construction.
+
+    Adding a truth field here is the single change that would break isolation,
+    which is why the mutation tests assert this class's field set.
+    """
+    t: float
+    dt: float
+    #: Latest camera frame as HxWx3 uint8, or None if no new frame.
+    image: np.ndarray | None = None
+    #: Attitude from the IMU/AHRS, radians.
+    roll: float = 0.0
+    pitch: float = 0.0
+    yaw: float = 0.0
+    #: Body angular rate from the gyro.
+    angular_rate: np.ndarray = field(default_factory=lambda: np.zeros(3))
+    #: Body linear acceleration from the accelerometer. A real IMU output, not
+    #: truth: it is what lets a stock-C0 vehicle dead-reckon through the
+    #: terminal blind region instead of freezing on a stale fix.
+    linear_acceleration: np.ndarray = field(default_factory=lambda: np.zeros(3))
+    #: Depth from the Bar30 SENSOR MODEL (bias + noise already applied).
+    depth_measured: float = 0.0
+    #: FLS ranges, metres, or None when the arm carries no FLS.
+    fls_ranges: np.ndarray | None = None
+    fls_acquisition_t: float | None = None
+    fls_angle_min: float = 0.0
+    fls_angle_max: float = 0.0
+    #: DVL body-frame velocity and per-beam lock, or None when absent.
+    dvl_velocity: np.ndarray | None = None
+    dvl_acquisition_t: float | None = None
+    dvl_beams_locked: int = 0
+    dvl_valid: bool = False
+
+
+@dataclass
+class ProviderEstimate:
+    """What a provider returns. ``xy`` is dock-relative horizontal position."""
+    xy: np.ndarray
+    valid: bool
+    #: Provider-specific diagnostics; logged, never fed back to control.
+    detail: dict = field(default_factory=dict)
+    #: FILTERED dock-relative horizontal velocity, when the provider estimates
+    #: one. The runtime otherwise differences the position signal, which is
+    #: wrong whenever the estimate updates irregularly: on a tick with no new
+    #: fix the difference is exactly zero (so the controller commands full
+    #: force) and on the next fix it is a large jump (so it commands a brake).
+    #: That chatter is what stalled the first closed-loop approach.
+    velocity_xy: np.ndarray | None = None
+    #: Guidance mode this estimate was produced in; logged for diagnosis.
+    mode: str = "" 
+
+
+@runtime_checkable
+class HorizontalStateProvider(Protocol):
+    """Supplies operational dock-relative horizontal position."""
+
+    #: Declared sensing this provider requires; checked against the arm world.
+    requires: tuple
+
+    #: Whether this could exist on hardware. A provider claiming False may not
+    #: fly an experimental arm.
+    hardware_realisable: bool
+
+    def reset(self, seed: int) -> None: ...
+
+    def update(self, obs: SensorObservation) -> ProviderEstimate: ...
+
+
+#: Fields a SensorObservation is permitted to carry. The mutation test compares
+#: against this, so widening the observation is a deliberate, visible act.
+PERMITTED_OBSERVATION_FIELDS = frozenset({
+    "t", "dt", "image", "roll", "pitch", "yaw", "angular_rate",
+    "linear_acceleration",
+    "depth_measured", "fls_ranges", "fls_acquisition_t", "fls_angle_min",
+    "fls_angle_max", "dvl_velocity", "dvl_acquisition_t",
+    "dvl_beams_locked", "dvl_valid",
+})
+
+#: Names that would indicate privileged state leaking into the observation.
+FORBIDDEN_OBSERVATION_HINTS = ("true", "truth", "gt_", "ground", "oracle",
+                               "actual_pos", "label")
+
+
+def assert_observation_is_truth_free() -> None:
+    """Structural gate: the observation carries no privileged field."""
+    names = set(SensorObservation.__dataclass_fields__)
+    extra = names - PERMITTED_OBSERVATION_FIELDS
+    if extra:
+        raise AssertionError(f"SensorObservation gained fields: {sorted(extra)}")
+    bad = [n for n in names
+           if any(h in n.lower() for h in FORBIDDEN_OBSERVATION_HINTS)]
+    if bad:
+        raise AssertionError(f"privileged-looking observation fields: {bad}")
diff --git a/src/uuv_sim_physics/uuv_sim_physics/docking/terminal_estimator.py b/src/uuv_sim_physics/uuv_sim_physics/docking/terminal_estimator.py
new file mode 100644
index 00000000..2df15484
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/docking/terminal_estimator.py
@@ -0,0 +1,138 @@
+"""Geometric/kinematic terminal relative-state estimator.
+
+A generic terminal-navigation primitive for the final stretch of a docking
+approach, where a forward-looking sonar goes blind and any range-dependent
+perception is at its least supported.
+
+**It consumes no privileged state.** Its inputs are measured body velocity,
+measured attitude, a declared depth channel, the raw sonar sweep, known dock
+geometry, and one externally supplied estimate at handover.
+
+Transparent trigonometry rather than a second learned model: the problem being
+solved is a lack of observability, and a model trained on the same gap inherits
+the same problem.
+
+State propagation
+-----------------
+At handover the dock-relative position is seeded from the supplied estimate.
+Thereafter it is dead-reckoned, with body-frame velocity rotated into the
+world/dock frame by measured yaw::
+
+    p_dock(k+1) = p_dock(k) + R(yaw_k) @ v_body_k * dt
+
+The dock frame is a pure translation of world, so no rotation of the dock frame
+is involved. Vertical state is taken from the depth channel directly rather than
+integrated, because an absolute measurement does not drift.
+
+Longitudinal correction
+-----------------------
+Dead reckoning drifts. Where the sonar still returns usable geometry the
+longitudinal range is corrected toward it, gated against dead reckoning so that
+a wild return cannot capture the filter.
+"""
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass, field
+
+import numpy as np
+
+from .geometry import platform_geometry, wrap_angle
+
+__all__ = ["TerminalEstimator", "TerminalConfig", "TerminalState"]
+
+
+@dataclass(frozen=True)
+class TerminalConfig:
+    """Behavioural knobs. The handover RANGE is an experiment's choice, not the
+    platform's, so it is supplied by the caller rather than assumed here."""
+    #: Dock-relative range at which control hands over to this estimator.
+    handover_range_m: float = 0.60
+    #: Weight given to a sonar longitudinal fix, per update. Low because the
+    #: measurement is sparse near the dock; dead reckoning carries the state.
+    fls_correction_gain: float = 0.35
+    #: Reject a fix disagreeing with dead reckoning by more than this; a wild
+    #: return is worse than no return.
+    fls_gate_m: float = 0.30
+    #: Depth is an absolute measurement, so it replaces rather than corrects.
+    use_depth_directly: bool = True
+
+
+@dataclass
+class TerminalState:
+    x: float
+    y: float
+    z: float
+    yaw_error: float
+    handed_over_at_m: float
+    ticks: int = 0
+    fls_fixes: int = 0
+    fls_rejected: int = 0
+    dead_reckoned_m: float = 0.0
+    history: list = field(default_factory=list)
+
+    def as_xy(self):
+        return np.array([self.x, self.y])
+
+
+class TerminalEstimator:
+    """Dead-reckoned dock-relative state with optional sonar longitudinal fixes."""
+
+    def __init__(self, config: TerminalConfig | None = None, geometry=None) -> None:
+        self.config = config or TerminalConfig()
+        self.geometry = geometry or platform_geometry()
+        self.state: TerminalState | None = None
+
+    def reset(self) -> None:
+        self.state = None
+
+    def should_hand_over(self, perception_range_m: float) -> bool:
+        return perception_range_m <= self.config.handover_range_m
+
+    def initialise(self, seed_pose, dock_z_world: float,
+                   depth_measured: float) -> TerminalState:
+        """Seed from the last accepted external estimate at handover."""
+        x, y = float(seed_pose[0]), float(seed_pose[1])
+        z = (depth_measured - dock_z_world if self.config.use_depth_directly
+             else float(seed_pose[2]))
+        self.state = TerminalState(
+            x=x, y=y, z=z, yaw_error=float(seed_pose[3]),
+            handed_over_at_m=float(math.hypot(x, y)))
+        return self.state
+
+    def step(self, *, velocity_body, yaw_absolute: float, approach_yaw: float | None = None,
+             dt: float, depth_measured: float, dock_z_world: float,
+             fls_range_estimate: float | None = None,
+             yaw_rate: float | None = None) -> TerminalState:
+        """Advance one control tick from measured quantities only."""
+        if self.state is None:
+            raise RuntimeError("initialise() must be called at handover")
+        if approach_yaw is None:
+            approach_yaw = self.geometry.dock.approach_yaw_rad
+        s = self.state
+        v = np.asarray(velocity_body, dtype=float)
+
+        c, sn = math.cos(yaw_absolute), math.sin(yaw_absolute)
+        vx_world = c * v[0] - sn * v[1]
+        vy_world = sn * v[0] + c * v[1]
+
+        s.x += vx_world * dt
+        s.y += vy_world * dt
+        s.dead_reckoned_m += float(math.hypot(vx_world, vy_world) * dt)
+
+        s.z = (depth_measured - dock_z_world if self.config.use_depth_directly
+               else s.z + v[2] * dt)
+
+        s.yaw_error = float(wrap_angle(yaw_absolute - approach_yaw))
+
+        if fls_range_estimate is not None and np.isfinite(fls_range_estimate):
+            residual = float(fls_range_estimate) - s.x
+            if abs(residual) <= self.config.fls_gate_m:
+                s.x += self.config.fls_correction_gain * residual
+                s.fls_fixes += 1
+            else:
+                s.fls_rejected += 1
+
+        s.ticks += 1
+        s.history.append((s.x, s.y, s.z, s.yaw_error))
+        return s
diff --git a/src/uuv_sim_physics/uuv_sim_physics/docking/world_variants.py b/src/uuv_sim_physics/uuv_sim_physics/docking/world_variants.py
new file mode 100644
index 00000000..349fc7eb
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/docking/world_variants.py
@@ -0,0 +1,65 @@
+"""Per-run world variants: the same validated world, a different spawn pose.
+
+The released world spawns the vehicle at one fixed pose, which is fine for
+validation and useless for a campaign that needs varied initial conditions.
+
+**This does not modify the packaged world.** The SDF is read, the vehicle's
+``<pose>`` is rewritten in memory, and the result is written to a caller-supplied
+directory. The existing ``world_builder.variant_world`` helper patches the
+package's configuration in place and restores it afterwards; that is retained
+unchanged for existing callers, but it means an interrupted run can leave the
+frozen tree modified, so anything that must not be able to damage the release
+uses this instead.
+"""
+from __future__ import annotations
+
+import hashlib
+import re
+from pathlib import Path
+
+__all__ = ["variant_for", "vehicle_pose_of"]
+
+_POSE_PATTERN = re.compile(
+    r'(<model name="bluerov2_phys">\s*\n\s*<pose>)([^<]*)(</pose>)')
+
+
+def vehicle_pose_of(sdf_text: str) -> list[float]:
+    match = _POSE_PATTERN.search(sdf_text)
+    if not match:                                            # pragma: no cover
+        raise ValueError("vehicle pose element not found in the world")
+    return [float(v) for v in match.group(2).split()]
+
+
+def variant_for(spawn_pose, base_world: Path, directory: Path) -> Path:
+    """Write a world identical to ``base_world`` but spawning at ``spawn_pose``.
+
+    ``spawn_pose`` is ``x y z roll pitch yaw``. The base world is never written
+    to; only the returned copy differs.
+    """
+    values = [float(v) for v in spawn_pose]
+    if len(values) != 6:
+        raise ValueError(f"spawn pose needs 6 values, got {len(values)}")
+
+    text = Path(base_world).read_text()
+    # %g would keep only 6 significant digits, losing ~1e-6 rad of a yaw like
+    # pi - 0.2. Small, but a silent systematic offset in every label derived
+    # from the spawn attitude, so full round-trip precision is written.
+    replacement = " ".join(f"{v:.12g}" for v in values)
+    patched, count = _POSE_PATTERN.subn(
+        lambda m: m.group(1) + replacement + m.group(3), text, count=1)
+    if count != 1:                                           # pragma: no cover
+        raise ValueError(f"expected exactly one vehicle pose, patched {count}")
+
+    written = vehicle_pose_of(patched)
+    if max(abs(a - b) for a, b in zip(written, values)) > 1e-9:  # pragma: no cover
+        raise ValueError(f"pose patch did not take effect: {written} != {values}")
+
+    directory = Path(directory)
+    directory.mkdir(parents=True, exist_ok=True)
+    # Named from the spawn pose, not the whole world: the pose is what
+    # distinguishes one variant from another, so two runs at the same pose
+    # produce the same filename and a run's world is identifiable from its name.
+    digest = hashlib.sha256(replacement.encode()).hexdigest()[:12]
+    destination = directory / f"world_{digest}.sdf"
+    destination.write_text(patched)
+    return destination
