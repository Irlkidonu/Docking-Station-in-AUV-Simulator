 })
 
diff --git a/src/uuv_sim_physics/uuv_sim_physics/process_group.py b/src/uuv_sim_physics/uuv_sim_physics/process_group.py
new file mode 100644
index 00000000..2e4c5d68
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/process_group.py
@@ -0,0 +1,113 @@
+"""Safe teardown of child processes launched in their own session.
+
+Live Gazebo helpers spawn a server with ``start_new_session=True`` and later kill
+it by process group. Done carelessly that can signal the *caller's* group and
+terminate the test runner itself. Four call sites had grown four near-identical
+copies of the guard, and two further call sites had no guard at all:
+
+* ``validation/heavy_sensor_liveness.py`` -- bare
+  ``os.killpg(os.getpgid(proc.pid), SIGKILL)``
+* ``docking_perception`` tooling -- the same bare form
+
+This module is the single implementation they now share.
+
+Why the guard is not simply "we passed ``start_new_session=True``"
+-----------------------------------------------------------------
+That flag is a request, and the value used at teardown is read back from the
+live process. Three independent conditions must all hold before a group signal
+is safe, and each rules out a distinct way of killing the wrong processes:
+
+``pgid == proc.pid``
+    the child leads its own process group, so the group contains the child and
+    its descendants and nothing else;
+``sid == proc.pid``
+    the child also leads its own *session*, confirming the new session actually
+    materialised rather than the child inheriting ours;
+``pgid != os.getpgrp()``
+    the target group is not the caller's own group -- the direct check against
+    killing the runner.
+
+If any condition fails the child is signalled individually instead, which is
+always safe and merely less thorough.
+
+Reaped processes are never signalled. Once ``Popen.poll()`` returns non-None the
+PID has been reaped and may be reused by an unrelated process, so signalling it
+could hit an innocent third party; the early return closes that race.
+"""
+from __future__ import annotations
+
+import os
+import signal
+import subprocess
+
+__all__ = ["owns_process_group", "terminate_owned_process"]
+
+
+def owns_process_group(proc) -> bool:
+    """True only when signalling ``proc``'s group cannot reach the caller."""
+    if proc is None or getattr(proc, "pid", None) in (None, 0):
+        return False
+    try:
+        pgid = os.getpgid(proc.pid)
+        sid = os.getsid(proc.pid)
+    except (ProcessLookupError, PermissionError, OSError):
+        return False
+    if pgid in (0, os.getpgrp()):
+        # pgid 0 means "the caller's group" to killpg; never a valid target.
+        return False
+    return pgid == proc.pid and sid == proc.pid
+
+
+def terminate_owned_process(proc, timeout_s: float = 10.0) -> None:
+    """Terminate a child and its descendants without signalling the caller.
+
+    Graceful ``SIGTERM`` first, then ``SIGKILL`` if the child outlives
+    ``timeout_s``. Safe to call on a process that already exited, never started,
+    or crashed, and safe to call repeatedly.
+    """
+    if proc is None:
+        return
+    try:
+        if proc.poll() is not None:
+            # Already exited. Reap if the caller has not, and never signal a
+            # PID that may since have been reused.
+            try:
+                proc.wait(timeout=timeout_s)
+            except (subprocess.TimeoutExpired, ValueError, OSError):
+                pass
+            return
+    except (ValueError, OSError):
+        return
+
+    # Resolve group ownership BEFORE signalling, so a child that dies mid
+    # teardown cannot flip the decision between the two signals.
+    grouped = owns_process_group(proc)
+    pgid = proc.pid if grouped else None
+
+    try:
+        if grouped:
+            os.killpg(pgid, signal.SIGTERM)
+        else:
+            proc.terminate()
+    except (ProcessLookupError, PermissionError, OSError):
+        pass
+
+    try:
+        proc.wait(timeout=timeout_s)
+        return
+    except subprocess.TimeoutExpired:
+        pass
+    except (ValueError, OSError):
+        return
+
+    try:
+        if grouped:
+            os.killpg(pgid, signal.SIGKILL)
+        else:
+            proc.kill()
+    except (ProcessLookupError, PermissionError, OSError):
+        pass
+    try:
+        proc.wait(timeout=timeout_s)
+    except (subprocess.TimeoutExpired, ValueError, OSError):
+        pass
