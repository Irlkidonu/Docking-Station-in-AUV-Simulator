+++ b/src/uuv_sim_physics/uuv_sim_physics/validation/heavy_profile.py
@@ -0,0 +1,316 @@
+"""Compact validation campaign for the BlueROV2 Heavy-derived profile.
+
+Scoped to one question: **is this plant adequate for Scenario C?** It does not
+mechanically reproduce every historical milestone; it checks the properties
+Scenario C actually depends on, and it sweeps every estimated parameter rather
+than trusting it.
+
+No estimated parameter is tuned against any docking outcome. Sensitivity is
+reported, not minimised.
+"""
+from __future__ import annotations
+
+import json
+import math
+from dataclasses import dataclass
+
+import numpy as np
+
+from .. import world_builder as wb
+from ..control.heavy_allocation import HeavyAllocator, allocation_matrix
+
+RHO = 1025.0
+G = 9.80665
+
+#: Documented Blue Robotics values the profile is checked against.
+DOCUMENTED = {
+    "length_m": 0.457, "width_m": 0.338, "height_m": 0.254,
+    "mass_kg": 11.5, "thrusters": 8,
+    "t200_fwd_12v_N": 36.4, "t200_rev_12v_N": 28.6,
+    "propeller_diameter_m": 0.076,
+    "heavy_vertical_kgf": 14.0, "heavy_lateral_kgf": 9.0,
+    "camera_fov_rad": 1.9199, "bar30_resolution_m": 0.002,
+}
+
+
+@dataclass
+class Check:
+    name: str
+    passed: bool
+    detail: str
+    value: object = None
+
+
+def _profile():
+    return wb.load_config(validated=True,
+                          vehicle="bluerov2_heavy")["vehicle_bluerov2_phys"]
+
+
+def check_dimensions_and_mass(v) -> list:
+    env, base = v["envelope"], v["base_link"]
+    out = [
+        Check("dimensions match documented",
+              all(abs(env[k] - DOCUMENTED[k]) < 1e-9
+                  for k in ("length_m", "width_m", "height_m")),
+              f'{env["length_m"]} x {env["width_m"]} x {env["height_m"]} m'),
+        Check("mass matches documented",
+              abs(total_mass(v) - DOCUMENTED["mass_kg"]) < 1e-9,
+              f'{total_mass(v)} kg total across all links '
+              f'(base {base["mass_kg"]}); BR-HEAVY 11.5 kg with ballast'),
+    ]
+    hd = 0.5 * math.hypot(env["width_m"], env["height_m"])
+    out.append(Check("throat clearance recomputed for the real envelope",
+                     abs(hd - env["half_diagonal_yz_m"]) < 1e-4,
+                     f"half-diagonal {hd:.5f} m -> clearance "
+                     f"{wb.COLLAR_INNER_R - hd:.5f} m "
+                     f"(representative vehicle: 0.06507 m)",
+                     wb.COLLAR_INNER_R - hd))
+    return out
+
+
+def total_mass(v) -> float:
+    """Whole-vehicle mass: base link + collision shells + thruster links.
+
+    Neutral buoyancy, net weight in water and the righting moment are all
+    WHOLE-VEHICLE quantities. They were originally written against
+    base_link.mass_kg because base_link then carried the entire 11.5 kg. Once
+    mass was distributed into eight thruster links and eighteen collision-shell
+    links, base_link fell to 11.402 kg and those comparisons silently began
+    testing a part against a documented total. The profile's own
+    vehicle_total_mass_kg records the intended invariant; it is cross-checked
+    here so the two cannot drift apart again.
+    """
+    base = v["base_link"]
+    total = (base["mass_kg"]
+             + len(base.get("collision_set", ())) * base.get("collision_shell_mass_kg", 0.0)
+             + sum(u["mass_kg"] for u in v["thrusters"]["units"]))
+    declared = base.get("vehicle_total_mass_kg")
+    if declared is not None and abs(total - declared) > 1e-9:
+        raise ValueError(
+            f"vehicle_total_mass_kg {declared} != summed link masses {total}")
+    return total
+
+
+def check_buoyancy(v) -> list:
+    base, buoy = v["base_link"], v["derived_buoyancy"]
+    volume = sum(s["volume_m3"] for s in base["collision_set"])
+    net_kgf = volume * RHO - total_mass(v)
+    envelope_volume = (v["envelope"]["length_m"] * v["envelope"]["width_m"]
+                       * v["envelope"]["height_m"])
+    return [
+        Check("collision volume matches declared displacement",
+              abs(volume - buoy["displaced_volume_m3"]) < 1e-5,
+              f"{volume:.6f} m^3 vs declared {buoy['displaced_volume_m3']:.6f}"),
+        Check("neutrally buoyant",
+              abs(net_kgf) < 0.02,
+              f"net {net_kgf:+.4f} kgf ({net_kgf * G:+.4f} N)", net_kgf),
+        Check("open-frame displacement, not the envelope box",
+              volume < 0.4 * envelope_volume,
+              f"solid {volume:.5f} m^3 vs envelope box {envelope_volume:.5f} m^3 "
+              f"({envelope_volume * RHO:.1f} kg if solid) -- the frame is water "
+              f"permeable, which is exactly why the representative vehicle was "
+              f"given its own box displacement as its mass"),
+    ]
+
+
+def check_actuation(v) -> list:
+    allocator = HeavyAllocator(v)
+    units = v["thrusters"]["units"]
+    common = v["thrusters"]["common"]
+    authority = allocator.axis_authority()
+    out = [
+        Check("eight thrusters", len(units) == DOCUMENTED["thrusters"],
+              f"{len(units)} units, frame {v['thrusters']['frame']}"),
+        Check("allocation matrix is full rank (6 DoF controllable)",
+              allocator.controllable_dof == 6,
+              f"rank {allocator.controllable_dof} of 6"),
+        Check("thrust limits use the 12 V operating point",
+              abs(common["max_thrust_cmd_N"] - DOCUMENTED["t200_fwd_12v_N"]) < 1e-6
+              and abs(common["min_thrust_cmd_N"] + DOCUMENTED["t200_rev_12v_N"]) < 1e-6,
+              f'+{common["max_thrust_cmd_N"]} / {common["min_thrust_cmd_N"]} N '
+              f'at {common["operating_voltage_v"]} V'),
+        Check("propeller diameter is the propeller, not the housing",
+              abs(common["propeller_diameter_m"]
+                  - DOCUMENTED["propeller_diameter_m"]) < 1e-9,
+              f'{common["propeller_diameter_m"]} m'),
+    ]
+    for axis in ("Fx", "Fy", "Fz", "Mx", "My", "Mz"):
+        out.append(Check(f"independent authority on {axis}",
+                         authority[axis] > 1e-6,
+                         f"{authority[axis]:.2f} "
+                         f"{'N' if axis[0] == 'F' else 'N.m'}",
+                         authority[axis]))
+    vert_doc = DOCUMENTED["heavy_vertical_kgf"] * G
+    lat_doc = DOCUMENTED["heavy_lateral_kgf"] * G
+    out += [
+        Check("vertical authority within 15% of documented",
+              abs(authority["Fz"] - vert_doc) / vert_doc < 0.15,
+              f'{authority["Fz"]:.1f} N vs documented {vert_doc:.1f} N '
+              f'({100 * (authority["Fz"] - vert_doc) / vert_doc:+.1f}%)'),
+        Check("lateral authority within 15% of documented",
+              abs(authority["Fx"] - lat_doc) / lat_doc < 0.15,
+              f'{authority["Fx"]:.1f} N vs documented {lat_doc:.1f} N '
+              f'({100 * (authority["Fx"] - lat_doc) / lat_doc:+.1f}%)'),
+    ]
+    # saturation sanity: an over-demand must clip, report, and stay finite
+    report = allocator([1e4, 0, 0, 0, 0, 0])
+    out.append(Check("saturation clips, reports and stays finite",
+                     bool(report.saturated) and np.all(np.isfinite(report.thrusts))
+                     and np.all(report.thrusts <= common["max_thrust_cmd_N"] + 1e-9),
+                     f"{len(report.saturated)} thrusters saturated, "
+                     f"residual {report.residual:.1f} N"))
+    return out
+
+
+def check_static_stability(v) -> list:
+    base, buoy = v["base_link"], v["derived_buoyancy"]
+    separation = buoy["bg_separation_m"]
+    # Restoring moment for a small heel: W * BG * sin(theta)
+    restoring_10deg = total_mass(v) * G * separation * math.sin(math.radians(10))
+    return [
+        Check("centre of mass below centre of buoyancy",
+              base["center_of_mass_m"][2] < buoy["center_of_buoyancy_m"][2],
+              f'CoM z {base["center_of_mass_m"][2]:+.3f} m, '
+              f'CoB z {buoy["center_of_buoyancy_m"][2]:+.3f} m, '
+              f"BG {separation:.3f} m"),
+        Check("passive roll/pitch restoring moment is positive",
+              restoring_10deg > 0,
+              f"{restoring_10deg:.3f} N.m at 10 deg heel", restoring_10deg),
+    ]
+
+
+def check_sensors(v) -> list:
+    s = v["sensors"]
+    return [
+        Check("camera FOV matches documented underwater value",
+              abs(s["camera"]["horizontal_fov_rad"]
+                  - DOCUMENTED["camera_fov_rad"]) < 1e-3,
+              f'{math.degrees(s["camera"]["horizontal_fov_rad"]):.1f} deg '
+              f'(BR-STORE 110 deg underwater)'),
+        Check("camera resolution is the documented 1080p",
+              (s["camera"]["width"], s["camera"]["height"]) == (1920, 1080),
+              f'{s["camera"]["width"]}x{s["camera"]["height"]}'),
+        Check("depth sensor is modelled as a Bar30, not a truth surrogate",
+              s["depth"]["model"] == "Bar30"
+              and abs(s["depth"]["resolution_m"]
+                      - DOCUMENTED["bar30_resolution_m"]) < 1e-9
+              and s["depth"]["accuracy_mbar"] == 50,
+              f'{s["depth"]["resolution_m"] * 1000:.0f} mm resolution, '
+              f'+/-{s["depth"]["accuracy_mbar"]} mbar accuracy '
+              f'(= +/-{s["depth"]["accuracy_mbar"] / 100:.2f} m), '
+              f'residual bias after surface zeroing '
+              f'{s["depth"]["residual_bias_m"]} m'),
+        Check("IMU is the documented Navigator device",
+              s["imu"]["model"] == "ICM-20602" and s["imu"]["magnetometers"] == 2,
+              f'{s["imu"]["model"]}, {s["imu"]["magnetometers"]} magnetometers'),
+        Check("optional hardware declared not stock",
+              not any(s["stock"] for s in v["optional_hardware"].values()),
+              ", ".join(f"{k}: stock={x['stock']}"
+                        for k, x in v["optional_hardware"].items())),
+        Check("tether declared present but unmodelled",
+              v["tether"]["present"] and not v["tether"]["modelled"],
+              v["tether"]["note"]),
+    ]
+
+
+def check_determinism(v) -> list:
+    import hashlib
+    digests = {hashlib.sha256(
+        wb.build_world_sdf(validated=True, vehicle="bluerov2_heavy").encode()
+    ).hexdigest() for _ in range(3)}
+    default = hashlib.sha256(
+        wb.build_world_sdf(validated=True).encode()).hexdigest()
+    return [
+        Check("Heavy world regenerates deterministically",
+              len(digests) == 1, f"3 regenerations -> {len(digests)} digest"),
+        Check("Heavy world is distinct from the validated world",
+              digests.pop() != default,
+              "different SDF; the validated world is not shadowed"),
+    ]
+
+
+def sensitivity(v) -> dict:
+    """Sweep every estimated parameter. Reported, never minimised."""
+    import copy
+    out = {}
+
+    # thruster coordinates +/- 25%
+    spread = {}
+    for scale in (0.75, 1.0, 1.25):
+        w = copy.deepcopy(v)
+        for unit in w["thrusters"]["units"]:
+            unit["position_m"] = [c * scale for c in unit["position_m"]]
+        a = HeavyAllocator(w).axis_authority()
+        spread[scale] = {k: round(val, 3) for k, val in a.items()}
+    out["thruster_positions_+-25%"] = spread
+
+    # vectored angle 35 / 45 / 55 deg
+    angles = {}
+    for deg in (35.0, 45.0, 55.0):
+        w = copy.deepcopy(v)
+        c, s = math.cos(math.radians(deg)), math.sin(math.radians(deg))
+        for unit in w["thrusters"]["units"]:
+            ax = unit["axis"]
+            if abs(ax[2]) < 0.5:
+                unit["axis"] = [math.copysign(c, ax[0]), math.copysign(s, ax[1]), 0.0]
+        a = HeavyAllocator(w).axis_authority()
+        angles[deg] = {k: round(val, 3) for k, val in a.items()}
+    out["vectored_angle_deg"] = angles
+
+    # inertia +/- 50%: reported as the implied yaw acceleration at max moment
+    inertia = v["base_link"]["inertia_kgm2"]
+    mz = HeavyAllocator(v).axis_authority()["Mz"]
+    out["inertia_+-50%_yaw_accel_rad_s2"] = {
+        f"{scale:g}x": round(mz / (inertia["izz"] * scale), 4)
+        for scale in (0.5, 1.0, 1.5)}
+
+    # BG separation 10 / 20 / 30 mm
+    out["bg_separation_restoring_Nm_at_10deg"] = {
+        f"{sep * 1000:.0f}mm": round(
+            total_mass(v) * G * sep * math.sin(math.radians(10)), 4)
+        for sep in (0.010, 0.020, 0.030)}
+    return out
+
+
+def run() -> dict:
+    v = _profile()
+    groups = {
+        "dimensions and mass": check_dimensions_and_mass(v),
+        "buoyancy and ballast": check_buoyancy(v),
+        "actuation and allocation": check_actuation(v),
+        "static stability": check_static_stability(v),
+        "sensing": check_sensors(v),
+        "determinism": check_determinism(v),
+    }
+    results, failed = {}, []
+    for group, checks in groups.items():
+        results[group] = []
+        print(f"\n{group}")
+        for c in checks:
+            print(f"  [{'PASS' if c.passed else 'FAIL'}] {c.name}\n"
+                  f"         {c.detail}")
+            results[group].append({"check": c.name, "pass": c.passed,
+                                   "detail": c.detail, "value": c.value})
+            if not c.passed:
+                failed.append(f"{group}: {c.name}")
+
+    sens = sensitivity(v)
+    print("\nsensitivity of estimated parameters (reported, not minimised)")
+    for key, block in sens.items():
+        print(f"  {key}: {json.dumps(block)[:300]}")
+
+    total = sum(len(x) for x in results.values())
+    print(f"\n{total - len(failed)}/{total} checks passed")
+    for f in failed:
+        print(f"  FAILED: {f}")
+    return {"verdict": "PASS" if not failed else "FAIL", "checks": results,
+            "sensitivity": sens, "failed": failed,
+            "passed": total - len(failed), "total": total}
+
+
+if __name__ == "__main__":
+    import sys
+    from pathlib import Path
+    report = run()
+    Path("heavy_validation.json").write_text(json.dumps(report, indent=1, default=str) + "\n")
+    sys.exit(0 if report["verdict"] == "PASS" else 1)
