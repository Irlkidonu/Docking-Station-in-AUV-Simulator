+++ b/src/uuv_sim_physics/uuv_sim_physics/sensors/nephelometer.py
@@ -0,0 +1,108 @@
+"""Virtual white-light nephelometer producing a modeled, uncalibrated index."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+
+from .particulate_water import (FORMazin_REFERENCE, ParticulateWaterMedium,
+                                henyey_greenstein)
+
+
+@dataclass(frozen=True)
+class NephelometerConfig:
+    source_temperature_k: float = 2700.0
+    source_path_m: float = 0.025
+    detector_path_m: float = 0.025
+    detector_angle_deg: float = 90.0
+    detector_acceptance_half_angle_deg: float = 10.0
+    spectral_min_nm: float = 400.0
+    spectral_max_nm: float = 600.0
+    reading_resolution_index: float = 0.01
+    reading_noise_std_fraction: float = 0.002
+    # Explicit virtual-reference response scale. Calibration makes the absolute
+    # scale cancel; it is not a conversion to a physical turbidity unit.
+    reference_scattering_scale_m_inv: float = 0.002
+
+    # Compatibility aliases for pre-existing dataset tools. These names do not
+    # imply physical calibration and are not used in new artifacts.
+    @property
+    def reading_resolution_ntu(self) -> float:
+        return self.reading_resolution_index
+
+    @property
+    def formazin_scattering_per_ntu_m_inv(self) -> float:
+        return self.reference_scattering_scale_m_inv
+
+
+@dataclass(frozen=True)
+class TurbidityReading:
+    simulated_nephelometric_index: float
+    raw_scattered_response: float
+    extrapolated: bool
+    calibration_range_index: tuple
+
+    @property
+    def turbidity_ntu(self) -> float:
+        """Legacy schema alias; value is not traceably calibrated physical NTU."""
+        return self.simulated_nephelometric_index
+
+
+class VirtualNephelometer:
+    CALIBRATION_POINTS_INDEX = np.array([0.0, 1.0, 10.0, 20.0, 40.0])
+
+    def __init__(self, config: NephelometerConfig = NephelometerConfig(),
+                 seed: int = 0) -> None:
+        self.config = config
+        self._seed = seed
+        self.reset(seed)
+        self._standards = self._standard_responses()
+
+    def reset(self, seed: int | None = None) -> None:
+        self._rng = np.random.default_rng(self._seed if seed is None else seed)
+
+    def _response(self, scattering_m_inv: float, attenuation_m_inv: float,
+                  phase_90_sr_inv: float) -> float:
+        total_path = self.config.source_path_m + self.config.detector_path_m
+        transmission = np.exp(-float(attenuation_m_inv) * total_path)
+        # Relative radiometry: common lamp/detector factors cancel through the
+        # calibration curve. Geometry and attenuation remain explicit.
+        return float(scattering_m_inv * phase_90_sr_inv * transmission)
+
+    def _standard_responses(self) -> np.ndarray:
+        phase = henyey_greenstein(np.pi / 2, FORMazin_REFERENCE.asymmetry_g)
+        b = self.CALIBRATION_POINTS_INDEX * self.config.reference_scattering_scale_m_inv
+        return np.array([self._response(x, x, phase) for x in b])
+
+    def calibration_check(self) -> dict:
+        predicted = np.interp(self._standards, self._standards,
+                              self.CALIBRATION_POINTS_INDEX)
+        error = predicted - self.CALIBRATION_POINTS_INDEX
+        return {"standards_index": self.CALIBRATION_POINTS_INDEX.copy(),
+                "responses": self._standards.copy(), "predicted_index": predicted,
+                "maximum_absolute_error_index": float(np.max(np.abs(error)))}
+
+    def measure(self, medium: ParticulateWaterMedium) -> TurbidityReading:
+        coeff = medium.optical_coefficients_rgb()
+        b = float(coeff["scattering_rgb_m_inv"][1])
+        c = float(coeff["attenuation_rgb_m_inv"][1])
+        phase = henyey_greenstein(np.deg2rad(self.config.detector_angle_deg),
+                                  medium.particle_class.asymmetry_g)
+        raw = self._response(b, c, phase)
+        noisy = raw * (1.0 + self._rng.normal(
+            0.0, self.config.reading_noise_std_fraction))
+        extrapolated = noisy > self._standards[-1]
+        if extrapolated:
+            slope = ((self.CALIBRATION_POINTS_INDEX[-1] -
+                      self.CALIBRATION_POINTS_INDEX[-2]) /
+                     (self._standards[-1] - self._standards[-2]))
+            index = self.CALIBRATION_POINTS_INDEX[-1] + slope * (
+                noisy - self._standards[-1])
+        else:
+            index = float(np.interp(max(noisy, self._standards[0]),
+                                    self._standards,
+                                    self.CALIBRATION_POINTS_INDEX))
+        index = max(0.0, index)
+        index = round(index / self.config.reading_resolution_index) * \
+            self.config.reading_resolution_index
+        return TurbidityReading(float(index), raw, bool(extrapolated), (0.0, 40.0))
