new file mode 100644
index 00000000..1f524200
--- /dev/null
+++ b/src/uuv_sim_physics/config/vehicle_bluerov2_heavy.yaml
@@ -0,0 +1,298 @@
+# BlueROV2 Heavy-derived simulation profile.
+#
+# ADDITIVE. This file is new; vehicle_bluerov2_phys.yaml is untouched and every
+# earlier result continues to run on it.
+#
+# NOT a digital twin. A "validated BlueROV2 Heavy-derived simulation profile":
+# documented Blue Robotics values where they are published, declared estimates
+# elsewhere. Every field carries [DOC] with a source or [EST] with a derivation.
+#
+# Sources:
+#   BR-STORE  https://bluerobotics.com/store/rov/bluerov2/
+#   BR-HEAVY  https://bluerobotics.com/store/rov/bluerov2-upgrade-kits/brov2-heavy-retrofit/
+#   BR-T200   https://bluerobotics.com/store/thrusters/t100-t200-thrusters/t200-thruster-r2-rp/
+#   BR-BAR    https://bluerobotics.com/store/sensors-cameras/sensors/bar-depth-pressure-sensor/
+#   BR-NAV    https://bluerobotics.com/store/comm-control-power/control/navigator/
+#   ARDUSUB   https://www.ardusub.com/introduction/features.html
+
+name: bluerov2_heavy
+profile_status: "Heavy-derived; validated for Scenario C adequacy, not a digital twin"
+spawn_pose: [4.0, 0.0, -15.0, 0.0, 0.0, 3.14159]
+self_collide: false
+
+# Collision DETECTOR, a Heavy-profile setting only. DART 6.13.2 defaults to its
+# ODE collision backend, whose dxHashSpace aborts on the first collide() call
+# for any dynamic model carrying two or more collision geometries. The DART
+# rigid-body solver is unaffected -- only the broadphase is ODE's. Selecting a
+# non-ODE detector is therefore a collision-backend choice, not a solver change.
+# shared physics.yaml, bluerov2_phys and every existing world keep the default.
+collision_detector: bullet
+
+# --- documented envelope -----------------------------------------------------
+envelope:
+  length_m: 0.457        # [DOC] BR-STORE
+  width_m:  0.338        # [DOC] BR-STORE
+  height_m: 0.254        # [DOC] BR-STORE
+  # Half-diagonal normal to the approach axis, which sets throat clearance:
+  #   0.5 * hypot(0.338, 0.254) = 0.21140 m
+  # Against the dock's 0.240 m collar inner radius this leaves 0.02860 m, less
+  # than half the 0.06507 m the representative vehicle enjoys. Scenario C's
+  # capture criterion must be derived from THIS number, not inherited.
+  half_diagonal_yz_m: 0.21140   # [DER]
+  radial_clearance_m: 0.02860   # [DER]
+
+base_link:
+  # [DOC] BR-HEAVY gives 11.5 kg for the WHOLE vehicle with ballast. The model
+  # also carries eight thruster links at 0.01 kg each (0.08 kg total, needed so
+  # the propeller joints have inertia), so base_link takes the remainder and the
+  # emitted total is exactly the documented figure.
+  # [DER] 11.5 documented total, less 8 x 0.01 kg thruster links and
+  # 18 x 0.001 kg collision-shell links. No mass is added silently.
+  mass_kg: 11.402
+  collision_shell_mass_kg: 0.001
+  vehicle_total_mass_kg: 11.5
+  # [EST] Slightly bottom-heavy trim is documented qualitatively (passive roll
+  # and pitch stability); the separation is not published. 0.020 m is the
+  # mid-point of the 10-20 mm range typical of this class and is swept in the
+  # sensitivity study.
+  center_of_mass_m: [0.0, 0.0, -0.020]
+  # [EST] Not published. Derived as a uniform-density box of the documented
+  # envelope at the documented mass:
+  #   Ixx = m/12 (w^2 + h^2) = 11.5/12 (0.338^2 + 0.254^2) = 0.1713
+  #   Iyy = m/12 (l^2 + h^2) = 11.5/12 (0.457^2 + 0.254^2) = 0.2619
+  #   Izz = m/12 (l^2 + w^2) = 11.5/12 (0.457^2 + 0.338^2) = 0.3096
+  # A real open frame concentrates mass outboard, so these are lower bounds;
+  # the sensitivity study sweeps +/-50%.
+  inertia_kgm2: {ixx: 0.1713, iyy: 0.2619, izz: 0.3096, ixy: 0.0, ixz: 0.0, iyz: 0.0}
+
+  # --- collision / buoyancy set --------------------------------------------
+  # THE KEY MODELLING DECISION. A solid box of the documented envelope displaces
+  # 0.039234 m^3 = 40.2 kg of seawater, which against an 11.5 kg vehicle would
+  # be +28.7 kgf of net buoyancy. The BlueROV2 frame is OPEN and water
+  # permeable: only the sealed enclosures, the foam and the thruster bodies
+  # displace. (This is precisely why the representative vehicle was given
+  # 25.461 kg -- the displaced mass of its own solid box hull.)
+  #
+  # The Heavy profile therefore models the solid volume explicitly. Component
+  # volumes sum to 11.5/1025 = 0.011220 m^3, giving neutral trim by
+  # construction, while the primitives are placed to span the documented
+  # envelope so that contact with the dock throat remains representative.
+  # Primitives are laid out in DISJOINT z-layers and outboard bands so that no
+  # two intersect. This is not cosmetic: Gazebo's buoyancy system integrates
+  # every collision independently, so any overlap is counted twice and the
+  # vehicle floats. An earlier layout summed to the right volume on paper while
+  # emitting 0.00121 m^3 of double-counted overlap, which is why the vehicle
+  # rose 0.41 m in 10 s of free drift.
+  #
+  #   layer 1  z in [-0.120, -0.031]  battery enclosure
+  #   layer 2  z in [-0.027, +0.087]  electronics enclosure (|y| < 0.058)
+  #   layer 3  z in [+0.057, +0.113]  thruster bodies (|y| > 0.082, outboard)
+  #   layer 4  z in [+0.122, +0.168]  foam blocks (|y| in 0.05..0.15)
+  #   rails                            |y| in 0.155..0.175, envelope span
+  # CONTACT vs DISPLACEMENT are separate physical models and are now declared
+  # separately. The stock gz-sim buoyancy system derives displaced volume from
+  # collision geometry, so a single geometry cannot be both the documented
+  # contact envelope AND the open-frame displaced volume -- one of the two must
+  # be wrong. They are decoupled with the buoyancy system's own <enable>
+  # scoping: the displacement primitives below are buoyancy-enabled and
+  # contact-disabled (collide_bitmask 0), while this envelope carries contact
+  # and is excluded from buoyancy. No custom hydrostatics plugin is required.
+  contact_envelope:
+    name: contact_envelope
+    shape: box
+    size: [0.457, 0.338, 0.254]   # [DOC] BR-STORE documented envelope
+    pose: [0.0, 0.0, 0.0, 0, 0, 0]
+
+  # DISPLACEMENT ONLY -- these primitives no longer take part in contact.
+  collision_set:
+    - {name: enclosure_battery, shape: cylinder, radius: 0.04445, length: 0.298,
+       pose: [0.0, 0.0, -0.0750, 0.0, 1.5708, 0.0], volume_m3: 0.001850}
+    - {name: enclosure_electronics, shape: cylinder, radius: 0.05715, length: 0.298,
+       pose: [0.0, 0.0, 0.0300, 0.0, 1.5708, 0.0], volume_m3: 0.003058}
+    - {name: thr_body_hfl, shape: box, size: [0.0568, 0.0568, 0.0568],
+       pose: [ 0.156,  0.111, 0.085, 0, 0, 0], volume_m3: 0.000183}
+    - {name: thr_body_hfr, shape: box, size: [0.0568, 0.0568, 0.0568],
+       pose: [ 0.156, -0.111, 0.085, 0, 0, 0], volume_m3: 0.000183}
+    - {name: thr_body_hbl, shape: box, size: [0.0568, 0.0568, 0.0568],
+       pose: [-0.156,  0.111, 0.085, 0, 0, 0], volume_m3: 0.000183}
+    - {name: thr_body_hbr, shape: box, size: [0.0568, 0.0568, 0.0568],
+       pose: [-0.156, -0.111, 0.085, 0, 0, 0], volume_m3: 0.000183}
+    - {name: thr_body_vfl, shape: box, size: [0.0568, 0.0568, 0.0568],
+       pose: [ 0.120,  0.218, 0.0, 0, 0, 0], volume_m3: 0.000183}
+    - {name: thr_body_vfr, shape: box, size: [0.0568, 0.0568, 0.0568],
+       pose: [ 0.120, -0.218, 0.0, 0, 0, 0], volume_m3: 0.000183}
+    - {name: thr_body_vbl, shape: box, size: [0.0568, 0.0568, 0.0568],
+       pose: [-0.120,  0.218, 0.0, 0, 0, 0], volume_m3: 0.000183}
+    - {name: thr_body_vbr, shape: box, size: [0.0568, 0.0568, 0.0568],
+       pose: [-0.120, -0.218, 0.0, 0, 0, 0], volume_m3: 0.000183}
+    - {name: foam_fl, shape: box, size: [0.190, 0.100, 0.0541516],
+       pose: [ 0.110,  0.100, 0.145, 0, 0, 0], volume_m3: 0.00102888}
+    - {name: foam_fr, shape: box, size: [0.190, 0.100, 0.0541516],
+       pose: [ 0.110, -0.100, 0.145, 0, 0, 0], volume_m3: 0.00102888}
+    - {name: foam_bl, shape: box, size: [0.190, 0.100, 0.0541516],
+       pose: [-0.110,  0.100, 0.145, 0, 0, 0], volume_m3: 0.00102888}
+    - {name: foam_br, shape: box, size: [0.190, 0.100, 0.0541516],
+       pose: [-0.110, -0.100, 0.145, 0, 0, 0], volume_m3: 0.00102888}
+    - {name: rail_tl, shape: box, size: [0.457, 0.020, 0.020],
+       pose: [0.0,  0.165,  0.117, 0, 0, 0], volume_m3: 0.000183}
+    - {name: rail_tr, shape: box, size: [0.457, 0.020, 0.020],
+       pose: [0.0, -0.165,  0.117, 0, 0, 0], volume_m3: 0.000183}
+    - {name: rail_bl, shape: box, size: [0.457, 0.020, 0.020],
+       pose: [0.0,  0.165, -0.117, 0, 0, 0], volume_m3: 0.000183}
+    - {name: rail_br, shape: box, size: [0.457, 0.020, 0.020],
+       pose: [0.0, -0.165, -0.117, 0, 0, 0], volume_m3: 0.000183}
+
+derived_buoyancy:
+  displaced_volume_m3: 0.011220   # [DER] sum of collision_set volumes
+  displaced_mass_kg: 11.5005      # [DER] x 1025 of the rounded primitive volumes
+  # The primitive dimensions above are rounded, so their exact geometric volume
+  # is 0.011220187 m^3 = 11.500692 kg displaced, i.e. +0.00069 kg of spurious
+  # buoyancy (+0.0068 N), which is the entire observed 1.3 mm/s heave drift.
+  # The builder applies ONE uniform linear scale to every displacement primitive
+  # so the emitted geometry displaces exactly the documented vehicle mass. The
+  # factor is ~0.99998 (a 0.002 % change in each dimension); it is uniform, so
+  # relative proportions and the centre of buoyancy are exactly preserved. This
+  # reconciles rounded geometry with the declared displacement -- it is NOT a
+  # free parameter and is not tuned against any depth outcome.
+  target_displaced_mass_kg: 11.500   # exactly the documented total vehicle mass
+  net_weight_in_water_N: 0.0      # neutral by construction
+  # [DER] SUPERSEDES the earlier [EST] CoB [0,0,0] / BG 0.020 m, which was an
+  # assumption and is falsified by the displacement geometry itself. The volume
+  # centroid of the declared primitives is +0.054550 m: the four foam blocks sit
+  # at z = +0.145 and carry 37 % of the displaced volume, while the enclosures
+  # sit at -0.075 and +0.030. A high centre of buoyancy is correct for this
+  # vehicle -- top-mounted foam over a bottom-mounted battery is exactly why a
+  # BlueROV2 Heavy is strongly self-righting -- but the magnitude is 3.7x the
+  # previous estimate and changes every righting moment accordingly.
+  center_of_buoyancy_m: [0.0, 0.0, 0.054550]
+  bg_separation_m: 0.074550       # [DER] CoB 0.054550 - CoM -0.020
+  note: "open-frame displacement; NOT the envelope box volume"
+
+# --- actuation: ArduSub vectored6dof, 8 x T200 -------------------------------
+thrusters:
+  frame: vectored6dof             # [DOC] ARDUSUB
+  common:
+    model: T200                   # [DOC] BR-T200
+    propeller_diameter_m: 0.076   # [DOC] BR-T200 (the 0.100 m figure is the BODY diameter)
+    fluid_density_kgm3: 1025
+    thrust_coefficient: 0.004422
+    namespace: bluerov2_heavy
+    # [DOC] BR-T200 at 12 V, which is the operating point Blue Robotics quotes
+    # the Heavy totals at: 4 vertical x 3.71 kgf = 14.8 ~ "14 kgf", and
+    # 4 vectored x 3.71 x cos45 = 10.5 ~ "9 kgf". Building at 16 V would
+    # over-actuate the model by roughly 40%.
+    operating_voltage_v: 12.0
+    max_thrust_cmd_N: 36.4        # [DOC] 3.71 kgf forward at 12 V
+    min_thrust_cmd_N: -28.6       # [DOC] 2.92 kgf reverse at 12 V (asymmetric)
+    reverse_forward_ratio: 0.786  # [DER] 28.6/36.4
+    motor_time_constant_s: 0.15   # [EST] not published; swept in sensitivity
+    deadband_fraction: 0.02       # [EST]
+  propeller_inertia_kgm2: 1.0e-05
+  joint_damping: 0.0
+  # [DOC] Axis-to-position pairing is fixed by ArduPilot's own frame definition,
+  # AP_Motors6DOF.cpp SUB_FRAME_VECTORED_6DOF, which is the authority for how a
+  # Heavy is actually mixed:
+  #   MOT_1 fwd -1 lat +1 yaw +1   MOT_2 fwd -1 lat -1 yaw -1
+  #   MOT_3 fwd +1 lat +1 yaw -1   MOT_4 fwd +1 lat -1 yaw +1
+  #   MOT_5..8 roll +-1 pitch -+1 throttle -1
+  # For a thruster at (x, y) with unit axis (ax, ay): forward = ax,
+  # lateral = ay, yaw arm = x*ay - y*ax. Those three signs together pin each
+  # thruster's axis to its corner uniquely. The yaw arm is 0.7071*(a+b) =
+  # 0.1888 m, not 0.7071*(a-b) = 0.0318 m -- an earlier estimate paired the
+  # axes outward along the corner diagonal and understated yaw by 5.9x.
+  #
+  # [EST] Only the corner coordinates themselves remain estimated: Blue
+  # Robotics does not publish thruster coordinates. (a, b) = (0.156, 0.111) m
+  # is taken from the documented 457 x 338 mm frame and is swept +-25%.
+  units:
+    - {name: thr_hfl, joint: thr_hfl_joint, position_m: [ 0.156,  0.111,  0.085], axis: [-0.7071,  0.7071, 0], mass_kg: 0.01}
+    - {name: thr_hfr, joint: thr_hfr_joint, position_m: [ 0.156, -0.111,  0.085], axis: [-0.7071, -0.7071, 0], mass_kg: 0.01}
+    - {name: thr_hbl, joint: thr_hbl_joint, position_m: [-0.156,  0.111,  0.085], axis: [ 0.7071,  0.7071, 0], mass_kg: 0.01}
+    - {name: thr_hbr, joint: thr_hbr_joint, position_m: [-0.156, -0.111,  0.085], axis: [ 0.7071, -0.7071, 0], mass_kg: 0.01}
+    - {name: thr_vfl, joint: thr_vfl_joint, position_m: [ 0.120,  0.218,  0.0],   axis: [0, 0, 1], mass_kg: 0.01}
+    - {name: thr_vfr, joint: thr_vfr_joint, position_m: [ 0.120, -0.218,  0.0],   axis: [0, 0, 1], mass_kg: 0.01}
+    - {name: thr_vbl, joint: thr_vbl_joint, position_m: [-0.120,  0.218,  0.0],   axis: [0, 0, 1], mass_kg: 0.01}
+    - {name: thr_vbr, joint: thr_vbr_joint, position_m: [-0.120, -0.218,  0.0],   axis: [0, 0, 1], mass_kg: 0.01}
+
+# --- hydrodynamics -----------------------------------------------------------
+# [EST] Blue Robotics publishes no hydrodynamic coefficients. Values below are
+# the widely used BlueROV2 identification set reported in the underwater-robotics
+# literature (Wu 2018, "Towards linear-parameter-varying control of an
+# underwater vehicle", MSc thesis, Flinders University; reproduced in the
+# bluerov2_ignition / BlueROV2 heavy Gazebo community models), scaled to the
+# documented 11.5 kg. They are NOT tuned against any docking outcome and are
+# swept +/-50% in the sensitivity study.
+hydrodynamics:
+  link_name: base_link
+  source: "Wu (2018) BlueROV2 identification; community Gazebo models"
+  # Added mass is integrated by DART via SDFormat <fluid_added_mass>, NOT by the
+  # hydrodynamics plugin. gz-sim 8.11.0's plugin path applies added mass as an
+  # explicit one-step-lagged external wrench, which diverges unconditionally
+  # whenever |added mass| > rigid-body inertia -- true here in sway and heave.
+  # Coefficients below are unchanged; only the integration path differs.
+  added_mass_path: fluid_added_mass
+  added_mass:      {xDotU: -5.5,  yDotV: -12.7, zDotW: -14.57, kDotP: -0.12, mDotQ: -0.12, nDotR: -0.12}
+  linear_damping:  {xU: -4.03, yV: -6.22, zW: -5.18, kP: -0.07, mQ: -0.07, nR: -0.07}
+  quadratic_damping: {xUabsU: -18.18, yVabsV: -21.66, zWabsW: -36.99, kPabsP: -1.55, mQabsQ: -1.55, nRabsR: -1.55}
+
+# --- sensing (stock) ---------------------------------------------------------
+sensors:
+  camera:
+    type: camera
+    pose: [0.23, 0.0, -0.01, 0.0, 0.0, 0.0]
+    horizontal_fov_rad: 1.9199    # [DOC] BR-STORE 110 deg underwater
+    width: 1920                   # [DOC] 1080p
+    height: 1080
+    format: R8G8B8
+    near_clip_m: 0.02
+    far_clip_m: 60
+    update_rate_hz: 30
+    topic: /bluerov2_heavy/camera
+  imu:                            # [DOC] BR-NAV Navigator, ICM-20602
+    model: ICM-20602
+    pose: [0.0, 0.0, 0.0, 0, 0, 0]
+    update_rate_hz: 200
+    gyro_range_dps: 2000
+    accel_range_g: 16
+    topic: /bluerov2_heavy/imu
+    magnetometers: 2              # [DOC] dual 3-axis on Navigator
+  depth:                          # [DOC] BR-BAR Bar30 / MS5837-30BA
+    model: Bar30
+    range_bar: 30
+    resolution_m: 0.002           # [DOC] 2 mm
+    accuracy_mbar: 50             # [DOC] +/-50 mbar over 0-6 bar == +/-0.5 m
+    surface_zeroed: true          # operational practice removes most of the bias
+    residual_bias_m: 0.05         # [EST] post-zeroing thermal drift
+    topic: /bluerov2_heavy/depth
+  lights:                         # [DOC] BR-STORE, 2 x Lumen standard
+    count: 2
+    pose_l: [0.24, 0.11, 0.0, 0, 0, 0]
+    pose_r: [0.24, -0.11, 0.0, 0, 0, 0]
+
+# Emitted subsea lamps. Separation from the camera (0.11 m) is what suppresses
+# backscatter in turbid water and the lighting model rewards it.
+headlights:                       # [DOC] BR-STORE 2 x Lumen
+  - {name: lumen_l, pose: [0.24, 0.11, 0.0, 0.0, 0.0, 0.0], range_m: 7}
+  - {name: lumen_r, pose: [0.24, -0.11, 0.0, 0.0, 0.0, 0.0], range_m: 7}
+
+# --- explicitly NOT stock ----------------------------------------------------
+optional_hardware:
+  fls: {stock: false, note: "no stock analogue; Ping360 is a mechanically scanning imaging sonar"}
+  dvl: {stock: false, note: "Water Linked DVL-A50; requires bottom lock"}
+  usbl: {stock: false, note: "Water Linked UGPS"}
+
+tether:                            # [DOC] BR-STORE
+  present: true
+  diameter_mm: 7.6
+  length_range_m: [25, 300]
+  working_strength_kgf: 35
+  modelled: false
+  note: "ACKNOWLEDGED LIMITATION -- tether drag and snag are not simulated"
+
+known_limitations:
+  inertia: "estimated as a uniform box; a real open frame is more outboard"
+  thruster_coordinates: "axis-to-position pairing fixed by ArduPilot SUB_FRAME_VECTORED_6DOF; corner coordinates (0.156, 0.111) m still estimated from the documented frame size and swept +-25%"
+  hydrodynamics: "literature-derived, not manufacturer data"
+  bg_separation: "estimated within a documented qualitative range"
+  motor_dynamics: "time constant and deadband estimated"
+  tether: "not modelled at all"
