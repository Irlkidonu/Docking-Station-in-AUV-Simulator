diff --git a/src/uuv_sim_physics/uuv_sim_physics/sensors/depth.py b/src/uuv_sim_physics/uuv_sim_physics/sensors/depth.py
new file mode 100644
index 00000000..a70e20b2
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/sensors/depth.py
@@ -0,0 +1,67 @@
+"""Bar30 (MS5837-30BA) depth measurement model.
+
+The published +-50 mbar figure is an **absolute pressure accuracy**, and it must
+not be modelled as +-0.5 m of independent per-sample depth noise. Those are
+different physical quantities with different consequences:
+
+* **Calibration bias** -- a slowly varying offset from absolute-pressure error
+  and atmospheric reference. It is constant over a dive, so it does NOT average
+  out, and it shifts every depth equally. Operational practice removes most of
+  it by zeroing at the surface, leaving a residual from thermal drift.
+* **Short-term noise** -- per-sample scatter at the sensor's 2 mm resolution.
+  It averages out and is what a filter can reject.
+
+Treating the bias as noise would make depth look far worse sample-to-sample and
+far better on average than it is. For docking against a *surveyed* dock depth
+the residual bias is what matters, because it never cancels.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+
+__all__ = ["Bar30Model", "Bar30Config"]
+
+MBAR_PER_METRE = 100.7          # seawater at 1025 kg/m^3
+
+
+@dataclass(frozen=True)
+class Bar30Config:
+    """[DOC] resolution and accuracy from the Blue Robotics Bar30 datasheet."""
+    resolution_m: float = 0.002          # [DOC] 2 mm
+    absolute_accuracy_mbar: float = 50.0 # [DOC] +-50 mbar over 0-6 bar
+    noise_sigma_m: float = 0.004         # [EST] ~2x resolution, short-term
+    surface_zeroed: bool = True          # operational practice
+    residual_bias_sigma_m: float = 0.05  # [EST] thermal drift after zeroing
+    drift_rate_m_per_s: float = 1.0e-4   # [EST] slow thermal walk
+    latency_s: float = 0.02              # [EST] I2C + autopilot pipeline
+
+
+class Bar30Model:
+    """One sensor instance. Bias is drawn ONCE per dive, not per sample."""
+
+    def __init__(self, config: Bar30Config | None = None, seed: int = 0) -> None:
+        self.config = config or Bar30Config()
+        self._rng = np.random.default_rng(seed)
+        self.reset()
+
+    def reset(self) -> None:
+        cfg = self.config
+        if cfg.surface_zeroed:
+            # Zeroing at the surface removes the absolute-pressure offset; what
+            # survives is thermal drift as the vehicle descends into colder water.
+            self.bias_m = float(self._rng.normal(0.0, cfg.residual_bias_sigma_m))
+        else:
+            self.bias_m = float(self._rng.normal(
+                0.0, cfg.absolute_accuracy_mbar / MBAR_PER_METRE))
+        self._drift_m = 0.0
+
+    def measure(self, true_depth_m: float, dt: float = 0.0) -> float:
+        """Measured depth. Bias persists; noise does not."""
+        cfg = self.config
+        self._drift_m += float(self._rng.normal(0.0, cfg.drift_rate_m_per_s
+                                                * max(dt, 0.0)))
+        value = (float(true_depth_m) + self.bias_m + self._drift_m
+                 + float(self._rng.normal(0.0, cfg.noise_sigma_m)))
+        return float(np.round(value / cfg.resolution_m) * cfg.resolution_m)
diff --git a/src/uuv_sim_physics/uuv_sim_physics/sensors/dvl_robustness.py b/src/uuv_sim_physics/uuv_sim_physics/sensors/dvl_robustness.py
new file mode 100644
index 00000000..12a9d24f
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/sensors/dvl_robustness.py
@@ -0,0 +1,71 @@
+"""Opt-in DVL measurement-channel robustness model.
+
+The ranges follow the declared Water Linked A50 envelope.  This additive model
+does not change the frozen Scenario-C DVL plugin or campaign.
+"""
+from __future__ import annotations
+
+from collections import deque
+from dataclasses import dataclass
+
+import numpy as np
+
+
+@dataclass(frozen=True)
+class DVLRobustnessConfig:
+    noise_std_mps: float = 0.002
+    constant_bias_mps: tuple = (0.0, 0.0, 0.0)
+    bias_random_walk_mps_sqrt_s: float = 0.0002
+    scale_error_fraction: float = 0.001
+    latency_s: float = 0.004
+    minimum_altitude_m: float = 0.05
+    maximum_altitude_m: float = 50.0
+    recovery_confirmations: int = 2
+
+    def __post_init__(self):
+        if self.noise_std_mps < 0 or self.bias_random_walk_mps_sqrt_s < 0:
+            raise ValueError("noise parameters must be nonnegative")
+        if self.latency_s < 0 or self.recovery_confirmations < 1:
+            raise ValueError("latency must be nonnegative and confirmations positive")
+
+
+class DVLRobustnessModel:
+    def __init__(self, config: DVLRobustnessConfig, seed: int = 0) -> None:
+        self.config = config
+        self._seed = seed
+        self.reset(seed)
+
+    def reset(self, seed: int | None = None) -> None:
+        self._rng = np.random.default_rng(self._seed if seed is None else seed)
+        self._drift = np.zeros(3)
+        self._queue = deque()
+        self._live_count = 0
+
+    def update(self, acquisition_t: float, velocity_body: np.ndarray,
+               altitude_m: float, beams_locked: int, dt: float,
+               forced_dropout: bool = False):
+        physically_locked = (not forced_dropout and beams_locked >= 3 and
+                             self.config.minimum_altitude_m <= altitude_m <=
+                             self.config.maximum_altitude_m)
+        self._live_count = self._live_count + 1 if physically_locked else 0
+        valid = self._live_count >= self.config.recovery_confirmations
+        if physically_locked:
+            self._drift += self._rng.normal(
+                0.0, self.config.bias_random_walk_mps_sqrt_s * np.sqrt(max(dt, 0.0)), 3)
+            measured = ((1.0 + self.config.scale_error_fraction)
+                        * np.asarray(velocity_body, float)
+                        + np.asarray(self.config.constant_bias_mps)
+                        + self._drift
+                        + self._rng.normal(0.0, self.config.noise_std_mps, 3))
+            self._queue.append((float(acquisition_t) + self.config.latency_s,
+                                float(acquisition_t), measured, valid))
+        delivered = None
+        now = float(acquisition_t)
+        while self._queue and self._queue[0][0] <= now + 1e-12:
+            delivered = self._queue.popleft()
+        if delivered is None:
+            return None
+        delivery_t, acquired_t, value, was_valid = delivered
+        return {"velocity": value, "valid": bool(was_valid),
+                "acquisition_t": acquired_t, "delivery_t": delivery_t,
+                "age_s": delivery_t - acquired_t}
diff --git a/src/uuv_sim_physics/uuv_sim_physics/sensors/fls_realism.py b/src/uuv_sim_physics/uuv_sim_physics/sensors/fls_realism.py
new file mode 100644
index 00000000..03781328
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/sensors/fls_realism.py
@@ -0,0 +1,77 @@
+"""Additive, configurable observation effects for a 1-D forward-looking sonar.
+
+This does not alter the frozen Scenario-C ray sensor.  A caller must opt in and
+provide only the acquired range sweep; no scene truth is accepted.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+
+
+@dataclass(frozen=True)
+class FLSRealismConfig:
+    angular_resolution_rad: float = np.deg2rad(0.8)
+    range_resolution_m: float = 0.025
+    range_noise_std_m: float = 0.01
+    dropout_probability: float = 0.01
+    partial_support_min_rays: int = 3
+    ambiguous_return_probability: float = 0.0
+    ambiguous_offset_m: float = 0.25
+
+    def __post_init__(self):
+        if self.range_resolution_m <= 0 or self.range_noise_std_m < 0:
+            raise ValueError("range resolution must be positive and noise nonnegative")
+        for value in (self.dropout_probability, self.ambiguous_return_probability):
+            if not 0.0 <= value <= 1.0:
+                raise ValueError("probabilities must be in [0,1]")
+        if self.partial_support_min_rays < 1:
+            raise ValueError("partial support must be positive")
+
+
+class FLSObservationModel:
+    """Post-process a finite ray sweep using sensor-domain effects only."""
+
+    def __init__(self, config: FLSRealismConfig, seed: int = 0) -> None:
+        self.config = config
+        self._rng = np.random.default_rng(seed)
+
+    def reset(self, seed: int) -> None:
+        self._rng = np.random.default_rng(seed)
+
+    def observe(self, ranges: np.ndarray, angle_min: float,
+                angle_max: float) -> tuple[np.ndarray, np.ndarray, dict]:
+        ranges = np.asarray(ranges, float).copy()
+        if ranges.ndim != 1 or ranges.size < 2:
+            raise ValueError("FLS sweep must be a one-dimensional ray array")
+        separation = (float(angle_max) - float(angle_min)) / (ranges.size - 1)
+        if separation + 1e-12 < self.config.angular_resolution_rad:
+            stride = max(1, int(np.ceil(self.config.angular_resolution_rad / separation)))
+            # Finite beam footprint: one return represents the nearest support
+            # within the corresponding angular cell, then is repeated across it.
+            for start in range(0, ranges.size, stride):
+                cell = ranges[start:start + stride]
+                finite = cell[np.isfinite(cell)]
+                ranges[start:start + stride] = finite.min() if finite.size else np.inf
+        valid = np.isfinite(ranges) & (ranges > 0.0)
+        support_before = int(valid.sum())
+        if valid.any() and self.config.range_noise_std_m:
+            ranges[valid] += self._rng.normal(0.0, self.config.range_noise_std_m,
+                                              int(valid.sum()))
+        if valid.any() and self.config.ambiguous_return_probability:
+            ambiguity = valid & (self._rng.random(ranges.size) <
+                                 self.config.ambiguous_return_probability)
+            ranges[ambiguity] = np.maximum(
+                self.config.range_resolution_m,
+                ranges[ambiguity] + self._rng.choice((-1.0, 1.0), ambiguity.sum())
+                * self.config.ambiguous_offset_m)
+        if self.config.dropout_probability:
+            valid &= self._rng.random(ranges.size) >= self.config.dropout_probability
+        ranges[valid] = (np.round(ranges[valid] / self.config.range_resolution_m)
+                         * self.config.range_resolution_m)
+        ranges[~valid] = np.inf
+        adequate = int(valid.sum()) >= self.config.partial_support_min_rays
+        return ranges.astype(np.float32), valid, {
+            "support_before": support_before, "support_after": int(valid.sum()),
+            "adequate_support": adequate, "angular_separation_rad": separation}
diff --git a/src/uuv_sim_physics/uuv_sim_physics/sensors/lighting.py b/src/uuv_sim_physics/uuv_sim_physics/sensors/lighting.py
new file mode 100644
index 00000000..3e5e8f0e
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/sensors/lighting.py
@@ -0,0 +1,140 @@
+"""Vehicle lighting and backscatter for the underwater camera.
+
+**Additive and off by default.** ``sensors/optical.py`` is untouched, and
+``LightingModel.disabled()`` reproduces its output bit-for-bit. Only a profile
+that explicitly enables lighting sees any difference.
+
+Why this exists
+---------------
+The existing optical model attenuates a frame over a scalar standoff and has no
+light source at all. That is adequate while perception has a sonar to fall back
+on, but a stock-sensing vehicle has only its camera, and a real ROV *illuminates
+its own scene*. In turbid water the lamps backscatter off the particles between
+camera and target, producing a veiling glow that destroys near-field contrast --
+the "high beams in fog" effect. Modelling attenuation without it makes turbid
+water look uniformly dark when in reality it looks uniformly bright and flat.
+
+Model
+-----
+A reduced Jaffe-McGlamery image formation:
+
+    I(r) = I_direct(r) + I_selfluminous(r) + I_backscatter(r)
+
+    I_direct(r)       = L_scene * E(r) * exp(-c*r)
+    I_selfluminous(r) = L_marker * exp(-c*r)
+    I_backscatter(r)  = B_inf * (1 - exp(-k_b * c * r))
+
+with irradiance falling off as ``E(r) = P / (1 + (r/r0)^2)`` and veiling
+radiance ``B_inf = k_v * P * omega``, where ``omega = b/c`` is the single
+scattering albedo.
+
+Two behaviours matter for docking and both are deliberate:
+
+* **Backscatter rises with lamp power and with turbidity.** Turning the lights
+  up in turbid water makes things worse, which is what operators observe.
+* **Self-luminous features survive it.** The dock's LED constellation emits
+  rather than reflects, so it is attenuated but not washed out by the vehicle's
+  own veiling light. That is precisely why docking stations carry LED
+  constellations, and a model without this term would misrepresent the whole
+  optical docking problem.
+
+Lamp-camera separation suppresses backscatter, because the overlap between the
+illuminated cone and the camera's view cone shrinks. ``separation_m`` reduces
+``B_inf`` accordingly, so a profile that mounts its lamps outboard is rewarded.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+
+__all__ = ["LightingModel", "LightingConfig"]
+
+
+@dataclass(frozen=True)
+class LightingConfig:
+    """All-zero lamp power is the default and is a no-op."""
+    #: Total lamp radiant power, arbitrary units matched to image scale.
+    lamp_power: float = 0.0
+    #: Distance at which direct irradiance has fallen by half.
+    falloff_reference_m: float = 1.0
+    #: Single-scattering albedo b/c. Higher means more scattering per
+    #: extinction, i.e. more backscatter for the same attenuation.
+    scattering_albedo: float = 0.8
+    #: Veiling-radiance scale.
+    veiling_gain: float = 0.55
+    #: Rate at which backscatter saturates with optical depth.
+    backscatter_rate: float = 1.0
+    #: Lamp-camera separation. Larger separation means less shared volume
+    #: between the illuminated cone and the view cone, so less veiling light.
+    separation_m: float = 0.0
+    #: Separation scale over which the suppression acts.
+    separation_scale_m: float = 0.15
+
+    @property
+    def enabled(self) -> bool:
+        return self.lamp_power > 0.0
+
+
+class LightingModel:
+    """Applies illumination and veiling backscatter to an attenuated frame."""
+
+    def __init__(self, config: LightingConfig | None = None) -> None:
+        self.config = config or LightingConfig()
+
+    @classmethod
+    def disabled(cls) -> "LightingModel":
+        return cls(LightingConfig(lamp_power=0.0))
+
+    # -- components ------------------------------------------------------
+
+    def irradiance(self, range_m: float) -> float:
+        """Direct illumination reaching the scene, normalised to 1 at r = 0."""
+        cfg = self.config
+        if not cfg.enabled:
+            return 1.0
+        return float(cfg.lamp_power / (1.0 + (range_m / cfg.falloff_reference_m) ** 2))
+
+    def veiling_radiance(self, beam_attenuation: float, range_m: float) -> float:
+        """Backscattered radiance from the vehicle's own lamps, in [0, 255]."""
+        cfg = self.config
+        if not cfg.enabled:
+            return 0.0
+        suppression = 1.0 / (1.0 + (cfg.separation_m / cfg.separation_scale_m) ** 2)
+        b_inf = (cfg.veiling_gain * cfg.lamp_power * cfg.scattering_albedo
+                 * suppression)
+        optical_depth = max(float(beam_attenuation), 0.0) * max(float(range_m), 0.0)
+        return float(255.0 * b_inf
+                     * (1.0 - np.exp(-cfg.backscatter_rate * optical_depth)))
+
+    # -- application -----------------------------------------------------
+
+    def apply(self, attenuated: np.ndarray, beam_attenuation: float,
+              range_m: float, self_luminous_mask: np.ndarray | None = None
+              ) -> np.ndarray:
+        """Add illumination and veiling light to an already-attenuated frame.
+
+        ``attenuated`` is the output of the existing ``degrade()``. When
+        lighting is disabled this returns it **unchanged**, which is what keeps
+        every existing result reproducible.
+
+        ``self_luminous_mask`` marks pixels that emit rather than reflect. Those
+        pixels are not scaled by irradiance and receive no veiling light, so an
+        LED constellation stays visible through backscatter that flattens the
+        reflective structure around it.
+        """
+        if not self.config.enabled:
+            return attenuated
+
+        frame = attenuated.astype(np.float32)
+        lit = frame * self.irradiance(range_m)
+        veil = self.veiling_radiance(beam_attenuation, range_m)
+        out = lit + veil
+
+        if self_luminous_mask is not None:
+            mask = np.asarray(self_luminous_mask, dtype=bool)
+            if mask.ndim == 2 and frame.ndim == 3:
+                mask = mask[:, :, None]
+            out = np.where(mask, frame, out)
+
+        return np.clip(out, 0.0, 255.0).astype(np.uint8)
diff --git a/src/uuv_sim_physics/uuv_sim_physics/sensors/nephelometer.py b/src/uuv_sim_physics/uuv_sim_physics/sensors/nephelometer.py
