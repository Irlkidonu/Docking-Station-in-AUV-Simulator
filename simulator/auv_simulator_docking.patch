@@ -0,0 +1,58 @@
+"""Reusable autonomous docking capability.
+
+An **additive** extension: nothing outside this package imports it, and no
+existing simulator behaviour, world, configuration, interface or baseline
+depends on it. Existing launch paths work exactly as before whether or not this
+package is present.
+
+    from uuv_sim_physics.docking import (
+        platform_geometry, DockingRunConfig, run_docking,
+        Observation, DockRelativeEstimate, PerceptionProvider)
+
+The platform provides execution, geometry, sensing, control and outcome
+classification. A study provides a ``PerceptionProvider`` and its own thresholds,
+scenario definitions and analysis.
+
+Imports are lazy: ``geometry`` and the estimators are pure numpy, while the
+runner needs the Gazebo transport bindings, so importing this package does not
+require a simulator to be installed.
+"""
+from __future__ import annotations
+
+__all__ = [
+    "platform_geometry", "PlatformGeometry", "DockGeometry", "VehicleGeometry",
+    "SonarGeometry", "wrap_angle", "yaw_from_quaternion", "relative_pose",
+    "derived_quantities",
+    "Observation", "DockRelativeEstimate", "PerceptionProvider",
+    "StandoffTracker", "StandoffPolicy", "StandoffReading",
+    "FLSRangeEstimator", "FLSRangeConfig", "FLSRangeFix",
+    "TerminalEstimator", "TerminalConfig", "TerminalState",
+    "DockingThresholds", "Thresholds", "classify", "TrialOutcome", "zone_of",
+    "variant_for", "downsample",
+    "OracleProvider", "TerminalNavigationProvider", "HandoverProvider",
+    "DockingRunConfig", "DockingRunRecord", "run_docking",
+]
+
+from .camera import downsample
+from .fls_range import FLSRangeConfig, FLSRangeEstimator, FLSRangeFix
+from .geometry import (DockGeometry, PlatformGeometry, SonarGeometry,
+                       VehicleGeometry, derived_quantities, platform_geometry,
+                       relative_pose, wrap_angle, yaw_from_quaternion)
+from .interfaces import DockRelativeEstimate, Observation, PerceptionProvider
+from .outcome import (DockingThresholds, Thresholds, TrialOutcome, classify,
+                      zone_of)
+from .standoff import StandoffPolicy, StandoffReading, StandoffTracker
+from .terminal_estimator import TerminalConfig, TerminalEstimator, TerminalState
+from .world_variants import variant_for
+
+
+def __getattr__(name):
+    """Lazily expose the pieces that need the Gazebo transport bindings."""
+    if name in ("DockingRunConfig", "DockingRunRecord", "run_docking"):
+        from . import runner
+        return getattr(runner, name)
+    if name in ("OracleProvider", "TerminalNavigationProvider",
+                "HandoverProvider"):
+        from . import providers
+        return getattr(providers, name)
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
diff --git a/src/uuv_sim_physics/uuv_sim_physics/docking/autonomy.py b/src/uuv_sim_physics/uuv_sim_physics/docking/autonomy.py
