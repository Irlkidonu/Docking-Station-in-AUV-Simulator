+"""Opt-in Oculus-M750d-class multibeam acoustic-image simulator.
+
+The renderer accepts ray/geometry intersections because those belong to the
+simulated sensor physics.  It emits only quantised intensity bins and a
+detection mask.  Downstream perception never receives the intersection ranges.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+
+
+def francois_garrison_absorption_db_per_km(
+        frequency_khz: float, temperature_c: float = 10.0,
+        salinity_psu: float = 35.0, depth_m: float = 15.0,
+        ph: float = 8.0) -> float:
+    """Francois--Garrison seawater absorption for f > 500 kHz."""
+    f = float(frequency_khz)
+    t = float(temperature_c)
+    s = float(salinity_psu)
+    d = float(depth_m)
+    tk = 273.0 + t
+    sound_speed = 1412.0 + 3.21 * t + 1.19 * s + 0.0167 * d
+    a1 = 8.86 / sound_speed * 10.0 ** (0.78 * ph - 5.0)
+    f1 = 2.8 * np.sqrt(s / 35.0) * 10.0 ** (4.0 - 1245.0 / tk)
+    boric = a1 * f1 * f * f / (f1 * f1 + f * f)
+    a2 = 21.44 * s / sound_speed * (1.0 + 0.025 * t)
+    f2 = 8.17 * 10.0 ** (8.0 - 1990.0 / tk) / (1.0 + 0.0018 * (s - 35.0))
+    p2 = 1.0 - 1.37e-4 * d + 6.2e-9 * d * d
+    magnesium = a2 * p2 * f2 * f * f / (f2 * f2 + f * f)
+    a3 = (3.7e-7 - 2.59e-8 * t + 9.11e-10 * t * t
+          - 1.5e-11 * t * t * t)
+    p3 = 1.0 - 3.83e-5 * d + 4.9e-10 * d * d
+    pure_water = a3 * p3 * f * f
+    return float(boric + magnesium + pure_water)
+
+
+@dataclass(frozen=True)
+class OculusM750dConfig:
+    frequency_khz: float = 750.0
+    horizontal_aperture_deg: float = 130.0
+    vertical_aperture_deg: float = 20.0
+    beams: int = 512
+    beam_separation_deg: float = 0.25
+    angular_resolution_deg: float = 1.0
+    minimum_range_m: float = 0.1
+    device_maximum_range_m: float = 120.0
+    active_range_m: float = 12.0
+    range_resolution_m: float = 0.004
+    update_rate_hz: float = 40.0
+    temperature_c: float = 10.0
+    salinity_psu: float = 35.0
+    depth_m: float = 15.0
+    ph: float = 8.0
+    # Receiver/source calibration is unavailable in the public manufacturer
+    # spec. These dimensionless values are explicit assumptions, not device
+    # claims, and are frozen before any docking sensitivity result.
+    unit_echo_at_1m: float = 1.0
+    receiver_noise_std: float = 2e-5
+    detection_snr: float = 4.0
+    intensity_gamma: float = 0.45
+    dropout_probability: float = 0.0
+    multipath_probability: float = 0.0
+    multipath_extra_range_m: float = 0.5
+    multipath_attenuation: float = 0.15
+
+    def __post_init__(self):
+        if self.beams != 512:
+            raise ValueError("frozen M750d model requires 512 beams")
+        if not 0 < self.active_range_m <= self.device_maximum_range_m:
+            raise ValueError("active range exceeds the selected device")
+        if self.range_resolution_m <= 0 or self.receiver_noise_std < 0:
+            raise ValueError("invalid receiver resolution/noise")
+
+    @property
+    def bins(self) -> int:
+        return int(np.floor(self.active_range_m / self.range_resolution_m)) + 1
+
+
+@dataclass(frozen=True)
+class AcousticImage:
+    intensity: np.ndarray
+    detection: np.ndarray
+    range_resolution_m: float
+    angle_min_rad: float
+    angle_step_rad: float
+    acquisition_t: float
+
+
+class OculusM750dRenderer:
+    """Convert finite 3-D beam intersections into a fan intensity image."""
+
+    def __init__(self, config: OculusM750dConfig = OculusM750dConfig(),
+                 seed: int = 0) -> None:
+        self.config = config
+        self.reset(seed)
+
+    def reset(self, seed: int) -> None:
+        self._rng = np.random.default_rng(seed)
+
+    def render(self, intersection_ranges_m: np.ndarray,
+               incidence_cosine: np.ndarray | None = None,
+               target_strength: np.ndarray | None = None,
+               acquisition_t: float = 0.0) -> AcousticImage:
+        """Render vertical-rays x 512-beams geometry to uint8 intensities.
+
+        Each input ray contains its nearest physical intersection, which gives
+        geometric shadowing. Multiple vertical rays create finite vertical
+        aperture and partial-insonification behavior. Lambertian incidence,
+        spherical spreading, two-way absorption, coherent speckle, receiver
+        noise, finite beam width, range bins, dropout, and optional delayed
+        multipath are applied before quantisation.
+        """
+        ranges = np.asarray(intersection_ranges_m, float)
+        if ranges.ndim != 2 or ranges.shape[1] != self.config.beams:
+            raise ValueError("intersection grid must be vertical_rays x 512")
+        incidence = (np.ones_like(ranges) if incidence_cosine is None
+                     else np.asarray(incidence_cosine, float))
+        strength = (np.ones_like(ranges) if target_strength is None
+                    else np.asarray(target_strength, float))
+        if incidence.shape != ranges.shape or strength.shape != ranges.shape:
+            raise ValueError("incidence and target strength must match intersections")
+
+        image = np.zeros((self.config.beams, self.config.bins), dtype=float)
+        valid = (np.isfinite(ranges) & (ranges >= self.config.minimum_range_m) &
+                 (ranges <= self.config.active_range_m) & (incidence > 0) &
+                 (strength > 0))
+        absorption = francois_garrison_absorption_db_per_km(
+            self.config.frequency_khz, self.config.temperature_c,
+            self.config.salinity_psu, self.config.depth_m, self.config.ph) / 1000.0
+        for vertical, beam in zip(*np.nonzero(valid)):
+            r = float(ranges[vertical, beam])
+            # Two-way spherical spreading and absorption. Target strength uses
+            # a Lambertian incidence proxy following physics-based MBES models.
+            transmission = 10.0 ** (-(2.0 * absorption * r) / 10.0)
+            echo = (self.config.unit_echo_at_1m * float(strength[vertical, beam])
+                    * float(incidence[vertical, beam]) * transmission
+                    / max(r * r, 1e-9))
+            echo *= float(self._rng.rayleigh(scale=1.0 / np.sqrt(2.0)))
+            index = min(int(round(r / self.config.range_resolution_m)),
+                        self.config.bins - 1)
+            image[beam, index] += echo
+            if (self.config.multipath_probability and
+                    self._rng.random() < self.config.multipath_probability):
+                delayed = r + self.config.multipath_extra_range_m
+                if delayed <= self.config.active_range_m:
+                    j = int(round(delayed / self.config.range_resolution_m))
+                    image[beam, j] += echo * self.config.multipath_attenuation
+
+        # Receive beam is wider than beam separation; a Gaussian azimuthal
+        # point-spread function represents overlapping formed beams.
+        sigma_beams = (self.config.angular_resolution_deg /
+                       self.config.beam_separation_deg / 2.355)
+        radius = max(1, int(np.ceil(3 * sigma_beams)))
+        offsets = np.arange(-radius, radius + 1)
+        kernel = np.exp(-0.5 * (offsets / sigma_beams) ** 2)
+        kernel /= kernel.sum()
+        blurred = np.zeros_like(image)
+        padded = np.pad(image, ((radius, radius), (0, 0)))
+        for i, weight in enumerate(kernel):
+            blurred += weight * padded[i:i + self.config.beams]
+        image = blurred
+        if self.config.dropout_probability:
+            dead = self._rng.random(self.config.beams) < self.config.dropout_probability
+            image[dead] = 0.0
+        image += self._rng.normal(0.0, self.config.receiver_noise_std, image.shape)
+        image = np.maximum(image, 0.0)
+        detection = ((image > 0.0) &
+                     (image >= self.config.detection_snr *
+                      self.config.receiver_noise_std))
+        # Log-like/gamma display compression followed by finite 8-bit output.
+        reference = max(self.config.unit_echo_at_1m, 1e-12)
+        display = np.clip(image / reference, 0.0, 1.0) ** self.config.intensity_gamma
+        quantized = np.round(display * 255.0).astype(np.uint8)
+        return AcousticImage(
+            quantized, detection,
+            self.config.range_resolution_m,
+            np.deg2rad(-0.5 * self.config.horizontal_aperture_deg),
+            np.deg2rad(self.config.beam_separation_deg), float(acquisition_t))
+
+
+def extract_observable_features(image: AcousticImage) -> dict:
+    """Range/bearing/support derived only from acoustic-image detections."""
+    rows, bins = np.nonzero(image.detection)
+    if rows.size == 0:
+        return {"valid": False, "range_m": np.nan, "bearing_rad": np.nan,
+                "beam_support": 0, "intensity_sum": 0.0}
+    weights = image.intensity[rows, bins].astype(float) + 1.0
+    ranges = bins * image.range_resolution_m
+    bearings = image.angle_min_rad + rows * image.angle_step_rad
+    # Near support dominates a docking return; the weighted median is robust to
+    # delayed ambiguous/multipath energy without accessing renderer ranges.
+    order = np.argsort(ranges)
+    cumulative = np.cumsum(weights[order])
+    median_index = order[np.searchsorted(cumulative, 0.5 * cumulative[-1])]
+    near = np.abs(ranges - ranges[median_index]) <= 0.10
+    return {"valid": bool(np.unique(rows[near]).size >= 3),
+            "range_m": float(np.average(ranges[near], weights=weights[near])),
+            "bearing_rad": float(np.average(bearings[near], weights=weights[near])),
+            "beam_support": int(np.unique(rows[near]).size),
+            "intensity_sum": float(weights[near].sum())}
