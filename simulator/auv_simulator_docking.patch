@@ -0,0 +1,378 @@
+"""Reduced C0 Heavy platform battery -- open-loop plant sanity + closed loop.
+
+SCOPE. Stock C0 carries camera, IMU/AHRS and a Bar30 only. Nothing in that suite
+measures horizontal position, so this battery deliberately does NOT test
+horizontal waypoint or full 6-DoF pose hold, and no result here should be read
+as evidence that it does. Truth scores open-loop displacement and plant
+response; it is never operational feedback.
+"""
+from __future__ import annotations
+
+import math
+import os
+import signal
+import re
+import subprocess
+import uuid
+from pathlib import Path
+import time
+from dataclasses import dataclass, field
+
+import numpy as np
+
+from .. import toolchain
+from ..control.heavy_allocation import HeavyAllocator
+
+HARDWARE_TRANSFER_EVIDENCE = True     # every check here uses stock sensors only
+
+
+@dataclass
+class Check:
+    name: str
+    passed: bool
+    detail: str
+    metrics: dict = field(default_factory=dict)
+
+    def as_dict(self) -> dict:
+        return {"name": self.name, "verdict": "PASS" if self.passed else "FAIL",
+                "detail": self.detail, "metrics": self.metrics}
+
+
+def _rpy(q) -> tuple[float, float, float]:
+    w, x, y, z = q
+    return (math.atan2(2 * (w * x + y * z), 1 - 2 * (x * x + y * y)),
+            math.asin(max(-1.0, min(1.0, 2 * (w * y - z * x)))),
+            math.atan2(2 * (w * z + x * y), 1 - 2 * (y * y + z * z)))
+
+
+BASE_WORLD = "auv_sim_physics_validated"
+BASE_MODEL = "bluerov2_heavy"
+
+
+class NamespaceContaminated(RuntimeError):
+    """Raised when a run namespace is not exclusively ours."""
+
+
+def isolated_world(src: Path, token: str, dest_dir: Path) -> tuple[Path, str]:
+    """Rewrite a Heavy world so its world, model and topics are unique.
+
+    Isolation is by CONSTRUCTION, not by cleanup. Two Gate-5 runs were
+    invalidated by servers sharing ``/bluerov2_heavy/...``: once by concurrent
+    plants, once by a server that leaked and lived 14 minutes. Cleanup failed
+    twice, so the namespace itself is now unique per run and a stray server
+    cannot be heard even if it survives.
+    """
+    text = src.read_text()
+    ns = f"hv_{token}"
+    text = text.replace(f'<world name="{BASE_WORLD}">', f'<world name="{ns}">')
+    # both the open and self-closing forms: the rewrite must not be silently
+    # form-specific, or a differently-formatted world would fail isolation.
+    text = text.replace(f'<model name="{BASE_MODEL}">', f'<model name="{ns}">')
+    text = text.replace(f'<model name="{BASE_MODEL}"/>', f'<model name="{ns}"/>')
+    text = text.replace(f'<model name="{BASE_MODEL}" ', f'<model name="{ns}" ')
+    text = text.replace(f"<namespace>{BASE_MODEL}</namespace>", f"<namespace>{ns}</namespace>")
+    text = text.replace(f"/{BASE_MODEL}/", f"/{ns}/")
+    # Buoyancy <enable> entries scope links as "model::link". Missing these
+    # would rename the model while leaving the buoyancy system scoped to a model
+    # that no longer exists -- the vehicle would simply sink. The completeness
+    # assertion below is what caught this.
+    text = text.replace(f"{BASE_MODEL}::", f"{ns}::")
+    if BASE_MODEL in text:
+        raise NamespaceContaminated(
+            f"world still references '{BASE_MODEL}' after rewrite; isolation is incomplete")
+    out = dest_dir / f"world_{ns}.sdf"
+    out.write_text(text)
+    return out, ns
+
+
+def namespace_topics(ns: str) -> list[str]:
+    """Live topics currently advertised under this run namespace."""
+    try:
+        listing = subprocess.run([str(toolchain.GZ_EXECUTABLE), "topic", "-l"],
+                                 capture_output=True, text=True, timeout=15).stdout
+    except (subprocess.TimeoutExpired, OSError):
+        return []
+    return [t for t in listing.splitlines()
+            if f"/{ns}/" in t or t.endswith(f"/{ns}") or f"/world/{ns}/" in t]
+
+
+class HeavyPlant:
+    """One Gazebo session in its own namespace and process group."""
+
+    def __init__(self, world: Path, vehicle, settle_s: float = 4.0,
+                 token: str | None = None, scratch: Path | None = None,
+                 assert_clean: bool = True):
+        from gz.transport13 import Node
+        from gz.msgs10.pose_v_pb2 import Pose_V
+        from gz.msgs10.imu_pb2 import IMU
+        from gz.msgs10.double_pb2 import Double
+
+        self.token = token or f"{os.getpid()}_{uuid.uuid4().hex[:8]}"
+        scratch = Path(scratch or world.parent)
+        self.world, self.ns = isolated_world(Path(world), self.token, scratch)
+        if assert_clean and namespace_topics(self.ns):
+            raise NamespaceContaminated(
+                f"namespace {self.ns} already has publishers before start")
+
+        self.vehicle = vehicle
+        self.joints = [u["joint"] for u in vehicle["thrusters"]["units"]]
+        self.truth: list = []
+        self.imu: list = []
+        self.rejected = 0            # messages seen that were not ours
+        args = [str(toolchain.GZ_EXECUTABLE), "sim", "-s", "-r", "-v", "0", str(self.world)]
+        self.server = subprocess.Popen(
+            args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
+            env=os.environ.copy(), start_new_session=True)
+        self.pgid = os.getpgid(self.server.pid)
+        self.node = Node()
+        st = lambda h: h.stamp.sec + h.stamp.nsec * 1e-9
+
+        def on_pose(m):
+            for pz in m.pose:
+                if pz.name == self.ns:
+                    self.truth.append(
+                        (st(m.header),
+                         np.array([pz.position.x, pz.position.y, pz.position.z]),
+                         np.array([pz.orientation.w, pz.orientation.x,
+                                   pz.orientation.y, pz.orientation.z])))
+                    if len(self.truth) > 20000:
+                        del self.truth[:-20000]
+                elif pz.name.startswith("hv_"):
+                    self.rejected += 1
+
+        def on_imu(m):
+            o = m.orientation
+            self.imu.append((st(m.header), (o.w, o.x, o.y, o.z),
+                             np.array([m.angular_velocity.x, m.angular_velocity.y,
+                                       m.angular_velocity.z])))
+            if len(self.imu) > 20000:
+                del self.imu[:-20000]
+
+        deadline = time.time() + 40
+        for T, topic, cb in ((Pose_V, f"/world/{self.ns}/dynamic_pose/info", on_pose),
+                             (IMU, f"/{self.ns}/imu", on_imu)):
+            while not self.node.subscribe(T, topic, cb):
+                if time.time() > deadline:
+                    raise RuntimeError(f"subscribe {topic}")
+                time.sleep(0.2)
+        self.pubs = {j: self.node.advertise(
+            f"/model/{self.ns}/joint/{j}/cmd_thrust", Double) for j in self.joints}
+        self._Double = Double
+        while not self.truth and time.time() < deadline:
+            time.sleep(0.1)
+        if not self.truth:
+            raise RuntimeError(f"no truth pose on {self.ns}; plant did not start")
+        time.sleep(settle_s)
+
+    def command(self, thrusts) -> None:
+        m = self._Double()
+        for j, t in zip(self.joints, thrusts):
+            m.data = float(t)
+            self.pubs[j].publish(m)
+
+    def hold(self, thrusts, seconds: float):
+        """Command a constant thrust for `seconds` of SIM time.
+
+        Reports how long the command was actually active in simulation time and
+        how many messages were delivered, so a collapsed command window cannot
+        be mistaken for a plant response.
+        """
+        t0 = self.truth[-1][0]
+        start_len = len(self.truth)
+        n_pub = 0
+        wall0 = time.monotonic()
+        while self.truth[-1][0] - t0 < seconds:
+            self.command(thrusts)
+            n_pub += 1
+            time.sleep(0.02)
+            if time.monotonic() - wall0 > 4 * seconds + 60:
+                break
+        t1 = self.truth[-1][0]
+        self.command([0.0] * len(self.joints))
+        self.last_hold = {
+            "sim_seconds_requested": seconds,
+            "sim_seconds_active": round(t1 - t0, 4),
+            "commands_published": n_pub,
+            "wall_seconds": round(time.monotonic() - wall0, 3),
+            "sim_start": round(t0, 4), "sim_end": round(t1, 4),
+            "truth_samples_gained": len(self.truth) - start_len,
+            "foreign_messages_rejected": self.rejected,
+        }
+        return list(self.truth[start_len:])
+
+    def state(self):
+        t, x, q = self.truth[-1]
+        return t, x.copy(), _rpy(q)
+
+    def close(self, assert_gone: bool = True) -> None:
+        """Hard-kill the whole process group, then prove the namespace is gone."""
+        try:
+            self.command([0.0] * len(self.joints))
+        except Exception:
+            pass
+        try:
+            owns_group = (self.pgid == self.server.pid and
+                          os.getsid(self.server.pid) == self.server.pid and
+                          self.pgid != os.getpgrp())
+            if owns_group:
+                os.killpg(self.pgid, signal.SIGKILL)
+            else:
+                self.server.terminate()
+        except (ProcessLookupError, PermissionError):
+            self.server.terminate()
+        try:
+            self.server.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            pass
+        if assert_gone:
+            # Authoritative test: is any process of this run's group still alive?
+            # gz-transport's discovery cache keeps advertising a dead process's
+            # topics for a while, so `gz topic -l` is a laggy secondary signal,
+            # not proof of a leak. Asserting on it produced a false positive
+            # while pgrep showed the group had been fully reaped.
+            for _ in range(20):
+                if not self.group_alive():
+                    return
+                time.sleep(0.5)
+            raise NamespaceContaminated(
+                f"process group {self.pgid} for {self.ns} survived close")
+
+    def group_alive(self) -> list[str]:
+        """PIDs still belonging to this run's process group."""
+        try:
+            out = subprocess.run(["pgrep", "-g", str(self.pgid)],
+                                 capture_output=True, text=True, timeout=10).stdout
+        except (subprocess.TimeoutExpired, OSError):
+            return []
+        return [x for x in out.split() if x and int(x) != os.getpid()]
+
+
+def body_speed(plant) -> float:
+    """Linear speed from truth (scoring use only)."""
+    if len(plant.truth) < 6:
+        return 1.0
+    (t1, x1, _), (t0, x0, _) = plant.truth[-1], plant.truth[-6]
+    return float(np.linalg.norm((x1 - x0) / max(t1 - t0, 1e-6)))
+
+
+def body_omega(plant) -> float:
+    """Angular speed from the IMU -- a real stock C0 sensor."""
+    return float(np.linalg.norm(plant.imu[-1][2])) if plant.imu else 1.0
+
+
+def settle(plant, seconds: float = 6.0, tol: float = 0.01,
+           wtol: float = math.radians(0.5), max_s: float = 90.0) -> None:
+    """Coast to rest in BOTH translation and rotation.
+
+    Settling on linear speed alone was the Gate-5 reproducibility defect. A pure
+    surge command leaves the vehicle yawing; a body still rotating sweeps the
+    next body-frame command through world frame, so most of its displacement
+    cancels. That made an identical sway command read 1.88 m in a fresh session
+    and 0.17 m as test #2 -- an 11x spread with an identical command window
+    (3.006 s of sim time, 174 messages, no clock gaps). Waiting on angular
+    velocity as well brings the two to within 0.30 %.
+    """
+    t0 = plant.truth[-1][0]
+    while plant.truth[-1][0] - t0 < max_s:
+        plant.command([0.0] * len(plant.joints))
+        time.sleep(0.02)
+        if (plant.truth[-1][0] - t0 >= seconds
+                and body_speed(plant) < tol and body_omega(plant) < wtol):
+            return
+
+
+def finite(rows) -> bool:
+    return all(np.all(np.isfinite(p)) and np.all(np.isfinite(q)) for _, p, q in rows)
+
+# --- free-water guard -------------------------------------------------------
+# Gate-5 case 3 of a shared-plant battery measured 0.19 m instead of 2.27 m
+# because cumulative surge had driven the vehicle into the docking station. An
+# obstructed stroke is not a plant response, so every open-loop case now proves
+# it ran in free water instead of assuming it.
+
+FREE_WATER_MARGIN_M = 1.5      # declared: >= half the longest 3 s stroke (2.29 m)
+SETTLED_SPEED_MPS = 0.01       # same tolerance settle() uses
+SETTLED_OMEGA_RAD = math.radians(0.5)
+
+
+class NotFreeWater(RuntimeError):
+    """Raised when a case cannot be measured in open water."""
+
+
+def world_obstacles(world: Path) -> list[tuple[str, np.ndarray]]:
+    """Positions of every non-vehicle model in the world."""
+    text = Path(world).read_text()
+    out = []
+    for m in re.finditer(r'<model name="([^"]+)">(.*?)\n    </model>', text, re.S):
+        name, body = m.group(1), m.group(2)
+        if name.startswith("hv_"):
+            continue
+        pm = re.search(r"<pose>([^<]+)</pose>", body)
+        if pm:
+            out.append((name, np.array([float(x) for x in pm.group(1).split()[:3]])))
+    return out
+
+
+def free_water_report(plant, margin_m: float = FREE_WATER_MARGIN_M) -> dict:
+    """Distance to every obstacle, plus settled-state and finiteness checks."""
+    _, pos, rpy = plant.state()
+    obstacles = world_obstacles(plant.world)
+    dists = {n: float(np.linalg.norm(pos - q)) for n, q in obstacles}
+    nearest = min(dists.items(), key=lambda kv: kv[1]) if dists else ("none", 1e9)
+    spd, om = body_speed(plant), body_omega(plant)
+    return {
+        "position": pos.tolist(),
+        "nearest_obstacle": nearest[0],
+        "nearest_distance_m": round(nearest[1], 4),
+        "margin_m": margin_m,
+        "distances_m": {k: round(v, 4) for k, v in dists.items()},
+        "speed_mps": round(spd, 5),
+        "omega_rad_s": round(om, 6),
+        "finite": bool(np.all(np.isfinite(pos)) and np.all(np.isfinite(rpy))),
+        "clear": bool(nearest[1] >= margin_m),
+        "settled": bool(spd < SETTLED_SPEED_MPS and om < SETTLED_OMEGA_RAD),
+    }
+
+
+def assert_free_water(plant, when: str, margin_m: float = FREE_WATER_MARGIN_M,
+                      require_settled: bool = True) -> dict:
+    r = free_water_report(plant, margin_m)
+    if not r["finite"]:
+        raise NotFreeWater(f"{when}: non-finite state {r['position']}")
+    if not r["clear"]:
+        raise NotFreeWater(
+            f"{when}: {r['nearest_distance_m']} m from '{r['nearest_obstacle']}' "
+            f"(margin {margin_m} m) -- measurement would be obstructed")
+    if require_settled and not r["settled"]:
+        raise NotFreeWater(
+            f"{when}: not settled (speed {r['speed_mps']} m/s, omega {r['omega_rad_s']} rad/s)")
+    return r
+
+
+def open_loop_case(src, vehicle, thrusts, seconds, scratch, settle_first=True,
+                   margin_m: float = FREE_WATER_MARGIN_M):
+    """Run ONE open-loop case in a FRESH plant, guarded at both ends.
+
+    A fresh instance per case removes cumulative translation, residual linear and
+    angular momentum, and creeping proximity to world geometry in one step.
+    Returns (displacement_body, rpy_change, rows, diagnostics); the caller must
+    treat a NotFreeWater exception as an INVALID case, never as a result.
+    """
+    plant = HeavyPlant(src, vehicle, settle_s=4.0, scratch=scratch)
+    try:
+        if settle_first:
+            settle(plant)
+        before = assert_free_water(plant, "before", margin_m)
+        _, p0, r0 = plant.state()
+        rows = plant.hold(thrusts, seconds)
+        _, p1, r1 = plant.state()
+        after = assert_free_water(plant, "after", margin_m, require_settled=False)
+        c, sn = math.cos(-r0[2]), math.sin(-r0[2])
+        d = p1 - p0
+        disp = np.array([c * d[0] - sn * d[1], sn * d[0] + c * d[1], d[2]])
+        drpy = np.array([(r1[k] - r0[k] + math.pi) % (2 * math.pi) - math.pi
+                         for k in range(3)])
+        return disp, drpy, rows, {"before": before, "after": after,
+                                  "hold": dict(plant.last_hold)}
+    finally:
+        plant.close()
