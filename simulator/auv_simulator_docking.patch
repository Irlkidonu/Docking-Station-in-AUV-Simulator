@@ -0,0 +1,167 @@
+"""Validate the EMITTED Heavy SDF, not the YAML arithmetic.
+
+The YAML can sum to the right displacement while the SDF emits primitives that
+intersect. Gazebo's buoyancy system integrates every collision independently, so
+an intersection is counted twice and the vehicle floats no matter how correct
+the paper total was. That is exactly what happened: a set summing to 0.011220
+m^3 emitted 0.00121 m^3 of overlap and the vehicle rose 0.41 m in 10 s.
+
+So this parses the generated SDF and works from the shapes it actually contains.
+"""
+from __future__ import annotations
+
+import math
+import re
+import xml.etree.ElementTree as ET
+
+import numpy as np
+
+from .. import world_builder as wb
+
+__all__ = ["parse_vehicle_collisions", "effective_displacement", "overlaps",
+           "run"]
+
+RHO = 1025.0
+
+
+def parse_vehicle_collisions(sdf: str, model: str = "bluerov2_heavy") -> list:
+    """Every <collision> on the vehicle's base_link, from the emitted SDF."""
+    root = ET.fromstring(sdf)
+    out = []
+    for m in root.iter("model"):
+        if m.get("name") != model:
+            continue
+        for link in m.iter("link"):
+            # Collisions now live one per rigidly fixed link, so the pose that
+            # matters is the LINK's; the collision itself is unposed.
+            link_pose = [float(v) for v in
+                         (link.findtext("pose") or "0 0 0 0 0 0").split()]
+            for col in link.iter("collision"):
+                own = col.findtext("pose")
+                pose = ([float(v) for v in own.split()] if own else link_pose)
+                geom = col.find("geometry")
+                box, cyl = geom.find("box"), geom.find("cylinder")
+                if box is not None:
+                    size = [float(v) for v in box.findtext("size").split()]
+                    out.append({"name": link.get("name"), "shape": "box",
+                                "pose": pose, "size": size,
+                                "volume": float(np.prod(size))})
+                elif cyl is not None:
+                    r = float(cyl.findtext("radius"))
+                    length = float(cyl.findtext("length"))
+                    out.append({"name": link.get("name"), "shape": "cylinder",
+                                "pose": pose, "radius": r, "length": length,
+                                "volume": float(math.pi * r * r * length)})
+    return out
+
+
+def _aabb(shape: dict):
+    p = np.array(shape["pose"][:3], dtype=float)
+    if shape["shape"] == "box":
+        half = np.array(shape["size"], dtype=float) / 2.0
+    else:
+        # Cylinders in this model are pitched pi/2, so the axis runs along x.
+        pitch = shape["pose"][4] if len(shape["pose"]) > 4 else 0.0
+        if abs(abs(pitch) - math.pi / 2) < 1e-3:
+            half = np.array([shape["length"] / 2, shape["radius"], shape["radius"]])
+        else:
+            half = np.array([shape["radius"], shape["radius"], shape["length"] / 2])
+    return p - half, p + half
+
+
+def overlaps(shapes: list) -> list:
+    """Intersecting pairs, by axis-aligned bound. Conservative: a reported
+    overlap may be a bounding-box artefact, but a missed one cannot happen."""
+    found = []
+    for i in range(len(shapes)):
+        for j in range(i + 1, len(shapes)):
+            a0, a1 = _aabb(shapes[i])
+            b0, b1 = _aabb(shapes[j])
+            d = np.minimum(a1, b1) - np.maximum(a0, b0)
+            if (d > 1e-9).all():
+                found.append((shapes[i]["name"], shapes[j]["name"],
+                              float(np.prod(d))))
+    return found
+
+
+def effective_displacement(shapes: list) -> float:
+    """Sum of emitted collision volumes -- what the buoyancy system integrates."""
+    return float(sum(s["volume"] for s in shapes))
+
+
+def collisions_per_link(sdf: str, model: str = "bluerov2_heavy") -> dict:
+    """Collision count per link. More than one aborts ODE's dxHashSpace."""
+    root = ET.fromstring(sdf)
+    out = {}
+    for m in root.iter("model"):
+        if m.get("name") != model:
+            continue
+        for link in m.iter("link"):
+            out[link.get("name")] = len(list(link.iter("collision")))
+    return out
+
+
+def emitted_mass(sdf: str, model: str = "bluerov2_heavy") -> float:
+    root = ET.fromstring(sdf)
+    total = 0.0
+    for m in root.iter("model"):
+        if m.get("name") != model:
+            continue
+        for link in m.iter("link"):
+            inertial = link.find("inertial")
+            if inertial is not None and inertial.findtext("mass"):
+                total += float(inertial.findtext("mass"))
+    return total
+
+
+def run() -> dict:
+    sdf = wb.build_world_sdf(validated=True, vehicle="bluerov2_heavy")
+    shapes = parse_vehicle_collisions(sdf)
+    volume = effective_displacement(shapes)
+    inter = overlaps(shapes)
+    mass = emitted_mass(sdf)
+    buoyant = volume * RHO
+    net_kgf = buoyant - mass
+
+    per_link = collisions_per_link(sdf)
+    multi = {k: v for k, v in per_link.items() if v > 1}
+    finite_bad = [x["name"] for x in shapes
+                  if not all(math.isfinite(v) for v in x["pose"])
+                  or (x["shape"] == "box"
+                      and not all(math.isfinite(v) and v > 0 for v in x["size"]))
+                  or (x["shape"] == "cylinder"
+                      and not (math.isfinite(x["radius"]) and x["radius"] > 0
+                               and math.isfinite(x["length"]) and x["length"] > 0))]
+
+    checks = {
+        "no link carries more than one collision": (
+            not multi,
+            f"{len(per_link)} links, worst "
+            f"{max(per_link.values()) if per_link else 0} collisions on a link"
+            + (f"; offenders {multi}" if multi else "")
+            + ". Two or more on one link aborts ODE dxHashSpace."),
+        "all dimensions and poses finite and positive": (
+            not finite_bad, f"{len(shapes)} primitives checked; "
+            f"degenerate = {finite_bad or 'none'}"),
+        "no overlapping collision primitives": (
+            not inter, f"{len(shapes)} primitives, {len(inter)} intersecting pairs"
+            + (f": {inter[:3]}" if inter else "")),
+        "emitted displacement matches the declared value": (
+            abs(volume - 0.0112195) < 5e-5,
+            f"emitted {volume:.6f} m^3 from the SDF itself"),
+        "emitted mass is the documented vehicle mass": (
+            abs(mass - 11.5) < 1e-6,
+            f"{mass:.4f} kg summed over every emitted link "
+            f"(base_link plus eight 0.01 kg thruster links)"),
+        "neutrally buoyant as emitted": (
+            abs(net_kgf) < 0.005,
+            f"buoyancy {buoyant:.4f} kgf vs mass {mass:.4f} kg "
+            f"-> net {net_kgf:+.5f} kgf ({net_kgf * 9.80665:+.5f} N)"),
+    }
+    failed = [k for k, (ok, _) in checks.items() if not ok]
+    for name, (ok, detail) in checks.items():
+        print(f"  [{'PASS' if ok else 'FAIL'}] {name}\n         {detail}")
+    print(f"\n{len(checks) - len(failed)}/{len(checks)} emitted-geometry checks passed")
+    return {"verdict": "PASS" if not failed else "FAIL",
+            "emitted_volume_m3": volume, "emitted_mass_kg": mass,
+            "net_kgf": net_kgf, "overlaps": inter, "failed": failed}
diff --git a/src/uuv_sim_physics/uuv_sim_physics/validation/heavy_profile.py b/src/uuv_sim_physics/uuv_sim_physics/validation/heavy_profile.py
