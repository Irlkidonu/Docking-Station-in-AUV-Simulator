index 00000000..0d8a51ba
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/validation/heavy_sensor_liveness.py
@@ -0,0 +1,131 @@
+"""Heavy sensor liveness gate.
+
+Every sensor the Heavy runtime consumes must actually publish, at its declared
+rate, in SIMULATION time. Absence or stall fails loudly -- a silently dead
+sensor is worse than a crash, because the control path would keep running on
+whatever it last saw.
+
+Rates are measured from message timestamps, never from wall clock: the world
+does not run at real time and a wall-clock rate would report the machine's load,
+not the sensor's behaviour.
+"""
+from __future__ import annotations
+
+import os
+import signal
+import subprocess
+import sys
+import time
+from dataclasses import dataclass, field
+from pathlib import Path
+
+from ..process_group import terminate_owned_process
+
+# Fraction of the declared rate a sensor must achieve to pass. Gazebo sensors
+# are stepped by the physics loop, so a sensor whose period is not an exact
+# multiple of the timestep lands slightly under its nominal rate; 0.9 accepts
+# that quantisation while still catching a sensor running at half rate or worse.
+RATE_TOLERANCE = 0.9
+
+# A gap larger than this many nominal periods counts as a stall.
+STALL_PERIODS = 5.0
+
+
+@dataclass
+class SensorReport:
+    name: str
+    topic: str
+    declared_hz: float
+    count: int = 0
+    measured_hz: float = 0.0
+    max_gap_s: float = 0.0
+    stalled: bool = False
+    present: bool = False
+
+    @property
+    def ok(self) -> bool:
+        return (self.present and not self.stalled
+                and self.measured_hz >= RATE_TOLERANCE * self.declared_hz)
+
+    def as_dict(self) -> dict:
+        return {"name": self.name, "topic": self.topic,
