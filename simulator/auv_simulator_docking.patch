@@ -0,0 +1,25 @@
+"""Camera utilities for the docking path.
+
+Deliberately placed inside ``docking`` rather than in ``sensors``: adding an
+export to ``sensors/__init__.py`` would touch a module existing studies
+import, and the v2.1.0 extension is required to be strictly additive. Nothing
+outside this package changes.
+"""
+from __future__ import annotations
+
+import numpy as np
+
+__all__ = ["downsample"]
+
+
+def downsample(frame: np.ndarray, height: int, width: int) -> np.ndarray:
+    """Box-average a rendered frame down to ``height`` x ``width``.
+
+    Deterministic and dependency-free: an integer box mean, so the same frame
+    always yields the same result on any machine. Trailing rows and columns that
+    do not divide evenly are trimmed rather than interpolated.
+    """
+    fy, fx = frame.shape[0] // height, frame.shape[1] // width
+    trimmed = frame[:height * fy, :width * fx].astype(np.uint16)
+    return (trimmed.reshape(height, fy, width, fx, 3)
+            .mean(axis=(1, 3)).astype(np.uint8))
diff --git a/src/uuv_sim_physics/uuv_sim_physics/docking/demo.py b/src/uuv_sim_physics/uuv_sim_physics/docking/demo.py
new file mode 100644
index 00000000..280a671d
--- /dev/null
+++ b/src/uuv_sim_physics/uuv_sim_physics/docking/demo.py
@@ -0,0 +1,99 @@
+"""Launch a docking scenario, with or without a GUI.
+
+    python3 -m uuv_sim_physics.docking.demo --provider oracle --gui
+    python3 -m uuv_sim_physics.docking.demo --provider terminal --gui
+
+``--provider`` also accepts ``module:attribute`` for an external provider, which
+is how a study plugs its own perception into the platform without the platform
+knowing anything about it::
+
+    python3 -m uuv_sim_physics.docking.demo \
+        --provider mypkg.provider:MyPerception --gui
+
+GUI and headless differ by exactly one thing: whether the simulator is started
+with its GUI attached. Same world, same controller, same sensors, same provider.
+"""
+from __future__ import annotations
+
+import argparse
+import importlib
+import json
+from pathlib import Path
+
+from .geometry import platform_geometry
+from .outcome import DockingThresholds
+from .providers import (HandoverProvider, OracleProvider,
+                        TerminalNavigationProvider)
+from .runner import DockingRunConfig, run_docking
+
+DEFAULT_HANDOVER_M = 0.60
+
+
+def _resolve(spec: str, geometry):
+    """Build a provider from a name or a ``module:attribute`` path."""
+    if spec == "oracle":
+        return OracleProvider(), True
+    if spec == "terminal":
+        # Seeded from the oracle at handover so the terminal estimator can be
+        # demonstrated on its own; a study would seed it from its own perception.
+        primary = OracleProvider()
+        terminal = TerminalNavigationProvider(geometry=geometry)
+        return HandoverProvider(primary, terminal, DEFAULT_HANDOVER_M), True
+    if ":" not in spec:
+        raise SystemExit(f"unknown provider {spec!r}; use oracle, terminal, "
+                         "or module:attribute")
+    module_name, attribute = spec.split(":", 1)
+    obj = getattr(importlib.import_module(module_name), attribute)
+    provider = obj() if isinstance(obj, type) else obj
+    return provider, False
+
+
+def main(argv=None) -> int:
+    geometry = platform_geometry()
+    spawn = list(geometry.vehicle.spawn_pose_world)
+
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--provider", default="oracle")
+    ap.add_argument("--gui", action="store_true")
+    ap.add_argument("--turbidity", type=float, default=0.0)
+    ap.add_argument("--lateral", type=float, default=0.0,
+                    help="lateral offset of the spawn pose, metres")
+    ap.add_argument("--horizon", type=float, default=60.0)
+    ap.add_argument("--seed", type=int, default=1)
+    ap.add_argument("--run-id", default="docking_demo")
+    ap.add_argument("--output", type=Path, default=None)
+    args = ap.parse_args(argv)
+
+    provider, oracle_extras = _resolve(args.provider, geometry)
+    spawn[1] = args.lateral
+
+    config = DockingRunConfig(
+        run_id=args.run_id, start_pose_world=spawn,
+        turbidity_c=args.turbidity, seed=args.seed, horizon_s=args.horizon,
+        gui=args.gui, oracle_extras=oracle_extras,
+        thresholds=DockingThresholds.from_geometry(geometry))
+
+    print(f"=== docking demo: provider={args.provider} "
+          f"gui={args.gui} turbidity={args.turbidity} ===")
+    print(f"spawn {spawn}  ->  dock {geometry.dock.origin_world.tolist()}")
+    record = run_docking(config, provider, geometry=geometry)
+
+    print(f"\n=== {record.outcome} — docked={record.docked} ===")
+    for key in ("min_range_m", "crossing_radial_m", "crossing_speed_mps",
+                "crossing_yaw_deg", "duration_s"):
+        if key in record.detail:
+            print(f"  {key:22s} {record.detail[key]:.4f}")
+    if record.diagnostics.get("handover"):
+        print(f"  handover               {record.diagnostics['handover']}")
+    if args.output:
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.write_text(json.dumps(
+            {"outcome": record.outcome, "docked": record.docked,
+             "detail": record.detail, "diagnostics": record.diagnostics},
+            indent=1, default=float) + "\n")
+        print(f"\nwrote {args.output}")
+    return 0 if record.docked else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/uuv_sim_physics/uuv_sim_physics/docking/fls_range.py b/src/uuv_sim_physics/uuv_sim_physics/docking/fls_range.py
