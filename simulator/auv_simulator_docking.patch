+++ b/src/uuv_sim_physics/uuv_sim_physics/docking/autonomy.py
@@ -0,0 +1,129 @@
+"""Observable-only mission-to-docking autonomy supervisor core."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from enum import Enum
+
+import numpy as np
+
+
+class AutonomyState(str, Enum):
+    IDLE = "IDLE"
+    MISSION = "MISSION"
+    RETURN_TO_DOCK = "RETURN_TO_DOCK"
+    DOCK_ACQUIRE = "DOCK_ACQUIRE"
+    DOCK_APPROACH = "DOCK_APPROACH"
+    DOCK_TERMINAL = "DOCK_TERMINAL"
+    DOCKED = "DOCKED"
+    SAFE_HOLD = "SAFE_HOLD"
+    ABORT = "ABORT"
+
+
+@dataclass(frozen=True)
+class SupervisorConfig:
+    dock_position_nav_m: tuple = (0.0, 0.0, 0.0)
+    acquisition_radius_m: float = 4.0
+    approach_to_terminal_m: float = 0.60
+    return_position_tolerance_m: float = 0.75
+    maximum_return_uncertainty_m: float = 3.0
+    low_soc_fraction: float = 0.20
+
+
+@dataclass(frozen=True)
+class ObservableDockingInput:
+    nav_position_m: tuple | None = None
+    nav_uncertainty_m: float = float("inf")
+    dock_relative_pose: tuple | None = None
+    dock_fix_valid: bool = False
+    physically_captured: bool = False
+    mission_complete: bool = False
+    soc_fraction: float | None = None
+    operator_request: str | None = None
+
+
+@dataclass(frozen=True)
+class AutonomyCommand:
+    state: AutonomyState
+    behavior: str
+    target: tuple | None = None
+    reason: str = ""
+
+
+class DockingAutonomySupervisor:
+    """State machine whose decisions consume estimates and detections only."""
+
+    def __init__(self, config: SupervisorConfig = SupervisorConfig()) -> None:
+        self.config = config
+        self.state = AutonomyState.IDLE
+        self._dock_requested = False
+
+    def reset(self, mission_active: bool = False) -> None:
+        self.state = AutonomyState.MISSION if mission_active else AutonomyState.IDLE
+        self._dock_requested = False
+
+    def request(self, command: str) -> None:
+        command = command.upper()
+        if command == "DOCK":
+            self._dock_requested = True
+        elif command == "ABORT":
+            self.state = AutonomyState.ABORT
+        elif command == "RETRY" and self.state in {AutonomyState.SAFE_HOLD,
+                                                    AutonomyState.ABORT}:
+            self._dock_requested = True
+            self.state = AutonomyState.RETURN_TO_DOCK
+        else:
+            raise ValueError(f"unsupported autonomy request {command!r}")
+
+    def step(self, obs: ObservableDockingInput) -> AutonomyCommand:
+        if obs.operator_request:
+            self.request(obs.operator_request)
+        low_battery = (obs.soc_fraction is not None and
+                       obs.soc_fraction <= self.config.low_soc_fraction)
+        if obs.mission_complete or low_battery:
+            self._dock_requested = True
+        if self.state == AutonomyState.ABORT:
+            return AutonomyCommand(self.state, "hold", reason="operator_abort")
+        if self.state == AutonomyState.DOCKED:
+            return AutonomyCommand(self.state, "disarm", reason="capture_confirmed")
+        if self._dock_requested and self.state in {AutonomyState.IDLE,
+                                                   AutonomyState.MISSION}:
+            self.state = AutonomyState.RETURN_TO_DOCK
+        if self.state == AutonomyState.RETURN_TO_DOCK:
+            if (obs.nav_position_m is None or
+                    obs.nav_uncertainty_m > self.config.maximum_return_uncertainty_m):
+                self.state = AutonomyState.SAFE_HOLD
+                return AutonomyCommand(self.state, "hold", reason="return_estimate_unusable")
+            nav = np.asarray(obs.nav_position_m, float)
+            dock = np.asarray(self.config.dock_position_nav_m, float)
+            distance = float(np.linalg.norm(dock - nav))
+            if distance <= self.config.acquisition_radius_m:
+                self.state = AutonomyState.DOCK_ACQUIRE
+            else:
+                return AutonomyCommand(self.state, "navigate_estimated_position",
+                                       tuple(dock), "dock_map_waypoint")
+        if self.state == AutonomyState.DOCK_ACQUIRE:
+            if not obs.dock_fix_valid or obs.dock_relative_pose is None:
+                return AutonomyCommand(self.state, "observable_search",
+                                       reason="awaiting_dock_fix")
+            self.state = AutonomyState.DOCK_APPROACH
+        if self.state == AutonomyState.DOCK_APPROACH:
+            if not obs.dock_fix_valid or obs.dock_relative_pose is None:
+                self.state = AutonomyState.DOCK_ACQUIRE
+                return AutonomyCommand(self.state, "observable_search",
+                                       reason="dock_fix_lost")
+            relative = np.asarray(obs.dock_relative_pose, float)
+            if float(relative[0]) <= self.config.approach_to_terminal_m:
+                self.state = AutonomyState.DOCK_TERMINAL
+            else:
+                return AutonomyCommand(self.state, "track_dock_relative",
+                                       tuple(relative), "valid_dock_fix")
+        if self.state == AutonomyState.DOCK_TERMINAL:
+            if obs.physically_captured:
+                self.state = AutonomyState.DOCKED
+                return AutonomyCommand(self.state, "disarm", reason="capture_confirmed")
+            return AutonomyCommand(self.state, "terminal_docking",
+                                   obs.dock_relative_pose, "terminal_handover")
+        if self.state == AutonomyState.SAFE_HOLD:
+            return AutonomyCommand(self.state, "hold", reason="no_safe_return_solution")
+        return AutonomyCommand(self.state, "mission" if self.state == AutonomyState.MISSION
+                               else "hold")
