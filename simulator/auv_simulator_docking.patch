diff --git a/src/uuv_sim_physics/config/dock_variants.yaml b/src/uuv_sim_physics/config/dock_variants.yaml
new file mode 100644
index 00000000..3529ee61
--- /dev/null
+++ b/src/uuv_sim_physics/config/dock_variants.yaml
@@ -0,0 +1,66 @@
+# ADDITIVE experimental dock variants for Scenario C arms.
+#
+# The baseline dock_station.yaml is NEVER modified. Each variant here declares a
+# transform applied to named dock links at world-build time. With no variant
+# selected the emitted world is byte-identical to the baseline, which
+# test_dock_variants.py asserts.
+#
+# Only marker POSITION is varied. Marker size, count, colour, emissive material,
+# dock structure, collision geometry, funnel, collar and throat are untouched, so
+# the optical pipeline differs in exactly one respect.
+
+variants:
+
+  arm_b_markers_forward:
+    description: >
+      Scenario C Arm B. Translates the four LED markers 0.35 m along +x (toward
+      the approaching vehicle) on rigid stand-offs. Phase 8 Pareto point: blind
+      region 0.4415 -> 0.0914 m at 9.23 mm pose error at 2 m, the only
+      non-dominated geometry achieving 100 % capture at 5 cm/s current.
+    rationale: >
+      Longitudinal marker offset enters the visibility limit linearly and does
+      not change the angle the constellation subtends at its own field-of-view
+      limit, so the near limit improves at essentially no accuracy cost.
+    predicted_blind_range_m: 0.0914
+    transform:
+      link: led_markers
+      translate_m: [0.35, 0.0, 0.0]
+    unchanged:
+      - marker radius and count
+      - marker material and emissive colour
+      - dock support, collar, funnel, guidance_lasers, beacons
+      - dock collision geometry and throat radius
+      - vehicle configuration
+
+  arm_nested_dual_scale:
+    description: >
+      Scenario C nested / dual-scale candidate. Retains the stock outer 4-LED
+      constellation (half-extent 0.20 m, r = 0.045 m) for acquisition and
+      mid-range pose conditioning, and ADDS a coplanar inner 4-LED constellation
+      (half-extent 0.05 m, r = 0.020 m) intended to remain in the field of view
+      through terminal capture.
+    rationale: >
+      The terminal blind region is geometric: a constellation leaves the vertical
+      FOV when its transverse extent exceeds L*tan(vfov/2). Shrinking the pattern
+      shortens the blind traverse. It cannot remove it: the optical path is
+      L = d - 0.23 - 0.05, so ANY same-plane constellation asymptotes to a
+      0.28 m loss range as it shrinks. The floor is set by MOUNTING OFFSETS
+      (camera 0.23 m ahead of the vehicle origin, markers 0.05 m ahead of the
+      dock origin), not by marker size. Predicted blind traverse falls from
+      0.241 m (stock) to 0.094 m, a 61 % reduction, with capture taken at
+      d = 0.2285 m (vehicle nose at the dock origin).
+    predicted_loss_range_m: 0.3228
+    predicted_blind_traverse_m: 0.0943
+    add_link:
+      name: led_markers_inner
+      radius: 0.020
+      visuals:
+        - {name: led_in_tl, pose: [0.05,  0.05,  0.05, 0, 0, 0]}
+        - {name: led_in_tr, pose: [0.05, -0.05,  0.05, 0, 0, 0]}
+        - {name: led_in_bl, pose: [0.05,  0.05, -0.05, 0, 0, 0]}
+        - {name: led_in_br, pose: [0.05, -0.05, -0.05, 0, 0, 0]}
+    unchanged:
+      - outer constellation size, position, radius and material
+      - dock support, collar, funnel, guidance_lasers, beacons
+      - dock collision geometry and throat radius
+      - vehicle configuration
